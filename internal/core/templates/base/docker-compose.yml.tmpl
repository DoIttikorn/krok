# Settings shared by the app{{if .HasWorker}} and the worker{{end}}.
x-app-env: &app-env
  PORT: "8080"
{{- if .HasDB}}
  DB_HOST: db
  DB_PORT: "{{.DBPort}}"
  DB_DATABASE: ${DB_DATABASE:-{{.DBName}}}
  DB_USERNAME: ${DB_USERNAME:-app}
  DB_PASSWORD: ${DB_PASSWORD:-secret}
{{- end}}
{{- if .Has "redis"}}
  REDIS_ADDR: redis:6379
{{- end}}
{{- if .Has "kafka"}}
  KAFKA_BROKERS: kafka:29092
{{- end}}
{{- if .Has "rabbitmq"}}
  RABBITMQ_URL: amqp://app:secret@rabbitmq:5672/
{{- end}}
{{- if .KeyVault}}
  AZURE_KEY_VAULT_NAME: ${AZURE_KEY_VAULT_NAME:-}
  # A container can't use your "az login"; pass a service principal instead.
  AZURE_TENANT_ID: ${AZURE_TENANT_ID:-}
  AZURE_CLIENT_ID: ${AZURE_CLIENT_ID:-}
  AZURE_CLIENT_SECRET: ${AZURE_CLIENT_SECRET:-}
{{- end}}
{{- if .Services}}

x-app-depends: &app-depends
{{- range .Services}}
  {{.}}:
    condition: service_healthy
{{- end}}
{{- end}}

services:
  app:
    build: .
    restart: unless-stopped
    ports:
      - "${PORT:-8080}:8080"
    environment: *app-env
{{- if .Services}}
    depends_on: *app-depends
{{- end}}
{{- if .HasWorker}}

  worker:
    build: .
    entrypoint: ["/worker"]
    restart: unless-stopped
    environment: *app-env
{{- if .Services}}
    depends_on: *app-depends
{{- end}}
{{- end}}
{{- if eq .Database "postgres"}}

  db:
    image: postgres:17-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USERNAME:-app}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-secret}
      POSTGRES_DB: ${DB_DATABASE:-{{.DBName}}}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
{{- else if eq .Database "mysql"}}

  db:
    image: mysql:8.4
    restart: unless-stopped
    environment:
      MYSQL_USER: ${DB_USERNAME:-app}
      MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
      MYSQL_DATABASE: ${DB_DATABASE:-{{.DBName}}}
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
    ports:
      - "${DB_PORT:-3306}:3306"
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      # TCP on purpose: the entrypoint's temporary init server only listens on
      # the socket, so this passes once the real server is up.
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "--silent"]
      interval: 5s
      timeout: 5s
      retries: 20
{{- else if eq .Database "mongodb"}}

  db:
    image: mongo:8
    restart: unless-stopped
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${DB_USERNAME:-app}
      MONGO_INITDB_ROOT_PASSWORD: ${DB_PASSWORD:-secret}
      MONGO_INITDB_DATABASE: ${DB_DATABASE:-{{.DBName}}}
    ports:
      - "${DB_PORT:-27017}:27017"
    volumes:
      - db_data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      timeout: 5s
      retries: 10
{{- end}}
{{- if .Has "redis"}}

  redis:
    image: redis:8-alpine
    restart: unless-stopped
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
{{- end}}
{{- if .Has "kafka"}}

  # Single-node Kafka in KRaft mode. Containers use kafka:29092, the host
  # uses localhost:9092.
  kafka:
    image: apache/kafka:4.3.1
    restart: unless-stopped
    ports:
      - "9092:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:29092,CONTROLLER://:29093,PLAINTEXT_HOST://:9092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:29093
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:29092 > /dev/null 2>&1"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 15s
{{- end}}
{{- if .Has "rabbitmq"}}

  rabbitmq:
    image: rabbitmq:4-management-alpine
    restart: unless-stopped
    environment:
      RABBITMQ_DEFAULT_USER: app
      RABBITMQ_DEFAULT_PASS: secret
    ports:
      - "5672:5672"
      - "15672:15672" # management UI: http://localhost:15672
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 10s
      retries: 10
{{- end}}
{{- if .HasDB}}

volumes:
  db_data:
{{- end}}
