// Package items is an example domain, laid out as ports and adapters:
//
//   - this package holds the model, the business rules (Service) and the
//     Repository interface the rules need. It imports no database driver
//     and no web framework;
//   - adapters live in sub-packages and depend on this one: memory
//     (in-process, also the test double), {{if .HasDB}}{{.Database}} (the real store), {{end}}and handler (the
//     REST endpoints);
//   - itemstest is the contract every Repository must pass, so any
//     adapter can replace another without changing the service.
//
// Copy this layout for your own domains, e.g. internal/order.
package items

import (
	"errors"
	"fmt"
	"strings"
	"time"
)

// Item is the domain model returned by the API.
type Item struct {
	ID        string    `json:"id"{{if .Has "openapi"}} doc:"Unique identifier"{{end}}`
	Name      string    `json:"name"{{if .Has "openapi"}} doc:"Display name"{{end}}`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// Input is what a client sends to create or replace an item.
type Input struct {
	Name string `json:"name"{{if .Has "openapi"}} minLength:"1" maxLength:"200" doc:"Display name"{{end}}`
}

// MaxNameLength is the longest name the service accepts, in bytes.
const MaxNameLength = 200

var (
	// ErrNotFound is returned when no item has the requested ID.
	ErrNotFound = errors.New("item not found")
	// ErrInvalid wraps validation errors in the input.
	ErrInvalid = errors.New("invalid item")
)

// Validate reports whether in can be stored.
func (in Input) Validate() error {
	name := strings.TrimSpace(in.Name)
	switch {
	case name == "":
		return fmt.Errorf("%w: name is required", ErrInvalid)
	case len(name) > MaxNameLength:
		return fmt.Errorf("%w: name must be at most %d bytes", ErrInvalid, MaxNameLength)
	}
	return nil
}
