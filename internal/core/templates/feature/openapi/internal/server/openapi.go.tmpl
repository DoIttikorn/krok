package server

import "github.com/danielgtaylor/huma/v2"

// apiConfig describes the API. Huma serves the OpenAPI 3.1 spec at
// /openapi.json (and .yaml) and interactive docs at /docs. Each domain's
// handler registers its operations on the API built from it.
func apiConfig() huma.Config {
	c := huma.DefaultConfig("{{.Name}}", "1.0.0")
	c.DocsRenderer = huma.DocsRendererScalar
	return c
}
