// Package rabbitmq publishes and consumes RabbitMQ messages with amqp091-go.
// amqp091-go does not reconnect on its own, so both sides here do: the
// Client reconnects on its next use, and RunWorker reconnects with backoff.
package rabbitmq

import (
	"context"
	"errors"
	"log/slog"
	"os"
	"sync"
	"time"

	amqp "github.com/rabbitmq/amqp091-go"
)

// URL returns RABBITMQ_URL, e.g. amqp://user:pass@host:5672/.
func URL() string { return getenv("RABBITMQ_URL", "amqp://app:secret@localhost:5672/") }

// Queue is the example queue: RABBITMQ_QUEUE, default "events".
func Queue() string { return getenv("RABBITMQ_QUEUE", "events") }

// dialTimeout bounds each connection attempt, so a health check can't hang.
const dialTimeout = 5 * time.Second

func dial() (*amqp.Connection, error) {
	return amqp.DialConfig(URL(), amqp.Config{Dial: amqp.DefaultDial(dialTimeout)})
}

// Client publishes messages. It connects on first use and reconnects after
// the connection drops, so /readyz recovers once RabbitMQ is back instead of
// keeping the pod out of the Service.
type Client struct {
	mu   sync.Mutex // guards conn and ch; amqp channels aren't safe for concurrent use
	conn *amqp.Connection
	ch   *amqp.Channel
}

// New validates RABBITMQ_URL. It does not connect yet.
func New() (*Client, error) {
	if _, err := amqp.ParseURI(URL()); err != nil {
		return nil, err
	}
	return &Client{}, nil
}

// channel returns an open channel, reconnecting if needed. c.mu must be held.
func (c *Client) channel() (*amqp.Channel, error) {
	if c.ch != nil && !c.ch.IsClosed() {
		return c.ch, nil
	}
	if c.conn != nil {
		c.conn.Close()
		c.conn, c.ch = nil, nil
	}
	conn, err := dial()
	if err != nil {
		return nil, err
	}
	ch, err := conn.Channel()
	if err != nil {
		conn.Close()
		return nil, err
	}
	c.conn, c.ch = conn, ch
	return ch, nil
}

// Publish sends a persistent message to queue, declaring it as durable first.
func (c *Client) Publish(ctx context.Context, queue string, body []byte) error {
	c.mu.Lock()
	defer c.mu.Unlock()
	ch, err := c.channel()
	if err != nil {
		return err
	}
	if _, err := ch.QueueDeclare(queue, true, false, false, false, nil); err != nil {
		return err
	}
	return ch.PublishWithContext(ctx, "", queue, false, false, amqp.Publishing{
		ContentType:  "application/json",
		DeliveryMode: amqp.Persistent,
		Body:         body,
	})
}

// Check reports whether RabbitMQ is reachable, reconnecting if needed;
// /readyz uses it.
func (c *Client) Check(context.Context) error {
	c.mu.Lock()
	defer c.mu.Unlock()
	_, err := c.channel()
	return err
}

func (c *Client) Close() error {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.conn == nil {
		return nil
	}
	return c.conn.Close()
}

// RunWorker consumes Queue() until ctx is done, reconnecting with backoff
// when RabbitMQ goes away, so the other consumers in cmd/worker keep running.
// Replace handleMessage with your own logic.
func RunWorker(ctx context.Context, log *slog.Logger) error {
	const maxBackoff = 30 * time.Second
	backoff := time.Second
	for {
		connected, err := consume(ctx, log)
		if ctx.Err() != nil {
			return nil
		}
		if connected {
			backoff = time.Second
		}
		log.Warn("connection lost, reconnecting", "error", err, "backoff", backoff)
		select {
		case <-ctx.Done():
			return nil
		case <-time.After(backoff):
		}
		backoff = min(backoff*2, maxBackoff)
	}
}

// consume runs one connection until it fails or ctx is done. connected
// reports whether it got as far as consuming.
func consume(ctx context.Context, log *slog.Logger) (connected bool, err error) {
	conn, err := dial()
	if err != nil {
		return false, err
	}
	defer conn.Close()
	ch, err := conn.Channel()
	if err != nil {
		return false, err
	}
	if _, err := ch.QueueDeclare(Queue(), true, false, false, false, nil); err != nil {
		return false, err
	}
	if err := ch.Qos(10, 0, false); err != nil {
		return false, err
	}
	deliveries, err := ch.Consume(Queue(), "", false, false, false, false, nil)
	if err != nil {
		return false, err
	}
	log.Info("consuming", "queue", Queue())

	for {
		select {
		case <-ctx.Done():
			return true, nil
		case d, ok := <-deliveries:
			if !ok {
				return true, errors.New("connection lost")
			}
			if err := handleMessage(ctx, log, d); err != nil {
				log.Error("handle message", "error", err)
				// Not requeued, to avoid redelivering a failing message
				// forever. Configure a dead-letter exchange to keep it.
				_ = d.Nack(false, false)
				continue
			}
			_ = d.Ack(false)
		}
	}
}

func handleMessage(ctx context.Context, log *slog.Logger, d amqp.Delivery) error {
	log.InfoContext(ctx, "message", "body", string(d.Body))
	return nil
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
