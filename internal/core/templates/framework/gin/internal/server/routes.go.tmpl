package server

import (
	"net/http"

{{- if .Has "openapi"}}
	"github.com/danielgtaylor/huma/v2/adapters/humagin"
{{- end}}
	"github.com/gin-gonic/gin"
)

// RegisterRoutes returns the router with every API route mounted. The
// probes (/livez, /readyz, /health) are served by Handler.
func (s *Server) RegisterRoutes() http.Handler {
	r := gin.New()
	r.Use(gin.Logger(), gin.Recovery())

	r.GET("/", s.helloHandler)
{{- if .Has "openapi"}}
	s.registerItems(humagin.New(r, apiConfig()))
{{- else}}
	s.itemRoutes(r.Group("/api/v1/items"))
{{- end}}

	return r
}

func (s *Server) helloHandler(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{"message": "Hello World"})
}
