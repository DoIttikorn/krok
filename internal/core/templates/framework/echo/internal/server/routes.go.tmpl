package server

import (
	"net/http"

{{- if .Has "openapi"}}
	"github.com/danielgtaylor/huma/v2/adapters/humaecho"
{{- end}}
	"github.com/labstack/echo/v5"
	"github.com/labstack/echo/v5/middleware"

	itemshandler "{{.ModulePath}}/internal/items/handler"
)

// RegisterRoutes returns the router with every API route mounted. The
// probes (/livez, /readyz, /health) are served by Handler.
func (s *Server) RegisterRoutes() http.Handler {
	e := echo.New()
	e.Use(middleware.RequestLogger(), middleware.Recover())

	e.GET("/", s.helloHandler)
{{- if .Has "openapi"}}
	api := humaecho.New(e, apiConfig())
	itemshandler.New(s.items).Register(api)
{{- else}}
	itemshandler.New(s.items).Register(e.Group(itemshandler.BasePath))
{{- end}}

	return e
}

func (s *Server) helloHandler(c *echo.Context) error {
	return c.JSON(http.StatusOK, map[string]string{"message": "Hello World"})
}
