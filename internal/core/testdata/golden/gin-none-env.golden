-- internal/config/config.go --
// Package config loads settings into the process environment before the
// rest of the app reads them with os.Getenv.
package config

import (
	"context"
	"errors"
	"io/fs"

	"github.com/joho/godotenv"
)

// Load reads .env into the environment if the file exists. Variables that
// are already set in the real environment are not overwritten.
func Load(ctx context.Context) error {
	if err := godotenv.Load(); err != nil && !errors.Is(err, fs.ErrNotExist) {
		return err
	}
	return nil
}
-- internal/httpx/httpx.go --
// Package httpx has the JSON helpers every HTTP handler shares. Errors are
// RFC 9457 problem details (application/problem+json).
package httpx

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net/http"
)

// ErrBadRequest marks errors caused by a malformed request.
var ErrBadRequest = errors.New("bad request")

// MaxBodyBytes limits the request bodies DecodeJSON reads.
const MaxBodyBytes = 1 << 20

// DecodeJSON reads a JSON request body into v and rejects unknown fields.
// Its errors wrap ErrBadRequest.
func DecodeJSON(r *http.Request, v any) error {
	dec := json.NewDecoder(io.LimitReader(r.Body, MaxBodyBytes))
	dec.DisallowUnknownFields()
	if err := dec.Decode(v); err != nil {
		return fmt.Errorf("%w: invalid JSON body: %v", ErrBadRequest, err)
	}
	return nil
}

// JSON writes v with the given status.
func JSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	if err := json.NewEncoder(w).Encode(v); err != nil {
		slog.Default().Warn("write response", "error", err)
	}
}

// Problem is an RFC 9457 error response body.
type Problem struct {
	Title  string `json:"title"`
	Status int    `json:"status"`
	Detail string `json:"detail,omitempty"`
}

// WriteProblem writes a problem response. Pass an empty detail for server
// errors, so internals don't leak to clients.
func WriteProblem(w http.ResponseWriter, status int, detail string) {
	w.Header().Set("Content-Type", "application/problem+json")
	w.WriteHeader(status)
	p := Problem{Title: http.StatusText(status), Status: status, Detail: detail}
	if err := json.NewEncoder(w).Encode(p); err != nil {
		slog.Default().Warn("write response", "error", err)
	}
}
-- internal/httpx/middleware.go --
package httpx

import (
	"log/slog"
	"net/http"
	"runtime/debug"
	"time"
)

// Log logs every request through log and turns a panic into a 500 response,
// so all frameworks log requests the same way. 5xx responses are logged at
// error level, everything else at info.
func Log(log *slog.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			start := time.Now()
			rec := &recorder{ResponseWriter: w, status: http.StatusOK}
			defer func() {
				if v := recover(); v != nil {
					if v == http.ErrAbortHandler {
						panic(v) // the server's signal to abort the response
					}
					log.ErrorContext(r.Context(), "panic", "error", v, "stack", string(debug.Stack()))
					if !rec.wroteHeader {
						WriteProblem(rec, http.StatusInternalServerError, "")
					}
				}
				level := slog.LevelInfo
				if rec.status >= http.StatusInternalServerError {
					level = slog.LevelError
				}
				log.LogAttrs(r.Context(), level, "request",
					slog.String("method", r.Method),
					slog.String("path", r.URL.Path),
					slog.Int("status", rec.status),
					slog.Int("bytes", rec.bytes),
					slog.Duration("duration", time.Since(start)),
					slog.String("remote", r.RemoteAddr),
				)
			}()
			next.ServeHTTP(rec, r)
		})
	}
}

// recorder remembers the status and size of a response.
type recorder struct {
	http.ResponseWriter
	status, bytes int
	wroteHeader   bool
}

func (r *recorder) WriteHeader(code int) {
	if !r.wroteHeader {
		r.status, r.wroteHeader = code, true
	}
	r.ResponseWriter.WriteHeader(code)
}

func (r *recorder) Write(b []byte) (int, error) {
	if !r.wroteHeader {
		r.WriteHeader(http.StatusOK)
	}
	n, err := r.ResponseWriter.Write(b)
	r.bytes += n
	return n, err
}

// Unwrap lets http.ResponseController reach the underlying writer, e.g. to
// flush.
func (r *recorder) Unwrap() http.ResponseWriter { return r.ResponseWriter }
-- internal/httpx/middleware_test.go --
package httpx

import (
	"bytes"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

func TestLogRecordsStatus(t *testing.T) {
	var buf bytes.Buffer
	h := Log(slog.New(slog.NewTextHandler(&buf, nil)))(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusTeapot)
	}))
	h.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/brew", nil))
	if out := buf.String(); !strings.Contains(out, "status=418") || !strings.Contains(out, "path=/brew") {
		t.Errorf("log = %q, want status=418 and path=/brew", out)
	}
}

func TestLogRecoversPanics(t *testing.T) {
	var buf bytes.Buffer
	h := Log(slog.New(slog.NewTextHandler(&buf, nil)))(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
		panic("boom")
	}))
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
	if rec.Code != http.StatusInternalServerError {
		t.Errorf("status = %d, want 500", rec.Code)
	}
	if out := buf.String(); !strings.Contains(out, "boom") || !strings.Contains(out, "level=ERROR") {
		t.Errorf("log = %q, want the panic at error level", out)
	}
}
-- internal/items/handler/handler.go --
// Package handler is the REST adapter for the items domain: it turns HTTP
// requests into Service calls and domain errors into RFC 9457 responses.
package handler

import (
	"context"
	"errors"
	"log/slog"
	"net/http"

	"github.com/gin-gonic/gin"

	"github.com/example/my-api/internal/httpx"
	"github.com/example/my-api/internal/items"
)

// Service is the slice of items.Service these endpoints need. It is declared
// here, where it is used, so handler tests can pass a fake.
type Service interface {
	List(ctx context.Context) ([]items.Item, error)
	Get(ctx context.Context, id string) (items.Item, error)
	Create(ctx context.Context, in items.Input) (items.Item, error)
	Update(ctx context.Context, id string, in items.Input) (items.Item, error)
	Delete(ctx context.Context, id string) error
}

// BasePath is where the server mounts these routes.
const BasePath = "/api/v1/items"

// Handler serves BasePath.
type Handler struct {
	svc Service
	log *slog.Logger
}

func New(svc Service, log *slog.Logger) *Handler { return &Handler{svc: svc, log: log} }

// itemList is the body of GET BasePath. An object rather than a bare
// array leaves room for pagination fields later.
type itemList struct {
	Items []items.Item `json:"items"`
}

// fail writes the problem response that matches err. Unexpected errors are
// logged, and their details are not sent to the client.
func (h *Handler) fail(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, httpx.ErrBadRequest):
		httpx.WriteProblem(w, http.StatusBadRequest, err.Error())
	case errors.Is(err, items.ErrNotFound):
		httpx.WriteProblem(w, http.StatusNotFound, err.Error())
	case errors.Is(err, items.ErrInvalid):
		httpx.WriteProblem(w, http.StatusUnprocessableEntity, err.Error())
	default:
		h.log.Error("items", "error", err)
		httpx.WriteProblem(w, http.StatusInternalServerError, "")
	}
}

// Register mounts the routes on g, e.g. router.Group(handler.BasePath).
func (h *Handler) Register(g *gin.RouterGroup) {
	g.GET("", h.list)
	g.POST("", h.create)
	g.GET("/:id", h.get)
	g.PUT("/:id", h.update)
	g.DELETE("/:id", h.delete)
}

func (h *Handler) list(c *gin.Context) {
	list, err := h.svc.List(c.Request.Context())
	if err != nil {
		h.fail(c.Writer, err)
		return
	}
	c.JSON(http.StatusOK, itemList{Items: list})
}

func (h *Handler) create(c *gin.Context) {
	var in items.Input
	if err := httpx.DecodeJSON(c.Request, &in); err != nil {
		h.fail(c.Writer, err)
		return
	}
	it, err := h.svc.Create(c.Request.Context(), in)
	if err != nil {
		h.fail(c.Writer, err)
		return
	}
	c.Header("Location", BasePath+"/"+it.ID)
	c.JSON(http.StatusCreated, it)
}

func (h *Handler) get(c *gin.Context) {
	it, err := h.svc.Get(c.Request.Context(), c.Param("id"))
	if err != nil {
		h.fail(c.Writer, err)
		return
	}
	c.JSON(http.StatusOK, it)
}

func (h *Handler) update(c *gin.Context) {
	var in items.Input
	if err := httpx.DecodeJSON(c.Request, &in); err != nil {
		h.fail(c.Writer, err)
		return
	}
	it, err := h.svc.Update(c.Request.Context(), c.Param("id"), in)
	if err != nil {
		h.fail(c.Writer, err)
		return
	}
	c.JSON(http.StatusOK, it)
}

func (h *Handler) delete(c *gin.Context) {
	if err := h.svc.Delete(c.Request.Context(), c.Param("id")); err != nil {
		h.fail(c.Writer, err)
		return
	}
	c.Status(http.StatusNoContent)
}
-- internal/items/items.go --
// Package items is an example domain, laid out as ports and adapters:
//
//   - this package holds the model, the business rules (Service) and the
//     Repository interface the rules need. It imports no database driver
//     and no web framework;
//   - adapters live in sub-packages and depend on this one: memory
//     (in-process, also the test double), and handler (the
//     REST endpoints);
//   - itemstest is the contract every Repository must pass, so any
//     adapter can replace another without changing the service.
//
// Copy this layout for your own domains, e.g. internal/order.
package items

import (
	"errors"
	"fmt"
	"strings"
	"time"
)

// Item is the domain model returned by the API.
type Item struct {
	ID        string    `json:"id"`
	Name      string    `json:"name"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// Input is what a client sends to create or replace an item.
type Input struct {
	Name string `json:"name"`
}

// MaxNameLength is the longest name the service accepts, in bytes.
const MaxNameLength = 200

var (
	// ErrNotFound is returned when no item has the requested ID.
	ErrNotFound = errors.New("item not found")
	// ErrInvalid wraps validation errors in the input.
	ErrInvalid = errors.New("invalid item")
)

// Validate reports whether in can be stored.
func (in Input) Validate() error {
	name := strings.TrimSpace(in.Name)
	switch {
	case name == "":
		return fmt.Errorf("%w: name is required", ErrInvalid)
	case len(name) > MaxNameLength:
		return fmt.Errorf("%w: name must be at most %d bytes", ErrInvalid, MaxNameLength)
	}
	return nil
}
-- internal/items/itemstest/itemstest.go --
// Package itemstest is the contract every items.Repository must pass.
//
// The service is tested against the memory adapter, which is only safe if
// every other adapter behaves the same way. Each adapter's tests call Run:
// memory in ordinary unit tests, the database adapters against a real
// database (INTEGRATION=1).
package itemstest

import (
	"context"
	"errors"
	"testing"
	"time"

	"github.com/example/my-api/internal/items"
)

// Run checks the Repository contract. newRepo must return an empty
// repository on every call.
func Run(t *testing.T, newRepo func(t *testing.T) items.Repository) {
	ctx := context.Background()
	// Millisecond precision, like the service, so every store keeps it exactly.
	base := time.Date(2026, 1, 2, 3, 4, 5, 6_000_000, time.UTC)
	item := func(id, name string, created time.Time) items.Item {
		return items.Item{ID: id, Name: name, CreatedAt: created, UpdatedAt: created}
	}

	t.Run("insert then get", func(t *testing.T) {
		r := newRepo(t)
		want := item("a", "first", base)
		mustInsert(t, r, want)
		got, err := r.ByID(ctx, "a")
		if err != nil {
			t.Fatal(err)
		}
		assertItem(t, got, want)
	})

	t.Run("get missing is ErrNotFound", func(t *testing.T) {
		if _, err := newRepo(t).ByID(ctx, "missing"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})

	t.Run("list is oldest first", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("c", "third", base.Add(2*time.Second)))
		mustInsert(t, r, item("a", "first", base))
		mustInsert(t, r, item("b", "second", base.Add(time.Second)))
		list, err := r.List(ctx)
		if err != nil {
			t.Fatal(err)
		}
		var ids []string
		for _, it := range list {
			ids = append(ids, it.ID)
		}
		if len(ids) != 3 || ids[0] != "a" || ids[1] != "b" || ids[2] != "c" {
			t.Errorf("List IDs = %v, want [a b c]", ids)
		}
	})

	t.Run("list empty", func(t *testing.T) {
		list, err := newRepo(t).List(ctx)
		if err != nil || len(list) != 0 {
			t.Errorf("List = %v, %v; want no items", list, err)
		}
	})

	t.Run("update changes name and UpdatedAt only", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("a", "first", base))
		changed := items.Item{ID: "a", Name: "renamed", CreatedAt: base.Add(time.Hour), UpdatedAt: base.Add(time.Minute)}
		if err := r.Update(ctx, changed); err != nil {
			t.Fatal(err)
		}
		got, err := r.ByID(ctx, "a")
		if err != nil {
			t.Fatal(err)
		}
		assertItem(t, got, items.Item{ID: "a", Name: "renamed", CreatedAt: base, UpdatedAt: base.Add(time.Minute)})
	})

	t.Run("update with unchanged values", func(t *testing.T) {
		r := newRepo(t)
		it := item("a", "first", base)
		mustInsert(t, r, it)
		if err := r.Update(ctx, it); err != nil {
			t.Errorf("err = %v, want nil: the item exists even if nothing changed", err)
		}
	})

	t.Run("update missing is ErrNotFound", func(t *testing.T) {
		if err := newRepo(t).Update(ctx, item("missing", "x", base)); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})

	t.Run("delete", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("a", "first", base))
		if err := r.Delete(ctx, "a"); err != nil {
			t.Fatal(err)
		}
		if _, err := r.ByID(ctx, "a"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("ByID after Delete: err = %v, want ErrNotFound", err)
		}
	})

	t.Run("delete missing is ErrNotFound", func(t *testing.T) {
		if err := newRepo(t).Delete(ctx, "missing"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})
}

func mustInsert(t *testing.T, r items.Repository, it items.Item) {
	t.Helper()
	if err := r.Insert(context.Background(), it); err != nil {
		t.Fatalf("Insert(%s): %v", it.ID, err)
	}
}

func assertItem(t *testing.T, got, want items.Item) {
	t.Helper()
	if got.ID != want.ID || got.Name != want.Name ||
		!got.CreatedAt.Equal(want.CreatedAt) || !got.UpdatedAt.Equal(want.UpdatedAt) {
		t.Errorf("got %+v\nwant %+v", got, want)
	}
}
-- internal/items/memory/memory.go --
// Package memory is an in-process items.Repository. It backs the service
// when there is no database, and it is the test double for the service:
// it passes the same contract as the database adapters.
//
// Each process has its own copy and everything is lost on restart, so it
// is not for production.
package memory

import (
	"cmp"
	"context"
	"fmt"
	"slices"
	"strings"
	"sync"

	"github.com/example/my-api/internal/items"
)

// Repository is safe for concurrent use.
type Repository struct {
	mu    sync.RWMutex
	items map[string]items.Item
}

var _ items.Repository = (*Repository)(nil)

func New() *Repository {
	return &Repository{items: map[string]items.Item{}}
}

func (r *Repository) List(ctx context.Context) ([]items.Item, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	out := make([]items.Item, 0, len(r.items))
	for _, it := range r.items {
		out = append(out, it)
	}
	slices.SortFunc(out, func(a, b items.Item) int {
		return cmp.Or(a.CreatedAt.Compare(b.CreatedAt), strings.Compare(a.ID, b.ID))
	})
	return out, nil
}

func (r *Repository) ByID(ctx context.Context, id string) (items.Item, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	it, ok := r.items[id]
	if !ok {
		return items.Item{}, fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	return it, nil
}

func (r *Repository) Insert(ctx context.Context, it items.Item) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.items[it.ID] = it
	return nil
}

func (r *Repository) Update(ctx context.Context, it items.Item) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	cur, ok := r.items[it.ID]
	if !ok {
		return fmt.Errorf("%w: %s", items.ErrNotFound, it.ID)
	}
	cur.Name, cur.UpdatedAt = it.Name, it.UpdatedAt
	r.items[it.ID] = cur
	return nil
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if _, ok := r.items[id]; !ok {
		return fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	delete(r.items, id)
	return nil
}
-- internal/items/memory/memory_test.go --
package memory_test

import (
	"testing"

	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/itemstest"
	"github.com/example/my-api/internal/items/memory"
)

func TestContract(t *testing.T) {
	itemstest.Run(t, func(t *testing.T) items.Repository { return memory.New() })
}
-- internal/items/repository.go --
package items

import "context"

// Repository is the persistence port: the service's only view of storage.
//
// It is declared here, next to the service that uses it, so the domain
// never depends on a database. Every implementation must pass the contract
// in itemstest; that is what makes adapters interchangeable.
type Repository interface {
	// List returns every item, oldest first (by CreatedAt, then ID).
	List(ctx context.Context) ([]Item, error)

	// ByID returns one item, or an error wrapping ErrNotFound.
	ByID(ctx context.Context, id string) (Item, error)

	// Insert stores a new item. The service has already set every field.
	Insert(ctx context.Context, it Item) error

	// Update replaces the name and UpdatedAt of an existing item, or returns
	// an error wrapping ErrNotFound.
	Update(ctx context.Context, it Item) error

	// Delete removes an item, or returns an error wrapping ErrNotFound.
	Delete(ctx context.Context, id string) error
}
-- internal/items/service.go --
package items

import (
	"context"
	"crypto/rand"
	"strings"
	"time"
)

// Service is everything the items domain can do. Handlers depend on it,
// never on a Repository directly.
type Service interface {
	List(ctx context.Context) ([]Item, error)
	Get(ctx context.Context, id string) (Item, error)
	Create(ctx context.Context, in Input) (Item, error)
	Update(ctx context.Context, id string, in Input) (Item, error)
	Delete(ctx context.Context, id string) error
}

type service struct {
	repo Repository
	now  func() time.Time
}

var _ Service = (*service)(nil)

// NewService wires the domain to a Repository adapter.
func NewService(repo Repository) Service {
	return &service{repo: repo, now: now}
}

// now is truncated to milliseconds, the finest precision every supported
// store keeps, so an item reads back exactly as it was written.
func now() time.Time { return time.Now().UTC().Truncate(time.Millisecond) }

// newID returns a random ID. It is minted here rather than by the store, so
// its format doesn't depend on which database is behind the Repository.
func newID() string { return rand.Text() }

func (s *service) List(ctx context.Context) ([]Item, error) {
	list, err := s.repo.List(ctx)
	if list == nil && err == nil {
		list = []Item{} // encode as [] rather than null
	}
	return list, err
}

func (s *service) Get(ctx context.Context, id string) (Item, error) {
	return s.repo.ByID(ctx, id)
}

func (s *service) Create(ctx context.Context, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	t := s.now()
	it := Item{ID: newID(), Name: strings.TrimSpace(in.Name), CreatedAt: t, UpdatedAt: t}
	if err := s.repo.Insert(ctx, it); err != nil {
		return Item{}, err
	}
	return it, nil
}

func (s *service) Update(ctx context.Context, id string, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	it, err := s.repo.ByID(ctx, id)
	if err != nil {
		return Item{}, err
	}
	it.Name = strings.TrimSpace(in.Name)
	it.UpdatedAt = s.now()
	if err := s.repo.Update(ctx, it); err != nil {
		return Item{}, err
	}
	return it, nil
}

func (s *service) Delete(ctx context.Context, id string) error {
	return s.repo.Delete(ctx, id)
}
-- internal/items/service_test.go --
package items_test

import (
	"context"
	"errors"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/memory"
)

// The service is tested against the memory adapter. It passes the same
// contract as the real one (see itemstest), so no database is needed here.
func newService() items.Service { return items.NewService(memory.New()) }

func TestCreateTrimsAndStamps(t *testing.T) {
	ctx := context.Background()
	svc := newService()

	it, err := svc.Create(ctx, items.Input{Name: "  first  "})
	if err != nil {
		t.Fatal(err)
	}
	if it.ID == "" || it.Name != "first" {
		t.Errorf("Create = %+v, want an ID and a trimmed name", it)
	}
	if it.CreatedAt.IsZero() || !it.CreatedAt.Equal(it.UpdatedAt) {
		t.Errorf("timestamps = %v / %v, want equal and set", it.CreatedAt, it.UpdatedAt)
	}
	got, err := svc.Get(ctx, it.ID)
	if err != nil || got != it {
		t.Errorf("Get = %+v, %v; want %+v", got, err, it)
	}
}

func TestUpdateKeepsCreatedAt(t *testing.T) {
	ctx := context.Background()
	svc := newService()
	it, err := svc.Create(ctx, items.Input{Name: "first"})
	if err != nil {
		t.Fatal(err)
	}
	updated, err := svc.Update(ctx, it.ID, items.Input{Name: "renamed"})
	if err != nil {
		t.Fatal(err)
	}
	if updated.Name != "renamed" || !updated.CreatedAt.Equal(it.CreatedAt) {
		t.Errorf("Update = %+v, want new name and the original CreatedAt", updated)
	}
}

func TestValidation(t *testing.T) {
	ctx := context.Background()
	svc := newService()
	for _, name := range []string{"", "   ", strings.Repeat("x", items.MaxNameLength+1)} {
		if _, err := svc.Create(ctx, items.Input{Name: name}); !errors.Is(err, items.ErrInvalid) {
			t.Errorf("Create(%q): err = %v, want ErrInvalid", name, err)
		}
	}
	if _, err := svc.Update(ctx, "missing", items.Input{Name: "x"}); !errors.Is(err, items.ErrNotFound) {
		t.Errorf("Update missing: err = %v, want ErrNotFound", err)
	}
}

func TestListIsNeverNil(t *testing.T) {
	list, err := newService().List(context.Background())
	if err != nil || list == nil {
		t.Errorf("List = %#v, %v; want an empty, non-nil slice", list, err)
	}
}
-- internal/logger/handler.go --
package logger

import (
	"io"
	"log/slog"
)

// newHandler uses the standard library's handlers.
func newHandler(w io.Writer, level slog.Level, json bool) slog.Handler {
	opts := &slog.HandlerOptions{Level: level}
	if json {
		return slog.NewJSONHandler(w, opts)
	}
	return slog.NewTextHandler(w, opts)
}
-- internal/logger/logger.go --
// Package logger builds the process-wide *slog.Logger. Everything else logs
// through log/slog, so the backend (slog) only appears in handler.go:
// switching to another one means replacing that file.
package logger

import (
	"fmt"
	"log/slog"
	"os"
	"strings"
)

// New builds the logger from LOG_LEVEL (debug, info, warn or error; default
// info) and LOG_FORMAT (text or json; default text), writing to stderr. It
// also becomes slog's default, so libraries that log through slog or the
// standard log package end up in the same stream.
func New() (*slog.Logger, error) {
	var level slog.Level
	if err := level.UnmarshalText([]byte(getenv("LOG_LEVEL", "info"))); err != nil {
		return nil, fmt.Errorf("LOG_LEVEL: %w", err)
	}
	format := strings.ToLower(getenv("LOG_FORMAT", "text"))
	if format != "text" && format != "json" {
		return nil, fmt.Errorf("LOG_FORMAT: %q is not text or json", format)
	}

	l := slog.New(newHandler(os.Stderr, level, format == "json"))
	slog.SetDefault(l)
	return l, nil
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/logger/logger_test.go --
package logger

import (
	"bytes"
	"encoding/json"
	"log/slog"
	"strings"
	"testing"
)

func TestHandler(t *testing.T) {
	for _, asJSON := range []bool{false, true} {
		var buf bytes.Buffer
		l := slog.New(newHandler(&buf, slog.LevelInfo, asJSON))
		l.Debug("hidden")
		l.Info("shown", "key", "value")
		l.Error("failed", "error", "boom")

		out := buf.String()
		if strings.Contains(out, "hidden") {
			t.Errorf("json=%v: debug record logged at info level:\n%s", asJSON, out)
		}
		for _, want := range []string{"shown", "value", "failed", "boom"} {
			if !strings.Contains(out, want) {
				t.Errorf("json=%v: output lacks %q:\n%s", asJSON, want, out)
			}
		}
		if asJSON {
			for _, line := range strings.Split(strings.TrimSpace(out), "\n") {
				if !json.Valid([]byte(line)) {
					t.Errorf("not a JSON line: %s", line)
				}
			}
		}
	}
}

func TestNewRejectsBadSettings(t *testing.T) {
	t.Setenv("LOG_LEVEL", "loud")
	if _, err := New(); err == nil {
		t.Error("LOG_LEVEL=loud: want an error")
	}
	t.Setenv("LOG_LEVEL", "debug")
	t.Setenv("LOG_FORMAT", "xml")
	if _, err := New(); err == nil {
		t.Error("LOG_FORMAT=xml: want an error")
	}
}
-- internal/server/health.go --
package server

import (
	"context"
	"net/http"
	"time"

	"github.com/example/my-api/internal/httpx"
)

// livez is the liveness probe. It only reports that the process can serve
// HTTP and deliberately ignores dependencies: if it failed during a database
// outage, Kubernetes would restart every pod at once and make things worse.
func (s *Server) livez(w http.ResponseWriter, r *http.Request) {
	httpx.JSON(w, http.StatusOK, map[string]string{"status": "up"})
}

// readyz is the readiness probe. It fails while the server is shutting down
// or a dependency is down, so Kubernetes stops routing traffic to this pod
// without restarting it.
func (s *Server) readyz(w http.ResponseWriter, r *http.Request) {
	if s.draining.Load() {
		httpx.JSON(w, http.StatusServiceUnavailable, map[string]string{"status": "shutting down"})
		return
	}
	code, res := s.health(r.Context())
	httpx.JSON(w, code, res)
}

// healthz reports each dependency, for people and monitoring.
func (s *Server) healthz(w http.ResponseWriter, r *http.Request) {
	code, res := s.health(r.Context())
	httpx.JSON(w, code, res)
}

// health runs every check and reports each one as "up" or "down", plus the
// HTTP code to answer with.
func (s *Server) health(ctx context.Context) (int, map[string]string) {
	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
	defer cancel()

	code, res := http.StatusOK, map[string]string{"status": "up"}
	for name, check := range s.checks {
		if err := check(ctx); err != nil {
			s.log.WarnContext(ctx, "health check failed", "check", name, "error", err)
			res[name] = "down"
			res["status"] = "down"
			code = http.StatusServiceUnavailable
			continue
		}
		res[name] = "up"
	}
	return code, res
}
-- internal/server/health_test.go --
package server

import (
	"context"
	"errors"
	"net/http"
	"testing"
)

func TestProbes(t *testing.T) {
	s := newTestServer()
	h := s.Handler()
	for _, path := range []string{"/livez", "/readyz", "/health"} {
		if rec := do(t, h, http.MethodGet, path, "", nil); rec.Code != http.StatusOK {
			t.Errorf("GET %s = %d, want %d", path, rec.Code, http.StatusOK)
		}
	}
}

func TestReadyzFailsWhenDependencyIsDown(t *testing.T) {
	s := newTestServer()
	s.checks = map[string]func(context.Context) error{
		"database": func(context.Context) error { return errors.New("connection refused") },
	}
	h := s.Handler()

	var body map[string]string
	if rec := do(t, h, http.MethodGet, "/readyz", "", &body); rec.Code != http.StatusServiceUnavailable {
		t.Errorf("GET /readyz = %d, want %d", rec.Code, http.StatusServiceUnavailable)
	}
	if body["database"] != "down" {
		t.Errorf("body = %v, want database down", body)
	}
	// Liveness ignores dependencies, so the pod is not restarted.
	if rec := do(t, h, http.MethodGet, "/livez", "", nil); rec.Code != http.StatusOK {
		t.Errorf("GET /livez = %d, want %d", rec.Code, http.StatusOK)
	}
}

func TestReadyzFailsWhileDraining(t *testing.T) {
	s := newTestServer()
	s.draining.Store(true)
	h := s.Handler()

	if rec := do(t, h, http.MethodGet, "/readyz", "", nil); rec.Code != http.StatusServiceUnavailable {
		t.Errorf("GET /readyz = %d, want %d", rec.Code, http.StatusServiceUnavailable)
	}
	if rec := do(t, h, http.MethodGet, "/livez", "", nil); rec.Code != http.StatusOK {
		t.Errorf("GET /livez = %d, want %d", rec.Code, http.StatusOK)
	}
}
-- internal/server/items_test.go --
package server

import (
	"net/http"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
)

// TestItemsAPI walks the /api/v1/items resource through its whole life cycle.
func TestItemsAPI(t *testing.T) {
	h := newTestServer().Handler()

	var created items.Item
	rec := do(t, h, http.MethodPost, "/api/v1/items", `{"name":"first"}`, &created)
	if rec.Code != http.StatusCreated {
		t.Fatalf("POST = %d, want %d: %s", rec.Code, http.StatusCreated, rec.Body)
	}
	if created.ID == "" || created.Name != "first" {
		t.Fatalf("POST body = %+v", created)
	}
	if got, want := rec.Header().Get("Location"), "/api/v1/items/"+created.ID; got != want {
		t.Errorf("Location = %q, want %q", got, want)
	}

	var list struct{ Items []items.Item }
	if rec := do(t, h, http.MethodGet, "/api/v1/items", "", &list); rec.Code != http.StatusOK || len(list.Items) != 1 {
		t.Errorf("GET list = %d with %d items, want 200 with 1", rec.Code, len(list.Items))
	}

	var updated items.Item
	if rec := do(t, h, http.MethodPut, "/api/v1/items/"+created.ID, `{"name":"renamed"}`, &updated); rec.Code != http.StatusOK || updated.Name != "renamed" {
		t.Errorf("PUT = %d %+v, want 200 renamed", rec.Code, updated)
	}

	var got items.Item
	if rec := do(t, h, http.MethodGet, "/api/v1/items/"+created.ID, "", &got); rec.Code != http.StatusOK || got.Name != "renamed" {
		t.Errorf("GET = %d %+v, want 200 renamed", rec.Code, got)
	}

	if rec := do(t, h, http.MethodDelete, "/api/v1/items/"+created.ID, "", nil); rec.Code != http.StatusNoContent {
		t.Errorf("DELETE = %d, want %d", rec.Code, http.StatusNoContent)
	}

	rec = do(t, h, http.MethodGet, "/api/v1/items/"+created.ID, "", nil)
	if rec.Code != http.StatusNotFound {
		t.Errorf("GET after DELETE = %d, want %d", rec.Code, http.StatusNotFound)
	}
	if ct := rec.Header().Get("Content-Type"); !strings.HasPrefix(ct, "application/problem+json") {
		t.Errorf("error Content-Type = %q, want application/problem+json", ct)
	}
}

func TestItemsAPIValidation(t *testing.T) {
	h := newTestServer().Handler()

	var p struct {
		Status int    `json:"status"`
		Detail string `json:"detail"`
	}
	rec := do(t, h, http.MethodPost, "/api/v1/items", `{"name":""}`, &p)
	if rec.Code != http.StatusUnprocessableEntity || p.Status != http.StatusUnprocessableEntity {
		t.Errorf("POST empty name = %d (body status %d), want %d", rec.Code, p.Status, http.StatusUnprocessableEntity)
	}

	if rec := do(t, h, http.MethodPut, "/api/v1/items/missing", `{"name":"x"}`, nil); rec.Code != http.StatusNotFound {
		t.Errorf("PUT missing = %d, want %d", rec.Code, http.StatusNotFound)
	}
	if rec := do(t, h, http.MethodPost, "/api/v1/items", `{not json`, nil); rec.Code != http.StatusBadRequest {
		t.Errorf("POST malformed JSON = %d, want %d", rec.Code, http.StatusBadRequest)
	}
}
