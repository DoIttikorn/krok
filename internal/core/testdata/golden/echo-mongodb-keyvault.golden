# step: go mod tidy
# step: git init --quiet
-- .air.toml --
# Live reload for development: run "make watch".
# Reference: https://github.com/air-verse/air/blob/master/air_example.toml
root = "."
tmp_dir = "tmp"

[build]
  cmd = "go build -o ./tmp/main ./cmd/api"
  entrypoint = ["./tmp/main"]
  include_ext = ["go"]
  exclude_dir = ["bin", "tmp", "vendor", "deploy"]
  exclude_regex = ["_test\\.go"]
  delay = 500 # ms
  stop_on_error = true
  send_interrupt = true
  kill_delay = "5s"

[misc]
  clean_on_exit = true
-- .dockerignore --
.git
.env
bin/
tmp/
deploy/
*.test
*.out
-- .env --
# Settings come from Azure Key Vault: a secret named DB-PASSWORD becomes
# DB_PASSWORD. Anything set here or in the real environment wins over the vault.
AZURE_KEY_VAULT_NAME=
-- .gitignore --
# Binaries
/bin/
/tmp/
*.exe
*.test

# Coverage
*.out

# Local environment
.env
-- Dockerfile --
# syntax=docker/dockerfile:1

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ ./cmd/...

# distroless/static has CA certificates and runs as a non-root user.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /api
EXPOSE 8080
ENTRYPOINT ["/api"]
-- Makefile --
.PHONY: run watch build test test-integration tidy clean docker-build up down logs k8s k8s-apply deps-up

IMAGE := my-api

## Development

run:
	go run ./cmd/api

# Live reload with air; uses an installed air or falls back to go run.
watch:
	@if command -v air > /dev/null 2>&1; then air; else go run github.com/air-verse/air@latest; fi

# Builds every command in cmd/ into bin/.
build:
	go build -o bin/ ./cmd/...

test:
	go test ./...

# Runs the repository contract against the real database too. Start it
# first with "make deps-up".
test-integration:
	INTEGRATION=1 go test ./...

tidy:
	go mod tidy

clean:
	rm -rf bin tmp

## Docker

docker-build:
	docker build -t $(IMAGE) .

up:
	docker compose up --build -d

down:
	docker compose down

logs:
	docker compose logs -f

## Kubernetes

# Print the manifests Kustomize renders from deploy/k8s.
k8s:
	kubectl kustomize deploy/k8s

k8s-apply:
	kubectl apply -k deploy/k8s

# Start only the services the app needs (db), for
# "make run" or "make watch" on the host.
deps-up:
	docker compose up -d --wait db
-- README.md --
# my-api

Generated by [krok](https://github.com/DoIttikorn/krok) with **echo** and **mongodb**, configured from **Azure Key Vault**.

## Run

Set `AZURE_KEY_VAULT_NAME` in `.env` and sign in to Azure first (see [Configuration](#configuration)):

```bash
az login
```

On your machine, with live reload:

```bash
make deps-up     # start db in Docker
make watch       # API with live reload, or: make run
```

Everything in Docker:

```bash
make up      # docker compose up --build -d
make logs
make down
```

Then try the API:

```bash
curl -i -X POST localhost:8080/api/v1/items -d '{"name":"first"}'
curl localhost:8080/api/v1/items
curl localhost:8080/readyz
```

## Endpoints

| Method | Path | Description |
| --- | --- | --- |
| `GET` | `/api/v1/items` | List items |
| `POST` | `/api/v1/items` | Create an item: `{"name": "..."}` → `201` with `Location` |
| `GET` | `/api/v1/items/{id}` | Get an item |
| `PUT` | `/api/v1/items/{id}` | Replace an item |
| `DELETE` | `/api/v1/items/{id}` | Delete an item → `204` |
| `GET` | `/livez` | Liveness probe: the process is up. Ignores dependencies |
| `GET` | `/readyz` | Readiness probe: every dependency is up and the server isn't shutting down |
| `GET` | `/health` | Status of each dependency, for people and monitoring |

Errors use [RFC 9457](https://www.rfc-editor.org/rfc/rfc9457) problem details
(`application/problem+json`): `400` for malformed JSON, `404` for unknown IDs,
`422` for invalid input.

## Domains: ports and adapters

`items` is an example domain. Copy its layout for your own, e.g.
`internal/order`:

```
internal/items/
├── items.go          model, errors, input validation
├── service.go        business rules (Service)
├── repository.go     Repository interface: the only view of storage
├── memory/           in-process adapter; also the test double
├── mongodb/          mongodb adapter
├── itemstest/        contract every Repository adapter must pass
└── handler/          REST adapter
```

- The domain package imports no database driver and no web framework.
  Adapters import the domain, never the other way round.
- `internal/server/server.go` is the one place that picks adapters: it
  builds the mongodb repository and hands it to `items.NewService`.
- Service tests run against the memory adapter. That is safe because every
  adapter passes the same contract in `itemstest`: `make test` runs it for
  memory, and `make deps-up && make test-integration` runs it against the real
  mongodb.

## Make targets

| Target | Description |
| --- | --- |
| `make run` | Run the API |
| `make watch` | Run with live reload ([air](https://github.com/air-verse/air), config in `.air.toml`) |
| `make build` | Build every command into `bin/` |
| `make test` | Run tests |
| `make test-integration` | Run tests, including the repository contract against the real database (`make deps-up` first) |
| `make tidy` | Tidy `go.mod` |
| `make clean` | Remove build output |
| `make docker-build` | Build the Docker image `my-api` |
| `make up` / `make down` | Start / stop everything with Docker Compose |
| `make logs` | Follow Docker Compose logs |
| `make deps-up` | Start only db in Docker |
| `make k8s` | Print the Kubernetes manifests (`kubectl kustomize deploy/k8s`) |
| `make k8s-apply` | Apply them to the current cluster |

## Configuration

Settings are read from Azure Key Vault at startup (`internal/config`):

- Set `AZURE_KEY_VAULT_NAME` to the vault name (a full vault URL also works): in `.env` locally, as an app setting in Azure.
- Authentication uses `DefaultAzureCredential`: `az login` on your machine, a managed identity in Azure. In Docker Compose, pass a service principal via `AZURE_TENANT_ID`, `AZURE_CLIENT_ID` and `AZURE_CLIENT_SECRET`.
- The identity needs the **Key Vault Secrets User** role on the vault.
- Every enabled secret becomes an environment variable, with `-` turned into `_`: `DB-PASSWORD` → `DB_PASSWORD`.
- Variables already set in the environment or `.env` win over the vault. Docker Compose sets the `DB_*` values for its own database container.

| Secret | Variable | Default |
| --- | --- | --- |
| `PORT` | `PORT` | `8080` |
| `DB-HOST` | `DB_HOST` | `localhost` |
| `DB-PORT` | `DB_PORT` | `27017` |
| `DB-DATABASE` | `DB_DATABASE` | `my_api` |
| `DB-USERNAME` | `DB_USERNAME` | `app` |
| `DB-PASSWORD` | `DB_PASSWORD` | `secret` |

## Kubernetes and high availability

`deploy/k8s` is a Kustomize base. Set the image in `kustomization.yaml`,
the host in `ingress.yaml`, the vault name in the deployments
and the managed identity client ID in `serviceaccount.yaml`, then run
`make k8s-apply`.

What keeps the API available:

- **At least two replicas** (HorizontalPodAutoscaler, 2 to 10 on CPU),
  spread across nodes and zones.
- **Probes**: liveness (`/livez`) restarts a stuck process but ignores
  dependencies, so a database outage doesn't restart every pod; readiness
  (`/readyz`) takes a pod out of the Service while a dependency is down.
- **Zero-downtime rollouts**: `maxUnavailable: 0`, and on SIGTERM the server
  fails `/readyz`, waits `SHUTDOWN_DELAY` (5s in the manifest, 0 locally) for
  ingress-nginx to stop routing to it, then drains in-flight requests.
- **PodDisruptionBudget**: node drains evict one pod at a time.
-- cmd/api/main.go --
package main

import (
	"context"
	"errors"
	"log"
	"net/http"
	"os/signal"
	"syscall"
	"time"

	"github.com/example/my-api/internal/config"
	"github.com/example/my-api/internal/server"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	if err := config.Load(ctx); err != nil {
		log.Fatalf("load config: %v", err)
	}

	srv, err := server.New(ctx)
	if err != nil {
		log.Fatalf("create server: %v", err)
	}
	defer srv.Close()

	errCh := make(chan error, 1)
	go func() {
		log.Printf("listening on %s", srv.Addr())
		errCh <- srv.ListenAndServe()
	}()

	select {
	case err := <-errCh:
		if !errors.Is(err, http.ErrServerClosed) {
			log.Printf("server error: %v", err)
		}
		return
	case <-ctx.Done():
	}

	// Keep this below the pod's terminationGracePeriodSeconds (30s).
	log.Println("shutting down")
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
	defer cancel()
	if err := srv.Shutdown(shutdownCtx); err != nil {
		log.Printf("shutdown: %v", err)
	}
}
-- deploy/k8s/deployment.yaml --
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  # No replicas field: the HorizontalPodAutoscaler owns it (minimum 2).
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0 # keep full capacity during a rollout
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: api
  template:
    metadata:
      labels:
        app.kubernetes.io/name: my-api
        app.kubernetes.io/component: api
        azure.workload.identity/use: "true"
    spec:
      serviceAccountName: my-api
      terminationGracePeriodSeconds: 30
      # Spread replicas across nodes and zones so one failure can't take
      # them all down.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: api
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: api
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532 # the distroless "nonroot" user
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: api
          image: my-api
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: PORT
              value: "8080"
            # On SIGTERM, fail /readyz and wait this long before closing the
            # listener, so ingress-nginx stops sending requests first.
            - name: SHUTDOWN_DELAY
              value: 5s
            - name: AZURE_KEY_VAULT_NAME
              value: your-key-vault # TODO
          # Settings from a Secret, if present:
          #   kubectl create secret generic my-api-env --from-env-file=.env
          envFrom:
            - secretRef:
                name: my-api-env
                optional: true
          # Gives a slow start up to 60s before liveness checks begin.
          startupProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 2
            failureThreshold: 30
          # Restarts the container only if the process stops answering.
          livenessProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          # Takes the pod out of the Service while a dependency is down or
          # while it shuts down.
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 2
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
-- deploy/k8s/hpa.yaml --
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: my-api
  minReplicas: 2 # at least two, so one can restart without downtime
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
-- deploy/k8s/ingress.yaml --
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  ingressClassName: nginx
  rules:
    - host: my-api.example.com # TODO: your host
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: my-api
                port:
                  name: http
-- deploy/k8s/kustomization.yaml --
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# namespace: my-api

labels:
  - pairs:
      app.kubernetes.io/part-of: my-api

resources:
  - deployment.yaml
  - service.yaml
  - ingress.yaml
  - pdb.yaml
  - hpa.yaml
  - serviceaccount.yaml

# Point this at your registry, or run:
#   kustomize edit set image my-api=registry.example.com/my-api:v1.0.0
images:
  - name: my-api
    newName: registry.example.com/my-api
    newTag: latest
-- deploy/k8s/pdb.yaml --
# Node drains and cluster upgrades evict at most one API pod at a time.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: api
-- deploy/k8s/service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  selector:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
  ports:
    - name: http
      port: 80
      targetPort: http
-- deploy/k8s/serviceaccount.yaml --
# Azure Workload Identity: pods using this account get a token for the
# managed identity below, which DefaultAzureCredential uses to read Key Vault.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
  annotations:
    # Client ID of a managed identity with "Key Vault Secrets User" on the vault.
    azure.workload.identity/client-id: 00000000-0000-0000-0000-000000000000 # TODO
-- docker-compose.yml --
# Settings shared by the app.
x-app-env: &app-env
  PORT: "8080"
  DB_HOST: db
  DB_PORT: "27017"
  DB_DATABASE: ${DB_DATABASE:-my_api}
  DB_USERNAME: ${DB_USERNAME:-app}
  DB_PASSWORD: ${DB_PASSWORD:-secret}
  AZURE_KEY_VAULT_NAME: ${AZURE_KEY_VAULT_NAME:-}
  # A container can't use your "az login"; pass a service principal instead.
  AZURE_TENANT_ID: ${AZURE_TENANT_ID:-}
  AZURE_CLIENT_ID: ${AZURE_CLIENT_ID:-}
  AZURE_CLIENT_SECRET: ${AZURE_CLIENT_SECRET:-}

x-app-depends: &app-depends
  db:
    condition: service_healthy

services:
  app:
    build: .
    restart: unless-stopped
    ports:
      - "${PORT:-8080}:8080"
    environment: *app-env
    depends_on: *app-depends

  db:
    image: mongo:8
    restart: unless-stopped
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${DB_USERNAME:-app}
      MONGO_INITDB_ROOT_PASSWORD: ${DB_PASSWORD:-secret}
      MONGO_INITDB_DATABASE: ${DB_DATABASE:-my_api}
    ports:
      - "${DB_PORT:-27017}:27017"
    volumes:
      - db_data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  db_data:
-- go.mod --
module github.com/example/my-api

go 1.24
-- internal/config/config.go --
// Package config loads settings into the process environment before the
// rest of the app reads them with os.Getenv.
package config

import (
	"context"
	"errors"
	"fmt"
	"io/fs"
	"os"
	"strings"
	"time"

	"github.com/Azure/azure-sdk-for-go/sdk/azidentity"
	"github.com/Azure/azure-sdk-for-go/sdk/security/keyvault/azsecrets"
	"github.com/joho/godotenv"
)

// Load copies every enabled secret from the Azure Key Vault named by
// AZURE_KEY_VAULT_NAME into the environment. A secret named DB-PASSWORD
// becomes DB_PASSWORD. Variables already set, in the real environment or in
// an optional .env file, take precedence over the vault so you can override
// a single value locally.
//
// Authentication uses DefaultAzureCredential: "az login" on a developer
// machine, managed identity or workload identity in Azure. The identity needs
// the "Key Vault Secrets User" role on the vault.
func Load(ctx context.Context) error {
	if err := godotenv.Load(); err != nil && !errors.Is(err, fs.ErrNotExist) {
		return err
	}
	name := os.Getenv("AZURE_KEY_VAULT_NAME")
	if name == "" {
		return errors.New("AZURE_KEY_VAULT_NAME is not set")
	}

	cred, err := azidentity.NewDefaultAzureCredential(nil)
	if err != nil {
		return fmt.Errorf("azure credential: %w", err)
	}
	client, err := azsecrets.NewClient(VaultURL(name), cred, nil)
	if err != nil {
		return fmt.Errorf("key vault client: %w", err)
	}

	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
	defer cancel()

	pager := client.NewListSecretPropertiesPager(nil)
	for pager.More() {
		page, err := pager.NextPage(ctx)
		if err != nil {
			return fmt.Errorf("list secrets in %s: %w", name, err)
		}
		for _, p := range page.Value {
			if skip(p) {
				continue
			}
			key := EnvKey(p.ID.Name())
			if _, set := os.LookupEnv(key); set {
				continue
			}
			resp, err := client.GetSecret(ctx, p.ID.Name(), "", nil)
			if err != nil {
				return fmt.Errorf("get secret %s: %w", p.ID.Name(), err)
			}
			if resp.Value == nil {
				continue
			}
			if err := os.Setenv(key, *resp.Value); err != nil {
				return err
			}
		}
	}
	return nil
}

// skip reports whether a secret should not be loaded: disabled secrets and
// the ones Key Vault manages to back certificates.
func skip(p *azsecrets.SecretProperties) bool {
	if p.ID == nil {
		return true
	}
	if p.Managed != nil && *p.Managed {
		return true
	}
	return p.Attributes != nil && p.Attributes.Enabled != nil && !*p.Attributes.Enabled
}

// VaultURL turns a vault name into its URL. A full URL is returned as is,
// for sovereign clouds such as https://my-vault.vault.azure.cn/.
func VaultURL(name string) string {
	if strings.Contains(name, "://") {
		return name
	}
	return "https://" + name + ".vault.azure.net/"
}

// EnvKey maps a Key Vault secret name to an environment variable name.
// Secret names allow only letters, digits and dashes.
func EnvKey(secret string) string {
	return strings.ToUpper(strings.ReplaceAll(secret, "-", "_"))
}
-- internal/config/config_test.go --
package config

import (
	"context"
	"strings"
	"testing"
)

func TestEnvKey(t *testing.T) {
	tests := map[string]string{
		"DB-PASSWORD": "DB_PASSWORD",
		"db-host":     "DB_HOST",
		"PORT":        "PORT",
	}
	for in, want := range tests {
		if got := EnvKey(in); got != want {
			t.Errorf("EnvKey(%q) = %q, want %q", in, got, want)
		}
	}
}

func TestVaultURL(t *testing.T) {
	if got, want := VaultURL("my-vault"), "https://my-vault.vault.azure.net/"; got != want {
		t.Errorf("VaultURL(name) = %q, want %q", got, want)
	}
	url := "https://my-vault.vault.azure.cn/"
	if got := VaultURL(url); got != url {
		t.Errorf("VaultURL(url) = %q, want %q", got, url)
	}
}

func TestLoadRequiresVaultName(t *testing.T) {
	t.Setenv("AZURE_KEY_VAULT_NAME", "")
	err := Load(context.Background())
	if err == nil || !strings.Contains(err.Error(), "AZURE_KEY_VAULT_NAME") {
		t.Fatalf("err = %v, want AZURE_KEY_VAULT_NAME is not set", err)
	}
}
-- internal/database/database.go --
package database

import (
	"context"
	"net"
	"net/url"
	"os"
	"time"

	"go.mongodb.org/mongo-driver/v2/mongo"
	"go.mongodb.org/mongo-driver/v2/mongo/options"
)

// Service is the database dependency the server uses.
type Service interface {
	// Check pings the database; the server's /health uses it.
	Check(ctx context.Context) error
	// Database returns the application database handle.
	Database() *mongo.Database
	Close() error
}

type service struct {
	client *mongo.Client
	db     *mongo.Database
}

// New creates a MongoDB client configured from environment variables. It
// does not wait for the database to be reachable.
func New() (Service, error) {
	uri := url.URL{
		Scheme:   "mongodb",
		User:     url.UserPassword(getenv("DB_USERNAME", "app"), getenv("DB_PASSWORD", "secret")),
		Host:     net.JoinHostPort(getenv("DB_HOST", "localhost"), getenv("DB_PORT", "27017")),
		Path:     "/",
		RawQuery: "authSource=admin",
	}
	client, err := mongo.Connect(options.Client().ApplyURI(uri.String()))
	if err != nil {
		return nil, err
	}
	return &service{
		client: client,
		db:     client.Database(getenv("DB_DATABASE", "my_api")),
	}, nil
}

func (s *service) Check(ctx context.Context) error { return s.client.Ping(ctx, nil) }

func (s *service) Database() *mongo.Database { return s.db }

func (s *service) Close() error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	return s.client.Disconnect(ctx)
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/httpx/httpx.go --
// Package httpx has the JSON helpers every HTTP handler shares. Errors are
// RFC 9457 problem details (application/problem+json).
package httpx

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"log"
	"net/http"
)

// ErrBadRequest marks errors caused by a malformed request.
var ErrBadRequest = errors.New("bad request")

// MaxBodyBytes limits the request bodies DecodeJSON reads.
const MaxBodyBytes = 1 << 20

// DecodeJSON reads a JSON request body into v and rejects unknown fields.
// Its errors wrap ErrBadRequest.
func DecodeJSON(r *http.Request, v any) error {
	dec := json.NewDecoder(io.LimitReader(r.Body, MaxBodyBytes))
	dec.DisallowUnknownFields()
	if err := dec.Decode(v); err != nil {
		return fmt.Errorf("%w: invalid JSON body: %v", ErrBadRequest, err)
	}
	return nil
}

// JSON writes v with the given status.
func JSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	if err := json.NewEncoder(w).Encode(v); err != nil {
		log.Printf("write response: %v", err)
	}
}

// Problem is an RFC 9457 error response body.
type Problem struct {
	Title  string `json:"title"`
	Status int    `json:"status"`
	Detail string `json:"detail,omitempty"`
}

// WriteProblem writes a problem response. Pass an empty detail for server
// errors, so internals don't leak to clients.
func WriteProblem(w http.ResponseWriter, status int, detail string) {
	w.Header().Set("Content-Type", "application/problem+json")
	w.WriteHeader(status)
	p := Problem{Title: http.StatusText(status), Status: status, Detail: detail}
	if err := json.NewEncoder(w).Encode(p); err != nil {
		log.Printf("write response: %v", err)
	}
}
-- internal/items/handler/handler.go --
// Package handler is the REST adapter for the items domain: it turns HTTP
// requests into Service calls and domain errors into RFC 9457 responses.
package handler

import (
	"context"
	"errors"
	"log"
	"net/http"

	"github.com/labstack/echo/v5"

	"github.com/example/my-api/internal/httpx"
	"github.com/example/my-api/internal/items"
)

// Service is the slice of items.Service these endpoints need. It is declared
// here, where it is used, so handler tests can pass a fake.
type Service interface {
	List(ctx context.Context) ([]items.Item, error)
	Get(ctx context.Context, id string) (items.Item, error)
	Create(ctx context.Context, in items.Input) (items.Item, error)
	Update(ctx context.Context, id string, in items.Input) (items.Item, error)
	Delete(ctx context.Context, id string) error
}

// BasePath is where the server mounts these routes.
const BasePath = "/api/v1/items"

// Handler serves BasePath.
type Handler struct {
	svc Service
}

func New(svc Service) *Handler { return &Handler{svc: svc} }

// itemList is the body of GET BasePath. An object rather than a bare
// array leaves room for pagination fields later.
type itemList struct {
	Items []items.Item `json:"items"`
}

// fail writes the problem response that matches err. Unexpected errors are
// logged, and their details are not sent to the client.
func fail(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, httpx.ErrBadRequest):
		httpx.WriteProblem(w, http.StatusBadRequest, err.Error())
	case errors.Is(err, items.ErrNotFound):
		httpx.WriteProblem(w, http.StatusNotFound, err.Error())
	case errors.Is(err, items.ErrInvalid):
		httpx.WriteProblem(w, http.StatusUnprocessableEntity, err.Error())
	default:
		log.Printf("items: %v", err)
		httpx.WriteProblem(w, http.StatusInternalServerError, "")
	}
}

// Register mounts the routes on g, e.g. e.Group(handler.BasePath).
func (h *Handler) Register(g *echo.Group) {
	g.GET("", h.list)
	g.POST("", h.create)
	g.GET("/:id", h.get)
	g.PUT("/:id", h.update)
	g.DELETE("/:id", h.delete)
}

// Errors are written with fail, so the handlers return nil after it.

func (h *Handler) list(c *echo.Context) error {
	list, err := h.svc.List(c.Request().Context())
	if err != nil {
		fail(c.Response(), err)
		return nil
	}
	return c.JSON(http.StatusOK, itemList{Items: list})
}

func (h *Handler) create(c *echo.Context) error {
	var in items.Input
	if err := httpx.DecodeJSON(c.Request(), &in); err != nil {
		fail(c.Response(), err)
		return nil
	}
	it, err := h.svc.Create(c.Request().Context(), in)
	if err != nil {
		fail(c.Response(), err)
		return nil
	}
	c.Response().Header().Set("Location", BasePath+"/"+it.ID)
	return c.JSON(http.StatusCreated, it)
}

func (h *Handler) get(c *echo.Context) error {
	it, err := h.svc.Get(c.Request().Context(), c.Param("id"))
	if err != nil {
		fail(c.Response(), err)
		return nil
	}
	return c.JSON(http.StatusOK, it)
}

func (h *Handler) update(c *echo.Context) error {
	var in items.Input
	if err := httpx.DecodeJSON(c.Request(), &in); err != nil {
		fail(c.Response(), err)
		return nil
	}
	it, err := h.svc.Update(c.Request().Context(), c.Param("id"), in)
	if err != nil {
		fail(c.Response(), err)
		return nil
	}
	return c.JSON(http.StatusOK, it)
}

func (h *Handler) delete(c *echo.Context) error {
	if err := h.svc.Delete(c.Request().Context(), c.Param("id")); err != nil {
		fail(c.Response(), err)
		return nil
	}
	return c.NoContent(http.StatusNoContent)
}
-- internal/items/items.go --
// Package items is an example domain, laid out as ports and adapters:
//
//   - this package holds the model, the business rules (Service) and the
//     Repository interface the rules need. It imports no database driver
//     and no web framework;
//   - adapters live in sub-packages and depend on this one: memory
//     (in-process, also the test double), mongodb (the real store), and handler (the
//     REST endpoints);
//   - itemstest is the contract every Repository must pass, so any
//     adapter can replace another without changing the service.
//
// Copy this layout for your own domains, e.g. internal/order.
package items

import (
	"errors"
	"fmt"
	"strings"
	"time"
)

// Item is the domain model returned by the API.
type Item struct {
	ID        string    `json:"id"`
	Name      string    `json:"name"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// Input is what a client sends to create or replace an item.
type Input struct {
	Name string `json:"name"`
}

// MaxNameLength is the longest name the service accepts, in bytes.
const MaxNameLength = 200

var (
	// ErrNotFound is returned when no item has the requested ID.
	ErrNotFound = errors.New("item not found")
	// ErrInvalid wraps validation errors in the input.
	ErrInvalid = errors.New("invalid item")
)

// Validate reports whether in can be stored.
func (in Input) Validate() error {
	name := strings.TrimSpace(in.Name)
	switch {
	case name == "":
		return fmt.Errorf("%w: name is required", ErrInvalid)
	case len(name) > MaxNameLength:
		return fmt.Errorf("%w: name must be at most %d bytes", ErrInvalid, MaxNameLength)
	}
	return nil
}
-- internal/items/itemstest/itemstest.go --
// Package itemstest is the contract every items.Repository must pass.
//
// The service is tested against the memory adapter, which is only safe if
// every other adapter behaves the same way. Each adapter's tests call Run:
// memory in ordinary unit tests, the database adapters against a real
// database (INTEGRATION=1).
package itemstest

import (
	"context"
	"errors"
	"testing"
	"time"

	"github.com/example/my-api/internal/items"
)

// Run checks the Repository contract. newRepo must return an empty
// repository on every call.
func Run(t *testing.T, newRepo func(t *testing.T) items.Repository) {
	ctx := context.Background()
	// Millisecond precision, like the service, so every store keeps it exactly.
	base := time.Date(2026, 1, 2, 3, 4, 5, 6_000_000, time.UTC)
	item := func(id, name string, created time.Time) items.Item {
		return items.Item{ID: id, Name: name, CreatedAt: created, UpdatedAt: created}
	}

	t.Run("insert then get", func(t *testing.T) {
		r := newRepo(t)
		want := item("a", "first", base)
		mustInsert(t, r, want)
		got, err := r.ByID(ctx, "a")
		if err != nil {
			t.Fatal(err)
		}
		assertItem(t, got, want)
	})

	t.Run("get missing is ErrNotFound", func(t *testing.T) {
		if _, err := newRepo(t).ByID(ctx, "missing"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})

	t.Run("list is oldest first", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("c", "third", base.Add(2*time.Second)))
		mustInsert(t, r, item("a", "first", base))
		mustInsert(t, r, item("b", "second", base.Add(time.Second)))
		list, err := r.List(ctx)
		if err != nil {
			t.Fatal(err)
		}
		var ids []string
		for _, it := range list {
			ids = append(ids, it.ID)
		}
		if len(ids) != 3 || ids[0] != "a" || ids[1] != "b" || ids[2] != "c" {
			t.Errorf("List IDs = %v, want [a b c]", ids)
		}
	})

	t.Run("list empty", func(t *testing.T) {
		list, err := newRepo(t).List(ctx)
		if err != nil || len(list) != 0 {
			t.Errorf("List = %v, %v; want no items", list, err)
		}
	})

	t.Run("update changes name and UpdatedAt only", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("a", "first", base))
		changed := items.Item{ID: "a", Name: "renamed", CreatedAt: base.Add(time.Hour), UpdatedAt: base.Add(time.Minute)}
		if err := r.Update(ctx, changed); err != nil {
			t.Fatal(err)
		}
		got, err := r.ByID(ctx, "a")
		if err != nil {
			t.Fatal(err)
		}
		assertItem(t, got, items.Item{ID: "a", Name: "renamed", CreatedAt: base, UpdatedAt: base.Add(time.Minute)})
	})

	t.Run("update with unchanged values", func(t *testing.T) {
		r := newRepo(t)
		it := item("a", "first", base)
		mustInsert(t, r, it)
		if err := r.Update(ctx, it); err != nil {
			t.Errorf("err = %v, want nil: the item exists even if nothing changed", err)
		}
	})

	t.Run("update missing is ErrNotFound", func(t *testing.T) {
		if err := newRepo(t).Update(ctx, item("missing", "x", base)); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})

	t.Run("delete", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("a", "first", base))
		if err := r.Delete(ctx, "a"); err != nil {
			t.Fatal(err)
		}
		if _, err := r.ByID(ctx, "a"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("ByID after Delete: err = %v, want ErrNotFound", err)
		}
	})

	t.Run("delete missing is ErrNotFound", func(t *testing.T) {
		if err := newRepo(t).Delete(ctx, "missing"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})
}

func mustInsert(t *testing.T, r items.Repository, it items.Item) {
	t.Helper()
	if err := r.Insert(context.Background(), it); err != nil {
		t.Fatalf("Insert(%s): %v", it.ID, err)
	}
}

func assertItem(t *testing.T, got, want items.Item) {
	t.Helper()
	if got.ID != want.ID || got.Name != want.Name ||
		!got.CreatedAt.Equal(want.CreatedAt) || !got.UpdatedAt.Equal(want.UpdatedAt) {
		t.Errorf("got %+v\nwant %+v", got, want)
	}
}
-- internal/items/memory/memory.go --
// Package memory is an in-process items.Repository. It backs the service
// when there is no database, and it is the test double for the service:
// it passes the same contract as the database adapters.
//
// Each process has its own copy and everything is lost on restart, so it
// is not for production.
package memory

import (
	"cmp"
	"context"
	"fmt"
	"slices"
	"strings"
	"sync"

	"github.com/example/my-api/internal/items"
)

// Repository is safe for concurrent use.
type Repository struct {
	mu    sync.RWMutex
	items map[string]items.Item
}

var _ items.Repository = (*Repository)(nil)

func New() *Repository {
	return &Repository{items: map[string]items.Item{}}
}

func (r *Repository) List(ctx context.Context) ([]items.Item, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	out := make([]items.Item, 0, len(r.items))
	for _, it := range r.items {
		out = append(out, it)
	}
	slices.SortFunc(out, func(a, b items.Item) int {
		return cmp.Or(a.CreatedAt.Compare(b.CreatedAt), strings.Compare(a.ID, b.ID))
	})
	return out, nil
}

func (r *Repository) ByID(ctx context.Context, id string) (items.Item, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	it, ok := r.items[id]
	if !ok {
		return items.Item{}, fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	return it, nil
}

func (r *Repository) Insert(ctx context.Context, it items.Item) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.items[it.ID] = it
	return nil
}

func (r *Repository) Update(ctx context.Context, it items.Item) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	cur, ok := r.items[it.ID]
	if !ok {
		return fmt.Errorf("%w: %s", items.ErrNotFound, it.ID)
	}
	cur.Name, cur.UpdatedAt = it.Name, it.UpdatedAt
	r.items[it.ID] = cur
	return nil
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if _, ok := r.items[id]; !ok {
		return fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	delete(r.items, id)
	return nil
}
-- internal/items/memory/memory_test.go --
package memory_test

import (
	"testing"

	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/itemstest"
	"github.com/example/my-api/internal/items/memory"
)

func TestContract(t *testing.T) {
	itemstest.Run(t, func(t *testing.T) items.Repository { return memory.New() })
}
-- internal/items/mongodb/repository.go --
// Package mongodb is the MongoDB adapter for the items domain.
package mongodb

import (
	"context"
	"errors"
	"fmt"
	"time"

	"go.mongodb.org/mongo-driver/v2/bson"
	"go.mongodb.org/mongo-driver/v2/mongo"
	"go.mongodb.org/mongo-driver/v2/mongo/options"

	"github.com/example/my-api/internal/items"
)

// CollectionName is exported so tests can clean up after themselves.
const CollectionName = "items"

// document is the stored shape. It stays in this package, so bson tags never
// leak into the domain model.
type document struct {
	ID        string    `bson:"_id"`
	Name      string    `bson:"name"`
	CreatedAt time.Time `bson:"created_at"`
	UpdatedAt time.Time `bson:"updated_at"`
}

func fromDomain(it items.Item) document {
	return document{ID: it.ID, Name: it.Name, CreatedAt: it.CreatedAt, UpdatedAt: it.UpdatedAt}
}

func (d document) toDomain() items.Item {
	return items.Item{ID: d.ID, Name: d.Name, CreatedAt: d.CreatedAt.UTC(), UpdatedAt: d.UpdatedAt.UTC()}
}

// Repository stores items in the "items" collection. IDs are the service's
// own strings, not ObjectIDs, so the domain doesn't depend on MongoDB.
type Repository struct {
	coll *mongo.Collection
}

var _ items.Repository = (*Repository)(nil)

// New uses the shared client's database; it doesn't connect on its own.
func New(db *mongo.Database) *Repository {
	return &Repository{coll: db.Collection(CollectionName)}
}

// Migrate creates the index List sorts on. It is idempotent, so every
// replica can call it on startup.
func (r *Repository) Migrate(ctx context.Context) error {
	_, err := r.coll.Indexes().CreateOne(ctx, mongo.IndexModel{
		Keys: bson.D{{Key: "created_at", Value: 1}, {Key: "_id", Value: 1}},
	})
	return err
}

func (r *Repository) List(ctx context.Context) ([]items.Item, error) {
	opts := options.Find().SetSort(bson.D{{Key: "created_at", Value: 1}, {Key: "_id", Value: 1}})
	cur, err := r.coll.Find(ctx, bson.D{}, opts)
	if err != nil {
		return nil, err
	}
	var docs []document
	if err := cur.All(ctx, &docs); err != nil {
		return nil, err
	}
	out := make([]items.Item, len(docs))
	for i, d := range docs {
		out[i] = d.toDomain()
	}
	return out, nil
}

func (r *Repository) ByID(ctx context.Context, id string) (items.Item, error) {
	var d document
	err := r.coll.FindOne(ctx, bson.D{{Key: "_id", Value: id}}).Decode(&d)
	if errors.Is(err, mongo.ErrNoDocuments) {
		return items.Item{}, fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	if err != nil {
		return items.Item{}, err
	}
	return d.toDomain(), nil
}

func (r *Repository) Insert(ctx context.Context, it items.Item) error {
	_, err := r.coll.InsertOne(ctx, fromDomain(it))
	return err
}

func (r *Repository) Update(ctx context.Context, it items.Item) error {
	res, err := r.coll.UpdateOne(ctx,
		bson.D{{Key: "_id", Value: it.ID}},
		bson.D{{Key: "$set", Value: bson.D{{Key: "name", Value: it.Name}, {Key: "updated_at", Value: it.UpdatedAt}}}},
	)
	if err != nil {
		return err
	}
	if res.MatchedCount == 0 {
		return fmt.Errorf("%w: %s", items.ErrNotFound, it.ID)
	}
	return nil
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	res, err := r.coll.DeleteOne(ctx, bson.D{{Key: "_id", Value: id}})
	if err != nil {
		return err
	}
	if res.DeletedCount == 0 {
		return fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	return nil
}
-- internal/items/mongodb/repository_test.go --
package mongodb

import (
	"context"
	"os"
	"testing"

	"go.mongodb.org/mongo-driver/v2/bson"

	"github.com/example/my-api/internal/database"
	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/itemstest"
)

// TestContract runs the Repository contract against a real MongoDB:
//
//	make deps-up && make test-integration
func TestContract(t *testing.T) {
	if os.Getenv("INTEGRATION") == "" {
		t.Skip("set INTEGRATION=1 with the database running (make deps-up)")
	}
	ctx := context.Background()
	db, err := database.New()
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { db.Close() })
	repo := New(db.Database())
	if err := repo.Migrate(ctx); err != nil {
		t.Fatal(err)
	}
	itemstest.Run(t, func(t *testing.T) items.Repository {
		if _, err := db.Database().Collection(CollectionName).DeleteMany(ctx, bson.D{}); err != nil {
			t.Fatal(err)
		}
		return repo
	})
}
-- internal/items/repository.go --
package items

import "context"

// Repository is the persistence port: the service's only view of storage.
//
// It is declared here, next to the service that uses it, so the domain
// never depends on a database. Every implementation must pass the contract
// in itemstest; that is what makes adapters interchangeable.
type Repository interface {
	// List returns every item, oldest first (by CreatedAt, then ID).
	List(ctx context.Context) ([]Item, error)

	// ByID returns one item, or an error wrapping ErrNotFound.
	ByID(ctx context.Context, id string) (Item, error)

	// Insert stores a new item. The service has already set every field.
	Insert(ctx context.Context, it Item) error

	// Update replaces the name and UpdatedAt of an existing item, or returns
	// an error wrapping ErrNotFound.
	Update(ctx context.Context, it Item) error

	// Delete removes an item, or returns an error wrapping ErrNotFound.
	Delete(ctx context.Context, id string) error
}
-- internal/items/service.go --
package items

import (
	"context"
	"crypto/rand"
	"strings"
	"time"
)

// Service is everything the items domain can do. Handlers depend on it,
// never on a Repository directly.
type Service interface {
	List(ctx context.Context) ([]Item, error)
	Get(ctx context.Context, id string) (Item, error)
	Create(ctx context.Context, in Input) (Item, error)
	Update(ctx context.Context, id string, in Input) (Item, error)
	Delete(ctx context.Context, id string) error
}

type service struct {
	repo Repository
	now  func() time.Time
}

var _ Service = (*service)(nil)

// NewService wires the domain to a Repository adapter.
func NewService(repo Repository) Service {
	return &service{repo: repo, now: now}
}

// now is truncated to milliseconds, the finest precision every supported
// store keeps, so an item reads back exactly as it was written.
func now() time.Time { return time.Now().UTC().Truncate(time.Millisecond) }

// newID returns a random ID. It is minted here rather than by the store, so
// its format doesn't depend on which database is behind the Repository.
func newID() string { return rand.Text() }

func (s *service) List(ctx context.Context) ([]Item, error) {
	list, err := s.repo.List(ctx)
	if list == nil && err == nil {
		list = []Item{} // encode as [] rather than null
	}
	return list, err
}

func (s *service) Get(ctx context.Context, id string) (Item, error) {
	return s.repo.ByID(ctx, id)
}

func (s *service) Create(ctx context.Context, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	t := s.now()
	it := Item{ID: newID(), Name: strings.TrimSpace(in.Name), CreatedAt: t, UpdatedAt: t}
	if err := s.repo.Insert(ctx, it); err != nil {
		return Item{}, err
	}
	return it, nil
}

func (s *service) Update(ctx context.Context, id string, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	it, err := s.repo.ByID(ctx, id)
	if err != nil {
		return Item{}, err
	}
	it.Name = strings.TrimSpace(in.Name)
	it.UpdatedAt = s.now()
	if err := s.repo.Update(ctx, it); err != nil {
		return Item{}, err
	}
	return it, nil
}

func (s *service) Delete(ctx context.Context, id string) error {
	return s.repo.Delete(ctx, id)
}
-- internal/items/service_test.go --
package items_test

import (
	"context"
	"errors"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/memory"
)

// The service is tested against the memory adapter. It passes the same
// contract as the real one (see itemstest), so no database is needed here.
func newService() items.Service { return items.NewService(memory.New()) }

func TestCreateTrimsAndStamps(t *testing.T) {
	ctx := context.Background()
	svc := newService()

	it, err := svc.Create(ctx, items.Input{Name: "  first  "})
	if err != nil {
		t.Fatal(err)
	}
	if it.ID == "" || it.Name != "first" {
		t.Errorf("Create = %+v, want an ID and a trimmed name", it)
	}
	if it.CreatedAt.IsZero() || !it.CreatedAt.Equal(it.UpdatedAt) {
		t.Errorf("timestamps = %v / %v, want equal and set", it.CreatedAt, it.UpdatedAt)
	}
	got, err := svc.Get(ctx, it.ID)
	if err != nil || got != it {
		t.Errorf("Get = %+v, %v; want %+v", got, err, it)
	}
}

func TestUpdateKeepsCreatedAt(t *testing.T) {
	ctx := context.Background()
	svc := newService()
	it, err := svc.Create(ctx, items.Input{Name: "first"})
	if err != nil {
		t.Fatal(err)
	}
	updated, err := svc.Update(ctx, it.ID, items.Input{Name: "renamed"})
	if err != nil {
		t.Fatal(err)
	}
	if updated.Name != "renamed" || !updated.CreatedAt.Equal(it.CreatedAt) {
		t.Errorf("Update = %+v, want new name and the original CreatedAt", updated)
	}
}

func TestValidation(t *testing.T) {
	ctx := context.Background()
	svc := newService()
	for _, name := range []string{"", "   ", strings.Repeat("x", items.MaxNameLength+1)} {
		if _, err := svc.Create(ctx, items.Input{Name: name}); !errors.Is(err, items.ErrInvalid) {
			t.Errorf("Create(%q): err = %v, want ErrInvalid", name, err)
		}
	}
	if _, err := svc.Update(ctx, "missing", items.Input{Name: "x"}); !errors.Is(err, items.ErrNotFound) {
		t.Errorf("Update missing: err = %v, want ErrNotFound", err)
	}
}

func TestListIsNeverNil(t *testing.T) {
	list, err := newService().List(context.Background())
	if err != nil || list == nil {
		t.Errorf("List = %#v, %v; want an empty, non-nil slice", list, err)
	}
}
-- internal/server/health.go --
package server

import (
	"context"
	"log"
	"net/http"
	"time"

	"github.com/example/my-api/internal/httpx"
)

// livez is the liveness probe. It only reports that the process can serve
// HTTP and deliberately ignores dependencies: if it failed during a database
// outage, Kubernetes would restart every pod at once and make things worse.
func (s *Server) livez(w http.ResponseWriter, r *http.Request) {
	httpx.JSON(w, http.StatusOK, map[string]string{"status": "up"})
}

// readyz is the readiness probe. It fails while the server is shutting down
// or a dependency is down, so Kubernetes stops routing traffic to this pod
// without restarting it.
func (s *Server) readyz(w http.ResponseWriter, r *http.Request) {
	if s.draining.Load() {
		httpx.JSON(w, http.StatusServiceUnavailable, map[string]string{"status": "shutting down"})
		return
	}
	code, res := s.health(r.Context())
	httpx.JSON(w, code, res)
}

// healthz reports each dependency, for people and monitoring.
func (s *Server) healthz(w http.ResponseWriter, r *http.Request) {
	code, res := s.health(r.Context())
	httpx.JSON(w, code, res)
}

// health runs every check and reports each one as "up" or "down", plus the
// HTTP code to answer with.
func (s *Server) health(ctx context.Context) (int, map[string]string) {
	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
	defer cancel()

	code, res := http.StatusOK, map[string]string{"status": "up"}
	for name, check := range s.checks {
		if err := check(ctx); err != nil {
			log.Printf("health check %s: %v", name, err)
			res[name] = "down"
			res["status"] = "down"
			code = http.StatusServiceUnavailable
			continue
		}
		res[name] = "up"
	}
	return code, res
}
-- internal/server/health_test.go --
package server

import (
	"context"
	"errors"
	"net/http"
	"testing"
)

func TestProbes(t *testing.T) {
	s := newTestServer()
	h := s.Handler()
	for _, path := range []string{"/livez", "/readyz", "/health"} {
		if rec := do(t, h, http.MethodGet, path, "", nil); rec.Code != http.StatusOK {
			t.Errorf("GET %s = %d, want %d", path, rec.Code, http.StatusOK)
		}
	}
}

func TestReadyzFailsWhenDependencyIsDown(t *testing.T) {
	s := newTestServer()
	s.checks = map[string]func(context.Context) error{
		"database": func(context.Context) error { return errors.New("connection refused") },
	}
	h := s.Handler()

	var body map[string]string
	if rec := do(t, h, http.MethodGet, "/readyz", "", &body); rec.Code != http.StatusServiceUnavailable {
		t.Errorf("GET /readyz = %d, want %d", rec.Code, http.StatusServiceUnavailable)
	}
	if body["database"] != "down" {
		t.Errorf("body = %v, want database down", body)
	}
	// Liveness ignores dependencies, so the pod is not restarted.
	if rec := do(t, h, http.MethodGet, "/livez", "", nil); rec.Code != http.StatusOK {
		t.Errorf("GET /livez = %d, want %d", rec.Code, http.StatusOK)
	}
}

func TestReadyzFailsWhileDraining(t *testing.T) {
	s := newTestServer()
	s.draining.Store(true)
	h := s.Handler()

	if rec := do(t, h, http.MethodGet, "/readyz", "", nil); rec.Code != http.StatusServiceUnavailable {
		t.Errorf("GET /readyz = %d, want %d", rec.Code, http.StatusServiceUnavailable)
	}
	if rec := do(t, h, http.MethodGet, "/livez", "", nil); rec.Code != http.StatusOK {
		t.Errorf("GET /livez = %d, want %d", rec.Code, http.StatusOK)
	}
}
-- internal/server/items_test.go --
package server

import (
	"net/http"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
)

// TestItemsAPI walks the /api/v1/items resource through its whole life cycle.
func TestItemsAPI(t *testing.T) {
	h := newTestServer().Handler()

	var created items.Item
	rec := do(t, h, http.MethodPost, "/api/v1/items", `{"name":"first"}`, &created)
	if rec.Code != http.StatusCreated {
		t.Fatalf("POST = %d, want %d: %s", rec.Code, http.StatusCreated, rec.Body)
	}
	if created.ID == "" || created.Name != "first" {
		t.Fatalf("POST body = %+v", created)
	}
	if got, want := rec.Header().Get("Location"), "/api/v1/items/"+created.ID; got != want {
		t.Errorf("Location = %q, want %q", got, want)
	}

	var list struct{ Items []items.Item }
	if rec := do(t, h, http.MethodGet, "/api/v1/items", "", &list); rec.Code != http.StatusOK || len(list.Items) != 1 {
		t.Errorf("GET list = %d with %d items, want 200 with 1", rec.Code, len(list.Items))
	}

	var updated items.Item
	if rec := do(t, h, http.MethodPut, "/api/v1/items/"+created.ID, `{"name":"renamed"}`, &updated); rec.Code != http.StatusOK || updated.Name != "renamed" {
		t.Errorf("PUT = %d %+v, want 200 renamed", rec.Code, updated)
	}

	var got items.Item
	if rec := do(t, h, http.MethodGet, "/api/v1/items/"+created.ID, "", &got); rec.Code != http.StatusOK || got.Name != "renamed" {
		t.Errorf("GET = %d %+v, want 200 renamed", rec.Code, got)
	}

	if rec := do(t, h, http.MethodDelete, "/api/v1/items/"+created.ID, "", nil); rec.Code != http.StatusNoContent {
		t.Errorf("DELETE = %d, want %d", rec.Code, http.StatusNoContent)
	}

	rec = do(t, h, http.MethodGet, "/api/v1/items/"+created.ID, "", nil)
	if rec.Code != http.StatusNotFound {
		t.Errorf("GET after DELETE = %d, want %d", rec.Code, http.StatusNotFound)
	}
	if ct := rec.Header().Get("Content-Type"); !strings.HasPrefix(ct, "application/problem+json") {
		t.Errorf("error Content-Type = %q, want application/problem+json", ct)
	}
}

func TestItemsAPIValidation(t *testing.T) {
	h := newTestServer().Handler()

	var p struct {
		Status int    `json:"status"`
		Detail string `json:"detail"`
	}
	rec := do(t, h, http.MethodPost, "/api/v1/items", `{"name":""}`, &p)
	if rec.Code != http.StatusUnprocessableEntity || p.Status != http.StatusUnprocessableEntity {
		t.Errorf("POST empty name = %d (body status %d), want %d", rec.Code, p.Status, http.StatusUnprocessableEntity)
	}

	if rec := do(t, h, http.MethodPut, "/api/v1/items/missing", `{"name":"x"}`, nil); rec.Code != http.StatusNotFound {
		t.Errorf("PUT missing = %d, want %d", rec.Code, http.StatusNotFound)
	}
	if rec := do(t, h, http.MethodPost, "/api/v1/items", `{not json`, nil); rec.Code != http.StatusBadRequest {
		t.Errorf("POST malformed JSON = %d, want %d", rec.Code, http.StatusBadRequest)
	}
}
-- internal/server/routes.go --
package server

import (
	"github.com/labstack/echo/v5"
	"github.com/labstack/echo/v5/middleware"
	"net/http"

	itemshandler "github.com/example/my-api/internal/items/handler"
)

// RegisterRoutes returns the router with every API route mounted. The
// probes (/livez, /readyz, /health) are served by Handler.
func (s *Server) RegisterRoutes() http.Handler {
	e := echo.New()
	e.Use(middleware.RequestLogger(), middleware.Recover())

	e.GET("/", s.helloHandler)
	itemshandler.New(s.items).Register(e.Group(itemshandler.BasePath))

	return e
}

func (s *Server) helloHandler(c *echo.Context) error {
	return c.JSON(http.StatusOK, map[string]string{"message": "Hello World"})
}
-- internal/server/routes_test.go --
package server

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/memory"
)

// newTestServer returns a Server without external dependencies, so every
// health check passes. Items are kept by the memory adapter.
func newTestServer() *Server {
	return &Server{items: items.NewService(memory.New())}
}

// do sends a request through the full handler and decodes a JSON response
// into out, if out is not nil.
func do(t *testing.T, h http.Handler, method, path, body string, out any) *httptest.ResponseRecorder {
	t.Helper()
	req := httptest.NewRequest(method, path, strings.NewReader(body))
	if body != "" {
		req.Header.Set("Content-Type", "application/json")
	}
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, req)
	if out != nil {
		if err := json.Unmarshal(rec.Body.Bytes(), out); err != nil {
			t.Fatalf("%s %s: decode %q: %v", method, path, rec.Body.String(), err)
		}
	}
	return rec
}

func TestHello(t *testing.T) {
	var body map[string]string
	rec := do(t, newTestServer().Handler(), http.MethodGet, "/", "", &body)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
	}
	if got, want := body["message"], "Hello World"; got != want {
		t.Errorf("message = %q, want %q", got, want)
	}
}
-- internal/server/server.go --
package server

import (
	"context"
	"fmt"
	"log"
	"net/http"
	"os"
	"sync/atomic"
	"time"

	"github.com/example/my-api/internal/items"
	itemstore "github.com/example/my-api/internal/items/mongodb"

	"github.com/example/my-api/internal/database"
)

// Server is the HTTP server and the dependencies its handlers need.
type Server struct {
	srv           *http.Server
	draining      atomic.Bool   // set by Shutdown; fails /readyz
	shutdownDelay time.Duration // SHUTDOWN_DELAY, see Shutdown
	closers       []func() error

	// checks are run by /readyz and /health, keyed by the name shown in the
	// response.
	checks map[string]func(context.Context) error
	items  items.Service
	db     database.Service
}

// New connects the dependencies and builds the HTTP server. Call Close when
// done to release them.
func New(ctx context.Context) (*Server, error) {
	delay, err := time.ParseDuration(getenv("SHUTDOWN_DELAY", "0s"))
	if err != nil {
		return nil, fmt.Errorf("SHUTDOWN_DELAY: %w", err)
	}
	s := &Server{
		shutdownDelay: delay,
		checks:        map[string]func(context.Context) error{},
	}
	fail := func(what string, err error) (*Server, error) {
		s.Close()
		return nil, fmt.Errorf("%s: %w", what, err)
	}

	db, err := database.New()
	if err != nil {
		return fail("connect database", err)
	}
	s.db = db
	s.checks["database"] = db.Check
	s.closers = append(s.closers, db.Close)

	// Composition root: pick each domain's adapters here. The domain packages
	// only know their Repository interface.
	itemRepo := itemstore.New(db.Database())
	if err := itemRepo.Migrate(ctx); err != nil {
		return fail("migrate items", err)
	}
	s.items = items.NewService(itemRepo)

	s.srv = &http.Server{
		Addr:              ":" + getenv("PORT", "8080"),
		Handler:           s.Handler(),
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      30 * time.Second,
		IdleTimeout:       time.Minute,
	}
	return s, nil
}

// Handler serves the probes and the API. The probes are mounted outside the
// framework router so they stay cheap and don't fill the request log.
func (s *Server) Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /livez", s.livez)
	mux.HandleFunc("GET /readyz", s.readyz)
	mux.HandleFunc("GET /health", s.healthz)
	mux.Handle("/", s.RegisterRoutes())
	return mux
}

// Addr is the address the server listens on, e.g. ":8080".
func (s *Server) Addr() string { return s.srv.Addr }

// ListenAndServe serves until Shutdown; it then returns http.ErrServerClosed.
func (s *Server) ListenAndServe() error { return s.srv.ListenAndServe() }

// Shutdown stops the server without dropping requests during a Kubernetes
// rolling update. It first fails /readyz so the pod is taken out of the
// Service, waits SHUTDOWN_DELAY for ingress-nginx to stop sending new
// requests, then stops listening and waits for in-flight requests to finish.
func (s *Server) Shutdown(ctx context.Context) error {
	s.draining.Store(true)
	if s.shutdownDelay > 0 {
		log.Printf("draining for %s", s.shutdownDelay)
		select {
		case <-time.After(s.shutdownDelay):
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return s.srv.Shutdown(ctx)
}

// Close releases the dependencies in reverse order of creation.
func (s *Server) Close() {
	for i := len(s.closers) - 1; i >= 0; i-- {
		if err := s.closers[i](); err != nil {
			log.Printf("close: %v", err)
		}
	}
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
