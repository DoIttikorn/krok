-- internal/config/config.go --
// Package config loads settings into the process environment before the
// rest of the app reads them with os.Getenv.
package config

import (
	"context"
	"errors"
	"fmt"
	"io/fs"
	"os"
	"strings"
	"time"

	"github.com/Azure/azure-sdk-for-go/sdk/azidentity"
	"github.com/Azure/azure-sdk-for-go/sdk/security/keyvault/azsecrets"
	"github.com/joho/godotenv"
)

// Load copies every enabled secret from the Azure Key Vault named by
// AZURE_KEY_VAULT_NAME into the environment. A secret named DB-PASSWORD
// becomes DB_PASSWORD. Variables already set, in the real environment or in
// an optional .env file, take precedence over the vault so you can override
// a single value locally.
//
// Authentication uses DefaultAzureCredential: "az login" on a developer
// machine, managed identity or workload identity in Azure. The identity needs
// the "Key Vault Secrets User" role on the vault.
func Load(ctx context.Context) error {
	if err := godotenv.Load(); err != nil && !errors.Is(err, fs.ErrNotExist) {
		return err
	}
	name := os.Getenv("AZURE_KEY_VAULT_NAME")
	if name == "" {
		return errors.New("AZURE_KEY_VAULT_NAME is not set")
	}

	cred, err := azidentity.NewDefaultAzureCredential(nil)
	if err != nil {
		return fmt.Errorf("azure credential: %w", err)
	}
	client, err := azsecrets.NewClient(VaultURL(name), cred, nil)
	if err != nil {
		return fmt.Errorf("key vault client: %w", err)
	}

	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
	defer cancel()

	pager := client.NewListSecretPropertiesPager(nil)
	for pager.More() {
		page, err := pager.NextPage(ctx)
		if err != nil {
			return fmt.Errorf("list secrets in %s: %w", name, err)
		}
		for _, p := range page.Value {
			if skip(p) {
				continue
			}
			key := EnvKey(p.ID.Name())
			if _, set := os.LookupEnv(key); set {
				continue
			}
			resp, err := client.GetSecret(ctx, p.ID.Name(), "", nil)
			if err != nil {
				return fmt.Errorf("get secret %s: %w", p.ID.Name(), err)
			}
			if resp.Value == nil {
				continue
			}
			if err := os.Setenv(key, *resp.Value); err != nil {
				return err
			}
		}
	}
	return nil
}

// skip reports whether a secret should not be loaded: disabled secrets and
// the ones Key Vault manages to back certificates.
func skip(p *azsecrets.SecretProperties) bool {
	if p.ID == nil {
		return true
	}
	if p.Managed != nil && *p.Managed {
		return true
	}
	return p.Attributes != nil && p.Attributes.Enabled != nil && !*p.Attributes.Enabled
}

// VaultURL turns a vault name into its URL. A full URL is returned as is,
// for sovereign clouds such as https://my-vault.vault.azure.cn/.
func VaultURL(name string) string {
	if strings.Contains(name, "://") {
		return name
	}
	return "https://" + name + ".vault.azure.net/"
}

// EnvKey maps a Key Vault secret name to an environment variable name.
// Secret names allow only letters, digits and dashes.
func EnvKey(secret string) string {
	return strings.ToUpper(strings.ReplaceAll(secret, "-", "_"))
}
-- internal/config/config_test.go --
package config

import (
	"context"
	"strings"
	"testing"
)

func TestEnvKey(t *testing.T) {
	tests := map[string]string{
		"DB-PASSWORD": "DB_PASSWORD",
		"db-host":     "DB_HOST",
		"PORT":        "PORT",
	}
	for in, want := range tests {
		if got := EnvKey(in); got != want {
			t.Errorf("EnvKey(%q) = %q, want %q", in, got, want)
		}
	}
}

func TestVaultURL(t *testing.T) {
	if got, want := VaultURL("my-vault"), "https://my-vault.vault.azure.net/"; got != want {
		t.Errorf("VaultURL(name) = %q, want %q", got, want)
	}
	url := "https://my-vault.vault.azure.cn/"
	if got := VaultURL(url); got != url {
		t.Errorf("VaultURL(url) = %q, want %q", got, url)
	}
}

func TestLoadRequiresVaultName(t *testing.T) {
	t.Setenv("AZURE_KEY_VAULT_NAME", "")
	err := Load(context.Background())
	if err == nil || !strings.Contains(err.Error(), "AZURE_KEY_VAULT_NAME") {
		t.Fatalf("err = %v, want AZURE_KEY_VAULT_NAME is not set", err)
	}
}
-- internal/database/database.go --
package database

import (
	"context"
	"database/sql"
	"net"
	"net/url"
	"os"
	"time"

	_ "github.com/jackc/pgx/v5/stdlib"
)

// Service is the database dependency the server uses.
type Service interface {
	// Check pings the database; the server's /health uses it.
	Check(ctx context.Context) error
	// SQL returns the underlying connection pool for queries.
	SQL() *sql.DB
	Close() error
}

type service struct {
	db *sql.DB
}

// New opens a PostgreSQL connection pool configured from environment
// variables. It does not wait for the database to be reachable.
func New() (Service, error) {
	db, err := sql.Open("pgx", DSN())
	if err != nil {
		return nil, err
	}
	db.SetMaxOpenConns(25)
	db.SetMaxIdleConns(25)
	db.SetConnMaxIdleTime(5 * time.Minute)
	return &service{db: db}, nil
}

func (s *service) Check(ctx context.Context) error { return s.db.PingContext(ctx) }

// DSN returns the PostgreSQL connection URL built from the DB_* settings.
func DSN() string {
	u := url.URL{
		Scheme:   "postgres",
		User:     url.UserPassword(getenv("DB_USERNAME", "app"), getenv("DB_PASSWORD", "secret")),
		Host:     net.JoinHostPort(getenv("DB_HOST", "localhost"), getenv("DB_PORT", "5432")),
		Path:     getenv("DB_DATABASE", "my_api"),
		RawQuery: "sslmode=" + getenv("DB_SSLMODE", "disable"),
	}
	return u.String()
}

func (s *service) SQL() *sql.DB { return s.db }

func (s *service) Close() error { return s.db.Close() }

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/events/events.go --
// Package events publishes and subscribes to messages with Watermill, using
// Kafka as the broker. To switch brokers, change NewPublisher and
// newSubscriber; handlers stay the same.
package events

import (
	"context"
	"log/slog"

	"github.com/ThreeDotsLabs/watermill"
	wmkafka "github.com/ThreeDotsLabs/watermill-kafka/v3/pkg/kafka"
	"github.com/ThreeDotsLabs/watermill/message"

	"github.com/example/my-api/internal/kafka"
)

// Topic is the example topic RunWorker subscribes to.
const Topic = "example.events"

// Publisher publishes messages, e.g. via Publish.
type Publisher = message.Publisher

// Publish sends payload to topic.
func Publish(ctx context.Context, pub Publisher, topic string, payload []byte) error {
	msg := message.NewMessage(watermill.NewUUID(), payload)
	msg.SetContext(ctx)
	return pub.Publish(topic, msg)
}

// NewPublisher connects a publisher to the broker. Watermill logs through
// log.
func NewPublisher(log *slog.Logger) (Publisher, error) {
	logger := watermill.NewSlogLogger(log)
	return wmkafka.NewPublisher(wmkafka.PublisherConfig{
		Brokers:   kafka.Brokers(),
		Marshaler: wmkafka.DefaultMarshaler{},
	}, logger)
}

func newSubscriber(logger watermill.LoggerAdapter) (message.Subscriber, error) {
	return wmkafka.NewSubscriber(wmkafka.SubscriberConfig{
		Brokers:               kafka.Brokers(),
		Unmarshaler:           wmkafka.DefaultMarshaler{},
		ConsumerGroup:         "my-api-watermill",
		OverwriteSaramaConfig: wmkafka.DefaultSaramaSubscriberConfig(),
	}, logger)
}

// RunWorker handles messages until ctx is done. Add handlers to the router
// here. cmd/worker calls it.
func RunWorker(ctx context.Context, log *slog.Logger) error {
	logger := watermill.NewSlogLogger(log)
	sub, err := newSubscriber(logger)
	if err != nil {
		return err
	}
	defer sub.Close()

	router, err := message.NewRouter(message.RouterConfig{}, logger)
	if err != nil {
		return err
	}
	router.AddConsumerHandler("example", Topic, sub, func(msg *message.Message) error {
		log.InfoContext(msg.Context(), "message", "uuid", msg.UUID, "payload", string(msg.Payload))
		return nil
	})
	return router.Run(ctx)
}
-- internal/httpx/httpx.go --
// Package httpx has the JSON helpers every HTTP handler shares. Errors are
// RFC 9457 problem details (application/problem+json).
package httpx

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net/http"
)

// ErrBadRequest marks errors caused by a malformed request.
var ErrBadRequest = errors.New("bad request")

// MaxBodyBytes limits the request bodies DecodeJSON reads.
const MaxBodyBytes = 1 << 20

// DecodeJSON reads a JSON request body into v and rejects unknown fields.
// Its errors wrap ErrBadRequest.
func DecodeJSON(r *http.Request, v any) error {
	dec := json.NewDecoder(io.LimitReader(r.Body, MaxBodyBytes))
	dec.DisallowUnknownFields()
	if err := dec.Decode(v); err != nil {
		return fmt.Errorf("%w: invalid JSON body: %v", ErrBadRequest, err)
	}
	return nil
}

// JSON writes v with the given status.
func JSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	if err := json.NewEncoder(w).Encode(v); err != nil {
		slog.Default().Warn("write response", "error", err)
	}
}

// Problem is an RFC 9457 error response body.
type Problem struct {
	Title  string `json:"title"`
	Status int    `json:"status"`
	Detail string `json:"detail,omitempty"`
}

// WriteProblem writes a problem response. Pass an empty detail for server
// errors, so internals don't leak to clients.
func WriteProblem(w http.ResponseWriter, status int, detail string) {
	w.Header().Set("Content-Type", "application/problem+json")
	w.WriteHeader(status)
	p := Problem{Title: http.StatusText(status), Status: status, Detail: detail}
	if err := json.NewEncoder(w).Encode(p); err != nil {
		slog.Default().Warn("write response", "error", err)
	}
}
-- internal/httpx/middleware.go --
package httpx

import (
	"log/slog"
	"net/http"
	"runtime/debug"
	"time"
)

// Log logs every request through log and turns a panic into a 500 response,
// so all frameworks log requests the same way. 5xx responses are logged at
// error level, everything else at info.
func Log(log *slog.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			start := time.Now()
			rec := &recorder{ResponseWriter: w, status: http.StatusOK}
			defer func() {
				if v := recover(); v != nil {
					if v == http.ErrAbortHandler {
						panic(v) // the server's signal to abort the response
					}
					log.ErrorContext(r.Context(), "panic", "error", v, "stack", string(debug.Stack()))
					if !rec.wroteHeader {
						WriteProblem(rec, http.StatusInternalServerError, "")
					}
				}
				level := slog.LevelInfo
				if rec.status >= http.StatusInternalServerError {
					level = slog.LevelError
				}
				log.LogAttrs(r.Context(), level, "request",
					slog.String("method", r.Method),
					slog.String("path", r.URL.Path),
					slog.Int("status", rec.status),
					slog.Int("bytes", rec.bytes),
					slog.Duration("duration", time.Since(start)),
					slog.String("remote", r.RemoteAddr),
				)
			}()
			next.ServeHTTP(rec, r)
		})
	}
}

// recorder remembers the status and size of a response.
type recorder struct {
	http.ResponseWriter
	status, bytes int
	wroteHeader   bool
}

func (r *recorder) WriteHeader(code int) {
	if !r.wroteHeader {
		r.status, r.wroteHeader = code, true
	}
	r.ResponseWriter.WriteHeader(code)
}

func (r *recorder) Write(b []byte) (int, error) {
	if !r.wroteHeader {
		r.WriteHeader(http.StatusOK)
	}
	n, err := r.ResponseWriter.Write(b)
	r.bytes += n
	return n, err
}

// Unwrap lets http.ResponseController reach the underlying writer, e.g. to
// flush.
func (r *recorder) Unwrap() http.ResponseWriter { return r.ResponseWriter }
-- internal/httpx/middleware_test.go --
package httpx

import (
	"bytes"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

func TestLogRecordsStatus(t *testing.T) {
	var buf bytes.Buffer
	h := Log(slog.New(slog.NewTextHandler(&buf, nil)))(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusTeapot)
	}))
	h.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/brew", nil))
	if out := buf.String(); !strings.Contains(out, "status=418") || !strings.Contains(out, "path=/brew") {
		t.Errorf("log = %q, want status=418 and path=/brew", out)
	}
}

func TestLogRecoversPanics(t *testing.T) {
	var buf bytes.Buffer
	h := Log(slog.New(slog.NewTextHandler(&buf, nil)))(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
		panic("boom")
	}))
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
	if rec.Code != http.StatusInternalServerError {
		t.Errorf("status = %d, want 500", rec.Code)
	}
	if out := buf.String(); !strings.Contains(out, "boom") || !strings.Contains(out, "level=ERROR") {
		t.Errorf("log = %q, want the panic at error level", out)
	}
}
-- internal/items/handler/handler.go --
// Package handler is the REST adapter for the items domain, registered with
// Huma: Huma validates requests against these types and documents them in
// the OpenAPI spec, and this package maps domain errors to RFC 9457 problems.
package handler

import (
	"context"
	"errors"
	"log/slog"
	"net/http"

	"github.com/danielgtaylor/huma/v2"

	"github.com/example/my-api/internal/items"
)

// BasePath is where these operations live.
const BasePath = "/api/v1/items"

// Service is the slice of items.Service these endpoints need. It is declared
// here, where it is used, so handler tests can pass a fake.
type Service interface {
	List(ctx context.Context) ([]items.Item, error)
	Get(ctx context.Context, id string) (items.Item, error)
	Create(ctx context.Context, in items.Input) (items.Item, error)
	Update(ctx context.Context, id string, in items.Input) (items.Item, error)
	Delete(ctx context.Context, id string) error
}

// Handler serves BasePath.
type Handler struct {
	svc Service
	log *slog.Logger
}

func New(svc Service, log *slog.Logger) *Handler { return &Handler{svc: svc, log: log} }

// Request and response shapes. Body is the JSON body; other fields map to
// path parameters and headers through their tags.
type (
	idInput struct {
		ID string `path:"id" doc:"Item ID"`
	}
	createInput struct {
		Body items.Input
	}
	updateInput struct {
		ID   string `path:"id" doc:"Item ID"`
		Body items.Input
	}
	itemOutput struct {
		Body items.Item
	}
	createdOutput struct {
		Location string `header:"Location" doc:"URL of the new item"`
		Body     items.Item
	}
	listOutput struct {
		Body struct {
			Items []items.Item `json:"items"`
		}
	}
)

// Register adds the operations to api.
func (h *Handler) Register(api huma.API) {
	tags := []string{"Items"}

	huma.Register(api, huma.Operation{
		OperationID: "list-items", Method: http.MethodGet, Path: BasePath,
		Summary: "List items", Tags: tags,
	}, func(ctx context.Context, _ *struct{}) (*listOutput, error) {
		list, err := h.svc.List(ctx)
		if err != nil {
			return nil, h.apiError(err)
		}
		out := &listOutput{}
		out.Body.Items = list
		return out, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "create-item", Method: http.MethodPost, Path: BasePath,
		Summary: "Create an item", Tags: tags, DefaultStatus: http.StatusCreated,
	}, func(ctx context.Context, in *createInput) (*createdOutput, error) {
		it, err := h.svc.Create(ctx, in.Body)
		if err != nil {
			return nil, h.apiError(err)
		}
		return &createdOutput{Location: BasePath + "/" + it.ID, Body: it}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "get-item", Method: http.MethodGet, Path: BasePath + "/{id}",
		Summary: "Get an item", Tags: tags,
	}, func(ctx context.Context, in *idInput) (*itemOutput, error) {
		it, err := h.svc.Get(ctx, in.ID)
		if err != nil {
			return nil, h.apiError(err)
		}
		return &itemOutput{Body: it}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "update-item", Method: http.MethodPut, Path: BasePath + "/{id}",
		Summary: "Replace an item", Tags: tags,
	}, func(ctx context.Context, in *updateInput) (*itemOutput, error) {
		it, err := h.svc.Update(ctx, in.ID, in.Body)
		if err != nil {
			return nil, h.apiError(err)
		}
		return &itemOutput{Body: it}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "delete-item", Method: http.MethodDelete, Path: BasePath + "/{id}",
		Summary: "Delete an item", Tags: tags, DefaultStatus: http.StatusNoContent,
	}, func(ctx context.Context, in *idInput) (*struct{}, error) {
		if err := h.svc.Delete(ctx, in.ID); err != nil {
			return nil, h.apiError(err)
		}
		return nil, nil
	})
}

// apiError maps domain errors to problem responses. Unexpected errors are
// logged, and their details are not sent to the client.
func (h *Handler) apiError(err error) error {
	switch {
	case errors.Is(err, items.ErrNotFound):
		return huma.Error404NotFound(err.Error())
	case errors.Is(err, items.ErrInvalid):
		return huma.Error422UnprocessableEntity(err.Error())
	}
	h.log.Error("items", "error", err)
	return huma.Error500InternalServerError("")
}
-- internal/items/items.go --
// Package items is an example domain, laid out as ports and adapters:
//
//   - this package holds the model, the business rules (Service) and the
//     Repository interface the rules need. It imports no database driver
//     and no web framework;
//   - adapters live in sub-packages and depend on this one: memory
//     (in-process, also the test double), postgres (the real store), and handler (the
//     REST endpoints);
//   - itemstest is the contract every Repository must pass, so any
//     adapter can replace another without changing the service.
//
// Copy this layout for your own domains, e.g. internal/order.
package items

import (
	"errors"
	"fmt"
	"strings"
	"time"
)

// Item is the domain model returned by the API.
type Item struct {
	ID        string    `json:"id" doc:"Unique identifier"`
	Name      string    `json:"name" doc:"Display name"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// Input is what a client sends to create or replace an item.
type Input struct {
	Name string `json:"name" minLength:"1" maxLength:"200" doc:"Display name"`
}

// MaxNameLength is the longest name the service accepts, in bytes.
const MaxNameLength = 200

var (
	// ErrNotFound is returned when no item has the requested ID.
	ErrNotFound = errors.New("item not found")
	// ErrInvalid wraps validation errors in the input.
	ErrInvalid = errors.New("invalid item")
)

// Validate reports whether in can be stored.
func (in Input) Validate() error {
	name := strings.TrimSpace(in.Name)
	switch {
	case name == "":
		return fmt.Errorf("%w: name is required", ErrInvalid)
	case len(name) > MaxNameLength:
		return fmt.Errorf("%w: name must be at most %d bytes", ErrInvalid, MaxNameLength)
	}
	return nil
}
-- internal/items/itemstest/itemstest.go --
// Package itemstest is the contract every items.Repository must pass.
//
// The service is tested against the memory adapter, which is only safe if
// every other adapter behaves the same way. Each adapter's tests call Run:
// memory in ordinary unit tests, the database adapters against a real
// database (INTEGRATION=1).
package itemstest

import (
	"context"
	"errors"
	"testing"
	"time"

	"github.com/example/my-api/internal/items"
)

// Run checks the Repository contract. newRepo must return an empty
// repository on every call.
func Run(t *testing.T, newRepo func(t *testing.T) items.Repository) {
	ctx := context.Background()
	// Millisecond precision, like the service, so every store keeps it exactly.
	base := time.Date(2026, 1, 2, 3, 4, 5, 6_000_000, time.UTC)
	item := func(id, name string, created time.Time) items.Item {
		return items.Item{ID: id, Name: name, CreatedAt: created, UpdatedAt: created}
	}

	t.Run("insert then get", func(t *testing.T) {
		r := newRepo(t)
		want := item("a", "first", base)
		mustInsert(t, r, want)
		got, err := r.ByID(ctx, "a")
		if err != nil {
			t.Fatal(err)
		}
		assertItem(t, got, want)
	})

	t.Run("get missing is ErrNotFound", func(t *testing.T) {
		if _, err := newRepo(t).ByID(ctx, "missing"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})

	t.Run("list is oldest first", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("c", "third", base.Add(2*time.Second)))
		mustInsert(t, r, item("a", "first", base))
		mustInsert(t, r, item("b", "second", base.Add(time.Second)))
		list, err := r.List(ctx)
		if err != nil {
			t.Fatal(err)
		}
		var ids []string
		for _, it := range list {
			ids = append(ids, it.ID)
		}
		if len(ids) != 3 || ids[0] != "a" || ids[1] != "b" || ids[2] != "c" {
			t.Errorf("List IDs = %v, want [a b c]", ids)
		}
	})

	t.Run("list empty", func(t *testing.T) {
		list, err := newRepo(t).List(ctx)
		if err != nil || len(list) != 0 {
			t.Errorf("List = %v, %v; want no items", list, err)
		}
	})

	t.Run("update changes name and UpdatedAt only", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("a", "first", base))
		changed := items.Item{ID: "a", Name: "renamed", CreatedAt: base.Add(time.Hour), UpdatedAt: base.Add(time.Minute)}
		if err := r.Update(ctx, changed); err != nil {
			t.Fatal(err)
		}
		got, err := r.ByID(ctx, "a")
		if err != nil {
			t.Fatal(err)
		}
		assertItem(t, got, items.Item{ID: "a", Name: "renamed", CreatedAt: base, UpdatedAt: base.Add(time.Minute)})
	})

	t.Run("update with unchanged values", func(t *testing.T) {
		r := newRepo(t)
		it := item("a", "first", base)
		mustInsert(t, r, it)
		if err := r.Update(ctx, it); err != nil {
			t.Errorf("err = %v, want nil: the item exists even if nothing changed", err)
		}
	})

	t.Run("update missing is ErrNotFound", func(t *testing.T) {
		if err := newRepo(t).Update(ctx, item("missing", "x", base)); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})

	t.Run("delete", func(t *testing.T) {
		r := newRepo(t)
		mustInsert(t, r, item("a", "first", base))
		if err := r.Delete(ctx, "a"); err != nil {
			t.Fatal(err)
		}
		if _, err := r.ByID(ctx, "a"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("ByID after Delete: err = %v, want ErrNotFound", err)
		}
	})

	t.Run("delete missing is ErrNotFound", func(t *testing.T) {
		if err := newRepo(t).Delete(ctx, "missing"); !errors.Is(err, items.ErrNotFound) {
			t.Errorf("err = %v, want ErrNotFound", err)
		}
	})
}

func mustInsert(t *testing.T, r items.Repository, it items.Item) {
	t.Helper()
	if err := r.Insert(context.Background(), it); err != nil {
		t.Fatalf("Insert(%s): %v", it.ID, err)
	}
}

func assertItem(t *testing.T, got, want items.Item) {
	t.Helper()
	if got.ID != want.ID || got.Name != want.Name ||
		!got.CreatedAt.Equal(want.CreatedAt) || !got.UpdatedAt.Equal(want.UpdatedAt) {
		t.Errorf("got %+v\nwant %+v", got, want)
	}
}
-- internal/items/memory/memory.go --
// Package memory is an in-process items.Repository. It backs the service
// when there is no database, and it is the test double for the service:
// it passes the same contract as the database adapters.
//
// Each process has its own copy and everything is lost on restart, so it
// is not for production.
package memory

import (
	"cmp"
	"context"
	"fmt"
	"slices"
	"strings"
	"sync"

	"github.com/example/my-api/internal/items"
)

// Repository is safe for concurrent use.
type Repository struct {
	mu    sync.RWMutex
	items map[string]items.Item
}

var _ items.Repository = (*Repository)(nil)

func New() *Repository {
	return &Repository{items: map[string]items.Item{}}
}

func (r *Repository) List(ctx context.Context) ([]items.Item, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	out := make([]items.Item, 0, len(r.items))
	for _, it := range r.items {
		out = append(out, it)
	}
	slices.SortFunc(out, func(a, b items.Item) int {
		return cmp.Or(a.CreatedAt.Compare(b.CreatedAt), strings.Compare(a.ID, b.ID))
	})
	return out, nil
}

func (r *Repository) ByID(ctx context.Context, id string) (items.Item, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	it, ok := r.items[id]
	if !ok {
		return items.Item{}, fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	return it, nil
}

func (r *Repository) Insert(ctx context.Context, it items.Item) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.items[it.ID] = it
	return nil
}

func (r *Repository) Update(ctx context.Context, it items.Item) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	cur, ok := r.items[it.ID]
	if !ok {
		return fmt.Errorf("%w: %s", items.ErrNotFound, it.ID)
	}
	cur.Name, cur.UpdatedAt = it.Name, it.UpdatedAt
	r.items[it.ID] = cur
	return nil
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if _, ok := r.items[id]; !ok {
		return fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	delete(r.items, id)
	return nil
}
