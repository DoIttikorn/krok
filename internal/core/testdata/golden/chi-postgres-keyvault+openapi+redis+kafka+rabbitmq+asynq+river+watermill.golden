# step: go mod tidy
# step: git init --quiet
-- .air.toml --
# Live reload for development: run "make watch".
# Reference: https://github.com/air-verse/air/blob/master/air_example.toml
root = "."
tmp_dir = "tmp"

[build]
  cmd = "go build -o ./tmp/main ./cmd/api"
  entrypoint = ["./tmp/main"]
  include_ext = ["go"]
  exclude_dir = ["bin", "tmp", "vendor", "deploy"]
  exclude_regex = ["_test\\.go"]
  delay = 500 # ms
  stop_on_error = true
  send_interrupt = true
  kill_delay = "5s"

[misc]
  clean_on_exit = true
-- .dockerignore --
.git
.env
bin/
tmp/
deploy/
*.test
*.out
-- .env --
# Settings come from Azure Key Vault: a secret named DB-PASSWORD becomes
# DB_PASSWORD. Anything set here or in the real environment wins over the vault.
AZURE_KEY_VAULT_NAME=
-- .gitignore --
# Binaries
/bin/
/tmp/
*.exe
*.test

# Coverage
*.out

# Local environment
.env
-- Dockerfile --
# syntax=docker/dockerfile:1

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ ./cmd/...

# distroless/static has CA certificates and runs as a non-root user.
FROM gcr.io/distroless/static-debian12:nonroot
# One JSON object per line, for Kubernetes log collectors.
ENV LOG_FORMAT=json
COPY --from=build /out/api /api
# The worker ships in the same image; run it with entrypoint ["/worker"].
COPY --from=build /out/worker /worker
EXPOSE 8080
ENTRYPOINT ["/api"]
-- Makefile --
.PHONY: run watch build test test-integration tidy clean docker-build up down logs k8s k8s-apply run-worker deps-up

IMAGE := my-api

## Development

run:
	go run ./cmd/api

run-worker:
	go run ./cmd/worker

# Live reload with air; uses an installed air or falls back to go run.
watch:
	@if command -v air > /dev/null 2>&1; then air; else go run github.com/air-verse/air@latest; fi

# Builds every command in cmd/ into bin/.
build:
	go build -o bin/ ./cmd/...

test:
	go test ./...

# Runs the repository contract against the real database too. Start it
# first with "make deps-up".
test-integration:
	INTEGRATION=1 go test ./...

tidy:
	go mod tidy

clean:
	rm -rf bin tmp

## Docker

docker-build:
	docker build -t $(IMAGE) .

up:
	docker compose up --build -d

down:
	docker compose down

logs:
	docker compose logs -f

## Kubernetes

# Print the manifests Kustomize renders from deploy/k8s.
k8s:
	kubectl kustomize deploy/k8s

k8s-apply:
	kubectl apply -k deploy/k8s

# Start only the services the app needs (db, redis, kafka, rabbitmq), for
# "make run" or "make watch" on the host.
deps-up:
	docker compose up -d --wait db redis kafka rabbitmq
-- README.md --
# my-api

Generated by [krok](https://github.com/DoIttikorn/krok) with **chi** and **postgres**, configured from **Azure Key Vault**.

Extras: openapi, redis, kafka, rabbitmq, asynq, river, watermill.

## Run

Set `AZURE_KEY_VAULT_NAME` in `.env` and sign in to Azure first (see [Configuration](#configuration)):

```bash
az login
```

On your machine, with live reload:

```bash
make deps-up     # start db, redis, kafka, rabbitmq in Docker
make watch       # API with live reload, or: make run
make run-worker  # background consumers, in another terminal
```

Everything in Docker:

```bash
make up      # docker compose up --build -d
make logs
make down
```

Then try the API:

```bash
curl -i -X POST localhost:8080/api/v1/items -d '{"name":"first"}'
curl localhost:8080/api/v1/items
curl localhost:8080/readyz
```

API docs: http://localhost:8080/docs (spec at `/openapi.json`).

## Endpoints

| Method | Path | Description |
| --- | --- | --- |
| `GET` | `/api/v1/items` | List items |
| `POST` | `/api/v1/items` | Create an item: `{"name": "..."}` → `201` with `Location` |
| `GET` | `/api/v1/items/{id}` | Get an item |
| `PUT` | `/api/v1/items/{id}` | Replace an item |
| `DELETE` | `/api/v1/items/{id}` | Delete an item → `204` |
| `GET` | `/livez` | Liveness probe: the process is up. Ignores dependencies |
| `GET` | `/readyz` | Readiness probe: every dependency is up and the server isn't shutting down |
| `GET` | `/health` | Status of each dependency, for people and monitoring |
| `GET` | `/docs`, `/openapi.json` | API docs and OpenAPI 3.1 spec (Huma) |

Errors use [RFC 9457](https://www.rfc-editor.org/rfc/rfc9457) problem details
(`application/problem+json`): `400` for malformed JSON, `404` for unknown IDs,
`422` for invalid input.

## Domains: ports and adapters

`items` is an example domain. Copy its layout for your own, e.g.
`internal/order`:

```
internal/items/
├── items.go          model, errors, input validation
├── service.go        business rules (Service)
├── repository.go     Repository interface: the only view of storage
├── memory/           in-process adapter; also the test double
├── postgres/         postgres adapter; creates its table on startup
├── itemstest/        contract every Repository adapter must pass
└── handler/          REST adapter, registered with Huma
```

- The domain package imports no database driver and no web framework.
  Adapters import the domain, never the other way round.
- `internal/server/server.go` is the one place that picks adapters: it
  builds the postgres repository and hands it to `items.NewService`.
- Service tests run against the memory adapter. That is safe because every
  adapter passes the same contract in `itemstest`: `make test` runs it for
  memory, and `make deps-up && make test-integration` runs it against the real
  postgres.
- The handler registers its routes with [Huma](https://huma.rocks), which
  validates requests against the Go types and generates the OpenAPI spec.

## Make targets

| Target | Description |
| --- | --- |
| `make run` | Run the API |
| `make watch` | Run with live reload ([air](https://github.com/air-verse/air), config in `.air.toml`) |
| `make run-worker` | Run the background worker (`cmd/worker`) |
| `make build` | Build every command into `bin/` |
| `make test` | Run tests |
| `make test-integration` | Run tests, including the repository contract against the real database (`make deps-up` first) |
| `make tidy` | Tidy `go.mod` |
| `make clean` | Remove build output |
| `make docker-build` | Build the Docker image `my-api` |
| `make up` / `make down` | Start / stop everything with Docker Compose |
| `make logs` | Follow Docker Compose logs |
| `make deps-up` | Start only db, redis, kafka, rabbitmq in Docker |
| `make k8s` | Print the Kubernetes manifests (`kubectl kustomize deploy/k8s`) |
| `make k8s-apply` | Apply them to the current cluster |

## API and worker

The API (`cmd/api`) only publishes messages and enqueues work; the worker
(`cmd/worker`) consumes it. Both ship in the same Docker image: the default
entrypoint is `/api`, and the worker runs with entrypoint `/worker`. Deploy
them as separate Deployments so each scales on its own.

| Feature | Publish / enqueue (API) | Consume (worker) |
| --- | --- | --- |
| Kafka | `kafka.Client.Publish` | `kafka.RunWorker`, topic `KAFKA_TOPIC` (default `events`) |
| RabbitMQ | `rabbitmq.Client.Publish` | `rabbitmq.RunWorker`, queue `RABBITMQ_QUEUE` (default `events`) |
| Asynq | `tasks.Client.Enqueue(tasks.NewExampleTask(...))` | `tasks.RunWorker`, register handlers there |
| River | `jobs.Client.Insert(ctx, jobs.ExampleArgs{...}, nil)` | `jobs.RunWorker`, register workers there |
| Watermill (kafka) | `events.Publish` | `events.RunWorker`, add handlers to the router |

## Logging

Everything logs through `log/slog`; `internal/logger` builds the logger, with
**slog** as the backend. Requests are logged once, the same way for every
framework, by `httpx.Log`, which also turns panics into 500 responses. Each worker logs with a `worker` attribute.

| Variable | Values | Default |
| --- | --- | --- |
| `LOG_LEVEL` | `debug`, `info`, `warn`, `error` | `info` |
| `LOG_FORMAT` | `text`, `json` | `text`; the Docker image sets `json` |

To switch backends, replace `internal/logger/handler.go`; nothing else refers
to slog.

## Configuration

Settings are read from Azure Key Vault at startup (`internal/config`):

- Set `AZURE_KEY_VAULT_NAME` to the vault name (a full vault URL also works): in `.env` locally, as an app setting in Azure.
- Authentication uses `DefaultAzureCredential`: `az login` on your machine, a managed identity in Azure. In Docker Compose, pass a service principal via `AZURE_TENANT_ID`, `AZURE_CLIENT_ID` and `AZURE_CLIENT_SECRET`.
- The identity needs the **Key Vault Secrets User** role on the vault.
- Every enabled secret becomes an environment variable, with `-` turned into `_`: `DB-PASSWORD` → `DB_PASSWORD`.
- Variables already set in the environment or `.env` win over the vault. Docker Compose sets the `DB_*` values for its own database container.

| Secret | Variable | Default |
| --- | --- | --- |
| `PORT` | `PORT` | `8080` |
| `DB-HOST` | `DB_HOST` | `localhost` |
| `DB-PORT` | `DB_PORT` | `5432` |
| `DB-DATABASE` | `DB_DATABASE` | `my_api` |
| `DB-USERNAME` | `DB_USERNAME` | `app` |
| `DB-PASSWORD` | `DB_PASSWORD` | `secret` |
| `REDIS-ADDR` | `REDIS_ADDR` | `localhost:6379` |
| `REDIS-PASSWORD` | `REDIS_PASSWORD` | _(empty)_ |
| `REDIS-DB` | `REDIS_DB` | `0` |
| `KAFKA-BROKERS` | `KAFKA_BROKERS` | `localhost:9092` |
| `RABBITMQ-URL` | `RABBITMQ_URL` | `amqp://app:secret@localhost:5672/` |

## Kubernetes and high availability

`deploy/k8s` is a Kustomize base. Set the image in `kustomization.yaml`,
the host in `ingress.yaml`, the vault name in the deployments
and the managed identity client ID in `serviceaccount.yaml`, then run
`make k8s-apply`.

What keeps the API available:

- **At least two replicas** (HorizontalPodAutoscaler, 2 to 10 on CPU),
  spread across nodes and zones.
- **Probes**: liveness (`/livez`) restarts a stuck process but ignores
  dependencies, so a database outage doesn't restart every pod; readiness
  (`/readyz`) takes a pod out of the Service while a dependency is down.
- **Zero-downtime rollouts**: `maxUnavailable: 0`, and on SIGTERM the server
  fails `/readyz`, waits `SHUTDOWN_DELAY` (5s in the manifest, 0 locally) for
  ingress-nginx to stop routing to it, then drains in-flight requests.
- **PodDisruptionBudget**: node drains evict one pod at a time.
- **Worker**: its own Deployment (2 replicas) with probes on port 8081
  (`HEALTH_PORT`).
-- cmd/api/main.go --
package main

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/example/my-api/internal/config"
	"github.com/example/my-api/internal/logger"
	"github.com/example/my-api/internal/server"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	// Settings first: LOG_LEVEL and LOG_FORMAT can come from them.
	if err := config.Load(ctx); err != nil {
		fmt.Fprintln(os.Stderr, "load config:", err)
		os.Exit(1)
	}
	log, err := logger.New()
	if err != nil {
		fmt.Fprintln(os.Stderr, "logger:", err)
		os.Exit(1)
	}

	srv, err := server.New(ctx, log)
	if err != nil {
		log.Error("create server", "error", err)
		os.Exit(1)
	}
	defer srv.Close()

	errCh := make(chan error, 1)
	go func() {
		log.Info("listening", "addr", srv.Addr())
		errCh <- srv.ListenAndServe()
	}()

	select {
	case err := <-errCh:
		if !errors.Is(err, http.ErrServerClosed) {
			log.Error("server", "error", err)
		}
		return
	case <-ctx.Done():
	}

	// Keep this below the pod's terminationGracePeriodSeconds (30s).
	log.Info("shutting down")
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
	defer cancel()
	if err := srv.Shutdown(shutdownCtx); err != nil {
		log.Error("shutdown", "error", err)
	}
}
-- cmd/worker/main.go --
// Command worker runs the background consumers. Deploy it separately from
// the API so each can scale on its own.
package main

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

	"github.com/example/my-api/internal/config"
	"github.com/example/my-api/internal/events"
	"github.com/example/my-api/internal/jobs"
	"github.com/example/my-api/internal/kafka"
	"github.com/example/my-api/internal/logger"
	"github.com/example/my-api/internal/rabbitmq"
	"github.com/example/my-api/internal/tasks"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	// Settings first: LOG_LEVEL and LOG_FORMAT can come from them.
	if err := config.Load(ctx); err != nil {
		fmt.Fprintln(os.Stderr, "load config:", err)
		os.Exit(1)
	}
	log, err := logger.New()
	if err != nil {
		fmt.Fprintln(os.Stderr, "logger:", err)
		os.Exit(1)
	}

	probes := probeServer()
	go func() {
		if err := probes.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			log.Error("probe server", "error", err)
		}
	}()
	defer probes.Close()

	err = run(ctx, log, map[string]worker{
		"kafka":     kafka.RunWorker,
		"rabbitmq":  rabbitmq.RunWorker,
		"asynq":     tasks.RunWorker,
		"river":     jobs.RunWorker,
		"watermill": events.RunWorker,
	})
	if err != nil {
		log.Error("worker stopped", "error", err)
		os.Exit(1)
	}
	log.Info("worker stopped")
}

// worker consumes until ctx is done. It logs through log, which already
// carries the worker's name.
type worker func(ctx context.Context, log *slog.Logger) error

// probeServer serves /livez and /readyz on HEALTH_PORT (default 8081) for
// Kubernetes. The worker takes no traffic, so both only report that the
// process is up; if a consumer fails, run returns and the process exits, and
// Kubernetes restarts the pod.
func probeServer() *http.Server {
	ok := func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		fmt.Fprintln(w, `{"status":"up"}`)
	}
	mux := http.NewServeMux()
	mux.HandleFunc("GET /livez", ok)
	mux.HandleFunc("GET /readyz", ok)
	port := os.Getenv("HEALTH_PORT")
	if port == "" {
		port = "8081"
	}
	return &http.Server{Addr: ":" + port, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
}

// run starts every worker and waits for all of them. When one fails, the
// others are stopped and its error is returned.
func run(ctx context.Context, log *slog.Logger, workers map[string]worker) error {
	ctx, cancel := context.WithCancel(ctx)
	defer cancel()

	errs := make(chan error, len(workers))
	var wg sync.WaitGroup
	for name, work := range workers {
		wg.Add(1)
		go func() {
			defer wg.Done()
			wlog := log.With("worker", name)
			wlog.Info("started")
			if err := work(ctx, wlog); err != nil {
				errs <- fmt.Errorf("%s: %w", name, err)
				cancel()
			}
		}()
	}
	wg.Wait()
	close(errs)
	return <-errs // the first error, or nil
}
-- deploy/k8s/deployment.yaml --
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  # No replicas field: the HorizontalPodAutoscaler owns it (minimum 2).
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0 # keep full capacity during a rollout
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: api
  template:
    metadata:
      labels:
        app.kubernetes.io/name: my-api
        app.kubernetes.io/component: api
        azure.workload.identity/use: "true"
    spec:
      serviceAccountName: my-api
      terminationGracePeriodSeconds: 30
      # Spread replicas across nodes and zones so one failure can't take
      # them all down.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: api
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: api
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532 # the distroless "nonroot" user
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: api
          image: my-api
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: PORT
              value: "8080"
            # On SIGTERM, fail /readyz and wait this long before closing the
            # listener, so ingress-nginx stops sending requests first.
            - name: SHUTDOWN_DELAY
              value: 5s
            - name: AZURE_KEY_VAULT_NAME
              value: your-key-vault # TODO
          # Settings from a Secret, if present:
          #   kubectl create secret generic my-api-env --from-env-file=.env
          envFrom:
            - secretRef:
                name: my-api-env
                optional: true
          # Gives a slow start up to 60s before liveness checks begin.
          startupProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 2
            failureThreshold: 30
          # Restarts the container only if the process stops answering.
          livenessProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          # Takes the pod out of the Service while a dependency is down or
          # while it shuts down.
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 2
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
-- deploy/k8s/hpa.yaml --
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: my-api
  minReplicas: 2 # at least two, so one can restart without downtime
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
-- deploy/k8s/ingress.yaml --
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  ingressClassName: nginx
  rules:
    - host: my-api.example.com # TODO: your host
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: my-api
                port:
                  name: http
-- deploy/k8s/kustomization.yaml --
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# namespace: my-api

labels:
  - pairs:
      app.kubernetes.io/part-of: my-api

resources:
  - deployment.yaml
  - service.yaml
  - ingress.yaml
  - pdb.yaml
  - hpa.yaml
  - worker-deployment.yaml
  - worker-pdb.yaml
  - serviceaccount.yaml

# Point this at your registry, or run:
#   kustomize edit set image my-api=registry.example.com/my-api:v1.0.0
images:
  - name: my-api
    newName: registry.example.com/my-api
    newTag: latest
-- deploy/k8s/pdb.yaml --
# Node drains and cluster upgrades evict at most one API pod at a time.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: api
-- deploy/k8s/service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  selector:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
  ports:
    - name: http
      port: 80
      targetPort: http
-- deploy/k8s/serviceaccount.yaml --
# Azure Workload Identity: pods using this account get a token for the
# managed identity below, which DefaultAzureCredential uses to read Key Vault.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
  annotations:
    # Client ID of a managed identity with "Key Vault Secrets User" on the vault.
    azure.workload.identity/client-id: 00000000-0000-0000-0000-000000000000 # TODO
-- deploy/k8s/worker-deployment.yaml --
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-api-worker
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: worker
spec:
  replicas: 2
  revisionHistoryLimit: 5
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: my-api
        app.kubernetes.io/component: worker
        azure.workload.identity/use: "true"
    spec:
      serviceAccountName: my-api
      terminationGracePeriodSeconds: 30
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: worker
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: worker
          image: my-api
          command: ["/worker"]
          ports:
            - name: health
              containerPort: 8081
          env:
            - name: AZURE_KEY_VAULT_NAME
              value: your-key-vault # TODO
          envFrom:
            - secretRef:
                name: my-api-env
                optional: true
          livenessProbe:
            httpGet:
              path: /livez
              port: health
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            periodSeconds: 10
            timeoutSeconds: 2
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
-- deploy/k8s/worker-pdb.yaml --
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: my-api-worker
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: worker
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: worker
-- docker-compose.yml --
# Settings shared by the app and the worker.
x-app-env: &app-env
  PORT: "8080"
  DB_HOST: db
  DB_PORT: "5432"
  DB_DATABASE: ${DB_DATABASE:-my_api}
  DB_USERNAME: ${DB_USERNAME:-app}
  DB_PASSWORD: ${DB_PASSWORD:-secret}
  REDIS_ADDR: redis:6379
  KAFKA_BROKERS: kafka:29092
  RABBITMQ_URL: amqp://app:secret@rabbitmq:5672/
  AZURE_KEY_VAULT_NAME: ${AZURE_KEY_VAULT_NAME:-}
  # A container can't use your "az login"; pass a service principal instead.
  AZURE_TENANT_ID: ${AZURE_TENANT_ID:-}
  AZURE_CLIENT_ID: ${AZURE_CLIENT_ID:-}
  AZURE_CLIENT_SECRET: ${AZURE_CLIENT_SECRET:-}

x-app-depends: &app-depends
  db:
    condition: service_healthy
  redis:
    condition: service_healthy
  kafka:
    condition: service_healthy
  rabbitmq:
    condition: service_healthy

services:
  app:
    build: .
    restart: unless-stopped
    ports:
      - "${PORT:-8080}:8080"
    environment: *app-env
    depends_on: *app-depends

  worker:
    build: .
    entrypoint: ["/worker"]
    restart: unless-stopped
    environment: *app-env
    depends_on: *app-depends

  db:
    image: postgres:17-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USERNAME:-app}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-secret}
      POSTGRES_DB: ${DB_DATABASE:-my_api}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:8-alpine
    restart: unless-stopped
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10

  # Single-node Kafka in KRaft mode. Containers use kafka:29092, the host
  # uses localhost:9092.
  kafka:
    image: apache/kafka:4.3.1
    restart: unless-stopped
    ports:
      - "9092:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:29092,CONTROLLER://:29093,PLAINTEXT_HOST://:9092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:29093
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:29092 > /dev/null 2>&1"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 15s

  rabbitmq:
    image: rabbitmq:4-management-alpine
    restart: unless-stopped
    environment:
      RABBITMQ_DEFAULT_USER: app
      RABBITMQ_DEFAULT_PASS: secret
    ports:
      - "5672:5672"
      - "15672:15672" # management UI: http://localhost:15672
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 10s
      retries: 10

volumes:
  db_data:
