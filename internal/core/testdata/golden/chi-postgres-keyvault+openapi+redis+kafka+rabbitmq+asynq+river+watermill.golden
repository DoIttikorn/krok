package memory_test

import (
	"testing"

	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/itemstest"
	"github.com/example/my-api/internal/items/memory"
)

func TestContract(t *testing.T) {
	itemstest.Run(t, func(t *testing.T) items.Repository { return memory.New() })
}
-- internal/items/postgres/repository.go --
// Package postgres is the PostgreSQL adapter for the items domain.
package postgres

import (
	"context"
	"database/sql"
	"errors"
	"fmt"

	"github.com/example/my-api/internal/items"
)

// Repository stores items in the "items" table.
type Repository struct {
	db *sql.DB
}

var _ items.Repository = (*Repository)(nil)

// New uses the shared pool; it doesn't open connections of its own.
func New(db *sql.DB) *Repository { return &Repository{db: db} }

// Migrate creates the table if it doesn't exist. Every replica calls it on
// startup; the advisory lock makes them take turns, because concurrent
// CREATE TABLE IF NOT EXISTS can fail in PostgreSQL. Move to a migration
// tool (goose, golang-migrate, Atlas) once the schema starts to change.
func (r *Repository) Migrate(ctx context.Context) error {
	tx, err := r.db.BeginTx(ctx, nil)
	if err != nil {
		return err
	}
	defer tx.Rollback() //nolint:errcheck // no-op after Commit
	if _, err := tx.ExecContext(ctx, `SELECT pg_advisory_xact_lock(hashtext('items_migrate'))`); err != nil {
		return err
	}
	if _, err := tx.ExecContext(ctx, `CREATE TABLE IF NOT EXISTS items (
		id         TEXT PRIMARY KEY,
		name       TEXT NOT NULL,
		created_at TIMESTAMPTZ NOT NULL,
		updated_at TIMESTAMPTZ NOT NULL
	)`); err != nil {
		return err
	}
	return tx.Commit()
}

func (r *Repository) List(ctx context.Context) ([]items.Item, error) {
	rows, err := r.db.QueryContext(ctx, `SELECT id, name, created_at, updated_at FROM items ORDER BY created_at, id`)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	var out []items.Item
	for rows.Next() {
		it, err := scan(rows)
		if err != nil {
			return nil, err
		}
		out = append(out, it)
	}
	return out, rows.Err()
}

func (r *Repository) ByID(ctx context.Context, id string) (items.Item, error) {
	it, err := scan(r.db.QueryRowContext(ctx, `SELECT id, name, created_at, updated_at FROM items WHERE id = $1`, id))
	if errors.Is(err, sql.ErrNoRows) {
		return items.Item{}, fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	return it, err
}

func (r *Repository) Insert(ctx context.Context, it items.Item) error {
	_, err := r.db.ExecContext(ctx, `INSERT INTO items (id, name, created_at, updated_at) VALUES ($1, $2, $3, $4)`,
		it.ID, it.Name, it.CreatedAt, it.UpdatedAt)
	return err
}

func (r *Repository) Update(ctx context.Context, it items.Item) error {
	res, err := r.db.ExecContext(ctx, `UPDATE items SET name = $2, updated_at = $3 WHERE id = $1`,
		it.ID, it.Name, it.UpdatedAt)
	return notFoundIfNone(res, err, it.ID)
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	res, err := r.db.ExecContext(ctx, `DELETE FROM items WHERE id = $1`, id)
	return notFoundIfNone(res, err, id)
}

type scanner interface{ Scan(dest ...any) error }

func scan(s scanner) (items.Item, error) {
	var it items.Item
	if err := s.Scan(&it.ID, &it.Name, &it.CreatedAt, &it.UpdatedAt); err != nil {
		return items.Item{}, err
	}
	it.CreatedAt, it.UpdatedAt = it.CreatedAt.UTC(), it.UpdatedAt.UTC()
	return it, nil
}

func notFoundIfNone(res sql.Result, err error, id string) error {
	if err != nil {
		return err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return err
	}
	if n == 0 {
		return fmt.Errorf("%w: %s", items.ErrNotFound, id)
	}
	return nil
}
-- internal/items/postgres/repository_test.go --
package postgres

import (
	"context"
	"os"
	"testing"

	"github.com/example/my-api/internal/database"
	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/itemstest"
)

// TestContract runs the Repository contract against a real PostgreSQL:
//
//	make deps-up && make test-integration
func TestContract(t *testing.T) {
	if os.Getenv("INTEGRATION") == "" {
		t.Skip("set INTEGRATION=1 with the database running (make deps-up)")
	}
	ctx := context.Background()
	db, err := database.New()
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { db.Close() })
	repo := New(db.SQL())
	if err := repo.Migrate(ctx); err != nil {
		t.Fatal(err)
	}
	itemstest.Run(t, func(t *testing.T) items.Repository {
		if _, err := db.SQL().ExecContext(ctx, `DELETE FROM items`); err != nil {
			t.Fatal(err)
		}
		return repo
	})
}
-- internal/items/repository.go --
package items

import "context"

// Repository is the persistence port: the service's only view of storage.
//
// It is declared here, next to the service that uses it, so the domain
// never depends on a database. Every implementation must pass the contract
// in itemstest; that is what makes adapters interchangeable.
type Repository interface {
	// List returns every item, oldest first (by CreatedAt, then ID).
	List(ctx context.Context) ([]Item, error)

	// ByID returns one item, or an error wrapping ErrNotFound.
	ByID(ctx context.Context, id string) (Item, error)

	// Insert stores a new item. The service has already set every field.
	Insert(ctx context.Context, it Item) error

	// Update replaces the name and UpdatedAt of an existing item, or returns
	// an error wrapping ErrNotFound.
	Update(ctx context.Context, it Item) error

	// Delete removes an item, or returns an error wrapping ErrNotFound.
	Delete(ctx context.Context, id string) error
}
-- internal/items/service.go --
package items

import (
	"context"
	"crypto/rand"
	"strings"
	"time"
)

// Service is everything the items domain can do. Handlers depend on it,
// never on a Repository directly.
type Service interface {
	List(ctx context.Context) ([]Item, error)
	Get(ctx context.Context, id string) (Item, error)
	Create(ctx context.Context, in Input) (Item, error)
	Update(ctx context.Context, id string, in Input) (Item, error)
	Delete(ctx context.Context, id string) error
}

type service struct {
	repo Repository
	now  func() time.Time
}

var _ Service = (*service)(nil)

// NewService wires the domain to a Repository adapter.
func NewService(repo Repository) Service {
	return &service{repo: repo, now: now}
}

// now is truncated to milliseconds, the finest precision every supported
// store keeps, so an item reads back exactly as it was written.
func now() time.Time { return time.Now().UTC().Truncate(time.Millisecond) }

// newID returns a random ID. It is minted here rather than by the store, so
// its format doesn't depend on which database is behind the Repository.
func newID() string { return rand.Text() }

func (s *service) List(ctx context.Context) ([]Item, error) {
	list, err := s.repo.List(ctx)
	if list == nil && err == nil {
		list = []Item{} // encode as [] rather than null
	}
	return list, err
}

func (s *service) Get(ctx context.Context, id string) (Item, error) {
	return s.repo.ByID(ctx, id)
}

func (s *service) Create(ctx context.Context, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	t := s.now()
	it := Item{ID: newID(), Name: strings.TrimSpace(in.Name), CreatedAt: t, UpdatedAt: t}
	if err := s.repo.Insert(ctx, it); err != nil {
		return Item{}, err
	}
	return it, nil
}

func (s *service) Update(ctx context.Context, id string, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	it, err := s.repo.ByID(ctx, id)
	if err != nil {
		return Item{}, err
	}
	it.Name = strings.TrimSpace(in.Name)
	it.UpdatedAt = s.now()
	if err := s.repo.Update(ctx, it); err != nil {
		return Item{}, err
	}
	return it, nil
}

func (s *service) Delete(ctx context.Context, id string) error {
	return s.repo.Delete(ctx, id)
}
-- internal/items/service_test.go --
package items_test

import (
	"context"
	"errors"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
	"github.com/example/my-api/internal/items/memory"
)

// The service is tested against the memory adapter. It passes the same
// contract as the real one (see itemstest), so no database is needed here.
func newService() items.Service { return items.NewService(memory.New()) }

func TestCreateTrimsAndStamps(t *testing.T) {
	ctx := context.Background()
	svc := newService()

	it, err := svc.Create(ctx, items.Input{Name: "  first  "})
	if err != nil {
		t.Fatal(err)
	}
	if it.ID == "" || it.Name != "first" {
		t.Errorf("Create = %+v, want an ID and a trimmed name", it)
	}
	if it.CreatedAt.IsZero() || !it.CreatedAt.Equal(it.UpdatedAt) {
		t.Errorf("timestamps = %v / %v, want equal and set", it.CreatedAt, it.UpdatedAt)
	}
	got, err := svc.Get(ctx, it.ID)
	if err != nil || got != it {
		t.Errorf("Get = %+v, %v; want %+v", got, err, it)
	}
}

func TestUpdateKeepsCreatedAt(t *testing.T) {
	ctx := context.Background()
	svc := newService()
	it, err := svc.Create(ctx, items.Input{Name: "first"})
	if err != nil {
		t.Fatal(err)
	}
	updated, err := svc.Update(ctx, it.ID, items.Input{Name: "renamed"})
	if err != nil {
		t.Fatal(err)
	}
	if updated.Name != "renamed" || !updated.CreatedAt.Equal(it.CreatedAt) {
		t.Errorf("Update = %+v, want new name and the original CreatedAt", updated)
	}
}

func TestValidation(t *testing.T) {
	ctx := context.Background()
	svc := newService()
	for _, name := range []string{"", "   ", strings.Repeat("x", items.MaxNameLength+1)} {
		if _, err := svc.Create(ctx, items.Input{Name: name}); !errors.Is(err, items.ErrInvalid) {
			t.Errorf("Create(%q): err = %v, want ErrInvalid", name, err)
		}
	}
	if _, err := svc.Update(ctx, "missing", items.Input{Name: "x"}); !errors.Is(err, items.ErrNotFound) {
		t.Errorf("Update missing: err = %v, want ErrNotFound", err)
	}
}

func TestListIsNeverNil(t *testing.T) {
	list, err := newService().List(context.Background())
	if err != nil || list == nil {
		t.Errorf("List = %#v, %v; want an empty, non-nil slice", list, err)
	}
}
-- internal/jobs/jobs.go --
// Package jobs runs background jobs with River, stored in PostgreSQL.
package jobs

import (
	"context"
	"log/slog"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/riverqueue/river"
	"github.com/riverqueue/river/riverdriver/riverpgxv5"
	"github.com/riverqueue/river/rivermigrate"

	"github.com/example/my-api/internal/database"
)

// ExampleArgs is an example job. Each job type is an args struct with a
// Kind and a worker registered in RunWorker.
type ExampleArgs struct {
	Message string `json:"message"`
}

func (ExampleArgs) Kind() string { return "example" }

// ExampleWorker works ExampleArgs jobs.
type ExampleWorker struct {
	river.WorkerDefaults[ExampleArgs]
	log *slog.Logger
}

func (w *ExampleWorker) Work(ctx context.Context, job *river.Job[ExampleArgs]) error {
	w.log.InfoContext(ctx, "job", "id", job.ID, "message", job.Args.Message)
	return nil
}

// Client inserts jobs, e.g. c.Insert(ctx, jobs.ExampleArgs{Message: "hi"}, nil).
// It does not work them; cmd/worker does.
type Client struct {
	*river.Client[pgx.Tx]
	pool *pgxpool.Pool
}

// New connects to PostgreSQL with the DB_* settings, applies River's
// migrations and returns an insert-only client that logs through log.
func New(ctx context.Context, log *slog.Logger) (*Client, error) {
	pool, err := connect(ctx)
	if err != nil {
		return nil, err
	}
	rc, err := river.NewClient(riverpgxv5.New(pool), &river.Config{Logger: log})
	if err != nil {
		pool.Close()
		return nil, err
	}
	return &Client{Client: rc, pool: pool}, nil
}

func (c *Client) Close() error {
	c.pool.Close()
	return nil
}

// RunWorker works jobs until ctx is done. cmd/worker calls it.
func RunWorker(ctx context.Context, log *slog.Logger) error {
	pool, err := connect(ctx)
	if err != nil {
		return err
	}
	defer pool.Close()

	workers := river.NewWorkers()
	river.AddWorker(workers, &ExampleWorker{log: log})
	rc, err := river.NewClient(riverpgxv5.New(pool), &river.Config{
		Logger:  log,
		Queues:  map[string]river.QueueConfig{river.QueueDefault: {MaxWorkers: 10}},
		Workers: workers,
	})
	if err != nil {
		return err
	}
	if err := rc.Start(ctx); err != nil {
		return err
	}
	<-ctx.Done()

	stopCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return rc.Stop(stopCtx)
}

func connect(ctx context.Context) (*pgxpool.Pool, error) {
	pool, err := pgxpool.New(ctx, database.DSN())
	if err != nil {
		return nil, err
	}
	if err := migrate(ctx, pool); err != nil {
		pool.Close()
		return nil, err
	}
	return pool, nil
}

// migrate applies River's migrations. The API and the worker both call it on
// startup, so it holds a session-level advisory lock on one connection while
// River migrates on others: River runs each migration in its own transaction
// because some of them can't share one.
func migrate(ctx context.Context, pool *pgxpool.Pool) error {
	migrator, err := rivermigrate.New(riverpgxv5.New(pool), nil)
	if err != nil {
		return err
	}
	conn, err := pool.Acquire(ctx)
	if err != nil {
		return err
	}
	if _, err := conn.Exec(ctx, "SELECT pg_advisory_lock(hashtext('river_migrate'))"); err != nil {
		conn.Release()
		return err
	}
	defer func() {
		if _, err := conn.Exec(context.Background(), "SELECT pg_advisory_unlock(hashtext('river_migrate'))"); err != nil {
			// Closing the session releases the lock.
			conn.Conn().Close(context.Background()) //nolint:errcheck
		}
		conn.Release()
	}()

	_, err = migrator.Migrate(ctx, rivermigrate.DirectionUp, nil)
	return err
}
-- internal/kafka/kafka.go --
// Package kafka produces and consumes Kafka records with franz-go.
package kafka

import (
	"context"
	"log/slog"
	"os"
	"strings"

	"github.com/twmb/franz-go/pkg/kgo"
)

// Brokers returns the seed brokers from KAFKA_BROKERS (comma-separated).
func Brokers() []string {
	return strings.Split(getenv("KAFKA_BROKERS", "localhost:9092"), ",")
}

// Topic is the example topic: KAFKA_TOPIC, default "events".
func Topic() string { return getenv("KAFKA_TOPIC", "events") }

// Client produces records.
type Client struct {
	cl *kgo.Client
}

// New creates a producer. It connects lazily, on the first request.
func New() (*Client, error) {
	cl, err := kgo.NewClient(kgo.SeedBrokers(Brokers()...), kgo.AllowAutoTopicCreation())
	if err != nil {
		return nil, err
	}
	return &Client{cl: cl}, nil
}

// Publish writes one record and waits until the brokers acknowledge it.
func (c *Client) Publish(ctx context.Context, topic string, key, value []byte) error {
	return c.cl.ProduceSync(ctx, &kgo.Record{Topic: topic, Key: key, Value: value}).FirstErr()
}

// Check pings the brokers; the server's /health uses it.
func (c *Client) Check(ctx context.Context) error { return c.cl.Ping(ctx) }

func (c *Client) Close() error {
	c.cl.Close()
	return nil
}

// Consume reads topics as a member of a consumer group and calls handle for
// each record until ctx is done. Offsets are committed automatically after
// records are polled, so a record can be delivered again after a crash.
func Consume(ctx context.Context, log *slog.Logger, group string, topics []string, handle func(context.Context, *kgo.Record) error) error {
	cl, err := kgo.NewClient(
		kgo.SeedBrokers(Brokers()...),
		kgo.ConsumerGroup(group),
		kgo.ConsumeTopics(topics...),
		kgo.AllowAutoTopicCreation(),
	)
	if err != nil {
		return err
	}
	defer cl.Close()

	for {
		fetches := cl.PollFetches(ctx)
		if ctx.Err() != nil || fetches.IsClientClosed() {
			return nil
		}
		fetches.EachError(func(topic string, partition int32, err error) {
			log.Error("fetch", "topic", topic, "partition", partition, "error", err)
		})
		fetches.EachRecord(func(r *kgo.Record) {
			if err := handle(ctx, r); err != nil {
				log.Error("handle record", "topic", r.Topic, "partition", r.Partition, "offset", r.Offset, "error", err)
			}
		})
	}
}

// RunWorker consumes Topic() and logs each record. Replace the handler with
// your own logic. cmd/worker calls it.
func RunWorker(ctx context.Context, log *slog.Logger) error {
	handle := func(ctx context.Context, r *kgo.Record) error {
		log.InfoContext(ctx, "record", "topic", r.Topic, "key", string(r.Key), "value", string(r.Value))
		return nil
	}
	return Consume(ctx, log, getenv("KAFKA_GROUP", "my-api"), []string{Topic()}, handle)
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/logger/handler.go --
package logger

import (
	"io"
	"log/slog"
)

// newHandler uses the standard library's handlers.
func newHandler(w io.Writer, level slog.Level, json bool) slog.Handler {
	opts := &slog.HandlerOptions{Level: level}
	if json {
		return slog.NewJSONHandler(w, opts)
	}
	return slog.NewTextHandler(w, opts)
}
-- internal/logger/logger.go --
// Package logger builds the process-wide *slog.Logger. Everything else logs
// through log/slog, so the backend (slog) only appears in handler.go:
// switching to another one means replacing that file.
package logger

import (
	"fmt"
	"log/slog"
	"os"
	"strings"
)

// New builds the logger from LOG_LEVEL (debug, info, warn or error; default
// info) and LOG_FORMAT (text or json; default text), writing to stderr. It
// also becomes slog's default, so libraries that log through slog or the
// standard log package end up in the same stream.
func New() (*slog.Logger, error) {
	var level slog.Level
	if err := level.UnmarshalText([]byte(getenv("LOG_LEVEL", "info"))); err != nil {
		return nil, fmt.Errorf("LOG_LEVEL: %w", err)
	}
	format := strings.ToLower(getenv("LOG_FORMAT", "text"))
	if format != "text" && format != "json" {
		return nil, fmt.Errorf("LOG_FORMAT: %q is not text or json", format)
	}

	l := slog.New(newHandler(os.Stderr, level, format == "json"))
	slog.SetDefault(l)
	return l, nil
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
