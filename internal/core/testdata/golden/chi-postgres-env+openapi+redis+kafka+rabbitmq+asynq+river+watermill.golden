# step: go mod tidy
# step: git init --quiet
-- .air.toml --
# Live reload for development: run "make watch".
# Reference: https://github.com/air-verse/air/blob/master/air_example.toml
root = "."
tmp_dir = "tmp"

[build]
  cmd = "go build -o ./tmp/main ./cmd/api"
  entrypoint = ["./tmp/main"]
  include_ext = ["go"]
  exclude_dir = ["bin", "tmp", "vendor", "deploy"]
  exclude_regex = ["_test\\.go"]
  delay = 500 # ms
  stop_on_error = true
  send_interrupt = true
  kill_delay = "5s"

[misc]
  clean_on_exit = true
-- .dockerignore --
.git
.env
bin/
tmp/
deploy/
*.test
*.out
-- .env --
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=my_api
DB_USERNAME=app
DB_PASSWORD=secret
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://app:secret@localhost:5672/
-- .gitignore --
# Binaries
/bin/
/tmp/
*.exe
*.test

# Coverage
*.out

# Local environment
.env
-- Dockerfile --
# syntax=docker/dockerfile:1

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ ./cmd/...

# distroless/static has CA certificates and runs as a non-root user.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /api
# The worker ships in the same image; run it with entrypoint ["/worker"].
COPY --from=build /out/worker /worker
EXPOSE 8080
ENTRYPOINT ["/api"]
-- Makefile --
.PHONY: run watch build test tidy clean docker-build up down logs k8s k8s-apply run-worker deps-up

IMAGE := my-api

## Development

run:
	go run ./cmd/api

run-worker:
	go run ./cmd/worker

# Live reload with air; uses an installed air or falls back to go run.
watch:
	@if command -v air > /dev/null 2>&1; then air; else go run github.com/air-verse/air@latest; fi

# Builds every command in cmd/ into bin/.
build:
	go build -o bin/ ./cmd/...

test:
	go test ./...

tidy:
	go mod tidy

clean:
	rm -rf bin tmp

## Docker

docker-build:
	docker build -t $(IMAGE) .

up:
	docker compose up --build -d

down:
	docker compose down

logs:
	docker compose logs -f

## Kubernetes

# Print the manifests Kustomize renders from deploy/k8s.
k8s:
	kubectl kustomize deploy/k8s

k8s-apply:
	kubectl apply -k deploy/k8s

# Start only the services the app needs (db, redis, kafka, rabbitmq), for
# "make run" or "make watch" on the host.
deps-up:
	docker compose up -d --wait db redis kafka rabbitmq
-- README.md --
# my-api

Generated by [krok](https://github.com/DoIttikorn/krok) with **chi** and **postgres**.

Extras: openapi, redis, kafka, rabbitmq, asynq, river, watermill.

## Run

On your machine, with live reload:

```bash
make deps-up     # start db, redis, kafka, rabbitmq in Docker
make watch       # API with live reload, or: make run
make run-worker  # background consumers, in another terminal
```

Everything in Docker:

```bash
make up      # docker compose up --build -d
make logs
make down
```

Then try the API:

```bash
curl -i -X POST localhost:8080/api/v1/items -d '{"name":"first"}'
curl localhost:8080/api/v1/items
curl localhost:8080/readyz
```

API docs: http://localhost:8080/docs (spec at `/openapi.json`).

## Endpoints

| Method | Path | Description |
| --- | --- | --- |
| `GET` | `/api/v1/items` | List items |
| `POST` | `/api/v1/items` | Create an item: `{"name": "..."}` → `201` with `Location` |
| `GET` | `/api/v1/items/{id}` | Get an item |
| `PUT` | `/api/v1/items/{id}` | Replace an item |
| `DELETE` | `/api/v1/items/{id}` | Delete an item → `204` |
| `GET` | `/livez` | Liveness probe: the process is up. Ignores dependencies |
| `GET` | `/readyz` | Readiness probe: every dependency is up and the server isn't shutting down |
| `GET` | `/health` | Status of each dependency, for people and monitoring |
| `GET` | `/docs`, `/openapi.json` | API docs and OpenAPI 3.1 spec (Huma) |

Errors use [RFC 9457](https://www.rfc-editor.org/rfc/rfc9457) problem details
(`application/problem+json`): `400` for malformed JSON, `404` for unknown IDs,
`422` for invalid input.

`items` is an example resource kept **in memory** (`internal/items`): each
replica has its own copy. Implement `items.Store` with your database before
running more than one replica, then use it as a template for your own
resources. Routes are registered with [Huma](https://huma.rocks)
in `internal/server/openapi.go`; Huma validates requests against the Go types
and generates the spec from them.

## Make targets

| Target | Description |
| --- | --- |
| `make run` | Run the API |
| `make watch` | Run with live reload ([air](https://github.com/air-verse/air), config in `.air.toml`) |
| `make run-worker` | Run the background worker (`cmd/worker`) |
| `make build` | Build every command into `bin/` |
| `make test` | Run tests |
| `make tidy` | Tidy `go.mod` |
| `make clean` | Remove build output |
| `make docker-build` | Build the Docker image `my-api` |
| `make up` / `make down` | Start / stop everything with Docker Compose |
| `make logs` | Follow Docker Compose logs |
| `make deps-up` | Start only db, redis, kafka, rabbitmq in Docker |
| `make k8s` | Print the Kubernetes manifests (`kubectl kustomize deploy/k8s`) |
| `make k8s-apply` | Apply them to the current cluster |

## API and worker

The API (`cmd/api`) only publishes messages and enqueues work; the worker
(`cmd/worker`) consumes it. Both ship in the same Docker image: the default
entrypoint is `/api`, and the worker runs with entrypoint `/worker`. Deploy
them as separate Deployments so each scales on its own.

| Feature | Publish / enqueue (API) | Consume (worker) |
| --- | --- | --- |
| Kafka | `kafka.Client.Publish` | `kafka.RunWorker`, topic `KAFKA_TOPIC` (default `events`) |
| RabbitMQ | `rabbitmq.Client.Publish` | `rabbitmq.RunWorker`, queue `RABBITMQ_QUEUE` (default `events`) |
| Asynq | `tasks.Client.Enqueue(tasks.NewExampleTask(...))` | `tasks.RunWorker`, register handlers there |
| River | `jobs.Client.Insert(ctx, jobs.ExampleArgs{...}, nil)` | `jobs.RunWorker`, register workers there |
| Watermill (kafka) | `events.Publish` | `events.RunWorker`, add handlers to the router |

## Configuration

Settings are read from environment variables; `.env` is loaded at startup (`internal/config`).

| Variable | Default |
| --- | --- |
| `PORT` | `8080` |
| `DB_HOST` | `localhost` |
| `DB_PORT` | `5432` |
| `DB_DATABASE` | `my_api` |
| `DB_USERNAME` | `app` |
| `DB_PASSWORD` | `secret` |
| `REDIS_ADDR` | `localhost:6379` |
| `REDIS_PASSWORD` | _(empty)_ |
| `REDIS_DB` | `0` |
| `KAFKA_BROKERS` | `localhost:9092` |
| `KAFKA_TOPIC` / `KAFKA_GROUP` | `events` / `my-api` |
| `RABBITMQ_URL` | `amqp://app:secret@localhost:5672/` |
| `RABBITMQ_QUEUE` | `events` |

## Kubernetes and high availability

`deploy/k8s` is a Kustomize base. Set the image in `kustomization.yaml`,
the host in `ingress.yaml`, then run
`make k8s-apply`. Settings come from an optional Secret:
`kubectl create secret generic my-api-env --from-env-file=.env`.

What keeps the API available:

- **At least two replicas** (HorizontalPodAutoscaler, 2 to 10 on CPU),
  spread across nodes and zones.
- **Probes**: liveness (`/livez`) restarts a stuck process but ignores
  dependencies, so a database outage doesn't restart every pod; readiness
  (`/readyz`) takes a pod out of the Service while a dependency is down.
- **Zero-downtime rollouts**: `maxUnavailable: 0`, and on SIGTERM the server
  fails `/readyz`, waits `SHUTDOWN_DELAY` (5s in the manifest, 0 locally) for
  ingress-nginx to stop routing to it, then drains in-flight requests.
- **PodDisruptionBudget**: node drains evict one pod at a time.
- **Worker**: its own Deployment (2 replicas) with probes on port 8081
  (`HEALTH_PORT`).
-- cmd/api/main.go --
package main

import (
	"context"
	"errors"
	"log"
	"net/http"
	"os/signal"
	"syscall"
	"time"

	"github.com/example/my-api/internal/config"
	"github.com/example/my-api/internal/server"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	if err := config.Load(ctx); err != nil {
		log.Fatalf("load config: %v", err)
	}

	srv, err := server.New(ctx)
	if err != nil {
		log.Fatalf("create server: %v", err)
	}
	defer srv.Close()

	errCh := make(chan error, 1)
	go func() {
		log.Printf("listening on %s", srv.Addr())
		errCh <- srv.ListenAndServe()
	}()

	select {
	case err := <-errCh:
		if !errors.Is(err, http.ErrServerClosed) {
			log.Printf("server error: %v", err)
		}
		return
	case <-ctx.Done():
	}

	// Keep this below the pod's terminationGracePeriodSeconds (30s).
	log.Println("shutting down")
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
	defer cancel()
	if err := srv.Shutdown(shutdownCtx); err != nil {
		log.Printf("shutdown: %v", err)
	}
}
-- cmd/worker/main.go --
// Command worker runs the background consumers. Deploy it separately from
// the API so each can scale on its own.
package main

import (
	"context"
	"errors"
	"fmt"
	"log"
	"net/http"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

	"github.com/example/my-api/internal/config"
	"github.com/example/my-api/internal/events"
	"github.com/example/my-api/internal/jobs"
	"github.com/example/my-api/internal/kafka"
	"github.com/example/my-api/internal/rabbitmq"
	"github.com/example/my-api/internal/tasks"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	if err := config.Load(ctx); err != nil {
		log.Fatalf("load config: %v", err)
	}

	probes := probeServer()
	go func() {
		if err := probes.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			log.Printf("probe server: %v", err)
		}
	}()
	defer probes.Close()

	err := run(ctx, map[string]func(context.Context) error{
		"kafka":     kafka.RunWorker,
		"rabbitmq":  rabbitmq.RunWorker,
		"asynq":     tasks.RunWorker,
		"river":     jobs.RunWorker,
		"watermill": events.RunWorker,
	})
	if err != nil {
		log.Fatalf("worker: %v", err)
	}
	log.Println("worker stopped")
}

// probeServer serves /livez and /readyz on HEALTH_PORT (default 8081) for
// Kubernetes. The worker takes no traffic, so both only report that the
// process is up; if a consumer fails, run returns and the process exits, and
// Kubernetes restarts the pod.
func probeServer() *http.Server {
	ok := func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		fmt.Fprintln(w, `{"status":"up"}`)
	}
	mux := http.NewServeMux()
	mux.HandleFunc("GET /livez", ok)
	mux.HandleFunc("GET /readyz", ok)
	port := os.Getenv("HEALTH_PORT")
	if port == "" {
		port = "8081"
	}
	return &http.Server{Addr: ":" + port, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
}

// run starts every worker and waits for all of them. When one fails, the
// others are stopped and its error is returned.
func run(ctx context.Context, workers map[string]func(context.Context) error) error {
	ctx, cancel := context.WithCancel(ctx)
	defer cancel()

	errs := make(chan error, len(workers))
	var wg sync.WaitGroup
	for name, work := range workers {
		wg.Add(1)
		go func() {
			defer wg.Done()
			log.Printf("%s: started", name)
			if err := work(ctx); err != nil {
				errs <- fmt.Errorf("%s: %w", name, err)
				cancel()
			}
		}()
	}
	wg.Wait()
	close(errs)
	return <-errs // the first error, or nil
}
-- deploy/k8s/deployment.yaml --
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  # No replicas field: the HorizontalPodAutoscaler owns it (minimum 2).
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0 # keep full capacity during a rollout
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: api
  template:
    metadata:
      labels:
        app.kubernetes.io/name: my-api
        app.kubernetes.io/component: api
    spec:
      terminationGracePeriodSeconds: 30
      # Spread replicas across nodes and zones so one failure can't take
      # them all down.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: api
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: api
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532 # the distroless "nonroot" user
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: api
          image: my-api
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: PORT
              value: "8080"
            # On SIGTERM, fail /readyz and wait this long before closing the
            # listener, so ingress-nginx stops sending requests first.
            - name: SHUTDOWN_DELAY
              value: 5s
          # Settings from a Secret, if present:
          #   kubectl create secret generic my-api-env --from-env-file=.env
          envFrom:
            - secretRef:
                name: my-api-env
                optional: true
          # Gives a slow start up to 60s before liveness checks begin.
          startupProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 2
            failureThreshold: 30
          # Restarts the container only if the process stops answering.
          livenessProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          # Takes the pod out of the Service while a dependency is down or
          # while it shuts down.
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 2
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
-- deploy/k8s/hpa.yaml --
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: my-api
  minReplicas: 2 # at least two, so one can restart without downtime
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
-- deploy/k8s/ingress.yaml --
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  ingressClassName: nginx
  rules:
    - host: my-api.example.com # TODO: your host
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: my-api
                port:
                  name: http
-- deploy/k8s/kustomization.yaml --
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# namespace: my-api

labels:
  - pairs:
      app.kubernetes.io/part-of: my-api

resources:
  - deployment.yaml
  - service.yaml
  - ingress.yaml
  - pdb.yaml
  - hpa.yaml
  - worker-deployment.yaml
  - worker-pdb.yaml

# Point this at your registry, or run:
#   kustomize edit set image my-api=registry.example.com/my-api:v1.0.0
images:
  - name: my-api
    newName: registry.example.com/my-api
    newTag: latest
-- deploy/k8s/pdb.yaml --
# Node drains and cluster upgrades evict at most one API pod at a time.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: api
-- deploy/k8s/service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: my-api
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
spec:
  selector:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: api
  ports:
    - name: http
      port: 80
      targetPort: http
-- deploy/k8s/worker-deployment.yaml --
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-api-worker
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: worker
spec:
  replicas: 2
  revisionHistoryLimit: 5
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: my-api
        app.kubernetes.io/component: worker
    spec:
      terminationGracePeriodSeconds: 30
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: my-api
              app.kubernetes.io/component: worker
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: worker
          image: my-api
          command: ["/worker"]
          ports:
            - name: health
              containerPort: 8081
          envFrom:
            - secretRef:
                name: my-api-env
                optional: true
          livenessProbe:
            httpGet:
              path: /livez
              port: health
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            periodSeconds: 10
            timeoutSeconds: 2
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
-- deploy/k8s/worker-pdb.yaml --
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: my-api-worker
  labels:
    app.kubernetes.io/name: my-api
    app.kubernetes.io/component: worker
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: my-api
      app.kubernetes.io/component: worker
-- docker-compose.yml --
# Settings shared by the app and the worker.
x-app-env: &app-env
  PORT: "8080"
  DB_HOST: db
  DB_PORT: "5432"
  DB_DATABASE: ${DB_DATABASE:-my_api}
  DB_USERNAME: ${DB_USERNAME:-app}
  DB_PASSWORD: ${DB_PASSWORD:-secret}
  REDIS_ADDR: redis:6379
  KAFKA_BROKERS: kafka:29092
  RABBITMQ_URL: amqp://app:secret@rabbitmq:5672/

x-app-depends: &app-depends
  db:
    condition: service_healthy
  redis:
    condition: service_healthy
  kafka:
    condition: service_healthy
  rabbitmq:
    condition: service_healthy

services:
  app:
    build: .
    restart: unless-stopped
    ports:
      - "${PORT:-8080}:8080"
    environment: *app-env
    depends_on: *app-depends

  worker:
    build: .
    entrypoint: ["/worker"]
    restart: unless-stopped
    environment: *app-env
    depends_on: *app-depends

  db:
    image: postgres:17-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USERNAME:-app}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-secret}
      POSTGRES_DB: ${DB_DATABASE:-my_api}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:8-alpine
    restart: unless-stopped
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10

  # Single-node Kafka in KRaft mode. Containers use kafka:29092, the host
  # uses localhost:9092.
  kafka:
    image: apache/kafka:4.3.1
    restart: unless-stopped
    ports:
      - "9092:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:29092,CONTROLLER://:29093,PLAINTEXT_HOST://:9092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:29093
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:29092 > /dev/null 2>&1"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 15s

  rabbitmq:
    image: rabbitmq:4-management-alpine
    restart: unless-stopped
    environment:
      RABBITMQ_DEFAULT_USER: app
      RABBITMQ_DEFAULT_PASS: secret
    ports:
      - "5672:5672"
      - "15672:15672" # management UI: http://localhost:15672
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 10s
      retries: 10

volumes:
  db_data:
-- go.mod --
module github.com/example/my-api

go 1.24
-- internal/config/config.go --
// Package config loads settings into the process environment before the
// rest of the app reads them with os.Getenv.
package config

import (
	"context"
	"errors"
	"io/fs"

	"github.com/joho/godotenv"
)

// Load reads .env into the environment if the file exists. Variables that
// are already set in the real environment are not overwritten.
func Load(ctx context.Context) error {
	if err := godotenv.Load(); err != nil && !errors.Is(err, fs.ErrNotExist) {
		return err
	}
	return nil
}
-- internal/database/database.go --
package database

import (
	"context"
	"database/sql"
	"net"
	"net/url"
	"os"
	"time"

	_ "github.com/jackc/pgx/v5/stdlib"
)

// Service is the database dependency the server uses.
type Service interface {
	// Check pings the database; the server's /health uses it.
	Check(ctx context.Context) error
	// SQL returns the underlying connection pool for queries.
	SQL() *sql.DB
	Close() error
}

type service struct {
	db *sql.DB
}

// New opens a PostgreSQL connection pool configured from environment
// variables. It does not wait for the database to be reachable.
func New() (Service, error) {
	db, err := sql.Open("pgx", DSN())
	if err != nil {
		return nil, err
	}
	db.SetMaxOpenConns(25)
	db.SetMaxIdleConns(25)
	db.SetConnMaxIdleTime(5 * time.Minute)
	return &service{db: db}, nil
}

func (s *service) Check(ctx context.Context) error { return s.db.PingContext(ctx) }

// DSN returns the PostgreSQL connection URL built from the DB_* settings.
func DSN() string {
	u := url.URL{
		Scheme:   "postgres",
		User:     url.UserPassword(getenv("DB_USERNAME", "app"), getenv("DB_PASSWORD", "secret")),
		Host:     net.JoinHostPort(getenv("DB_HOST", "localhost"), getenv("DB_PORT", "5432")),
		Path:     getenv("DB_DATABASE", "my_api"),
		RawQuery: "sslmode=" + getenv("DB_SSLMODE", "disable"),
	}
	return u.String()
}

func (s *service) SQL() *sql.DB { return s.db }

func (s *service) Close() error { return s.db.Close() }

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/events/events.go --
// Package events publishes and subscribes to messages with Watermill, using
// Kafka as the broker. To switch brokers, change NewPublisher and
// newSubscriber; handlers stay the same.
package events

import (
	"context"
	"log"
	"log/slog"

	"github.com/ThreeDotsLabs/watermill"
	wmkafka "github.com/ThreeDotsLabs/watermill-kafka/v3/pkg/kafka"
	"github.com/ThreeDotsLabs/watermill/message"

	"github.com/example/my-api/internal/kafka"
)

// Topic is the example topic RunWorker subscribes to.
const Topic = "example.events"

// Publisher publishes messages, e.g. via Publish.
type Publisher = message.Publisher

var logger = watermill.NewSlogLogger(slog.Default())

// Publish sends payload to topic.
func Publish(ctx context.Context, pub Publisher, topic string, payload []byte) error {
	msg := message.NewMessage(watermill.NewUUID(), payload)
	msg.SetContext(ctx)
	return pub.Publish(topic, msg)
}

// NewPublisher connects a publisher to the broker.
func NewPublisher() (Publisher, error) {
	return wmkafka.NewPublisher(wmkafka.PublisherConfig{
		Brokers:   kafka.Brokers(),
		Marshaler: wmkafka.DefaultMarshaler{},
	}, logger)
}

func newSubscriber() (message.Subscriber, error) {
	return wmkafka.NewSubscriber(wmkafka.SubscriberConfig{
		Brokers:               kafka.Brokers(),
		Unmarshaler:           wmkafka.DefaultMarshaler{},
		ConsumerGroup:         "my-api-watermill",
		OverwriteSaramaConfig: wmkafka.DefaultSaramaSubscriberConfig(),
	}, logger)
}

// RunWorker handles messages until ctx is done. Add handlers to the router
// here. cmd/worker calls it.
func RunWorker(ctx context.Context) error {
	sub, err := newSubscriber()
	if err != nil {
		return err
	}
	defer sub.Close()

	router, err := message.NewRouter(message.RouterConfig{}, logger)
	if err != nil {
		return err
	}
	router.AddConsumerHandler("example", Topic, sub, handleExample)
	return router.Run(ctx)
}

func handleExample(msg *message.Message) error {
	log.Printf("watermill: %s: %s", msg.UUID, msg.Payload)
	return nil
}
-- internal/items/items.go --
// Package items is an example REST resource: the model, the Store interface
// the handlers depend on, and an in-memory Store. Replace MemoryStore with a
// database-backed Store; the handlers don't change.
package items

import (
	"cmp"
	"context"
	"crypto/rand"
	"errors"
	"fmt"
	"slices"
	"strings"
	"sync"
	"time"
)

var (
	// ErrNotFound is returned when no item has the requested ID.
	ErrNotFound = errors.New("item not found")
	// ErrInvalid wraps validation errors in the input.
	ErrInvalid = errors.New("invalid item")
)

// Item is the resource returned by the API.
type Item struct {
	ID        string    `json:"id" doc:"Unique identifier"`
	Name      string    `json:"name" doc:"Display name"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// Input is the request body to create or replace an item.
type Input struct {
	Name string `json:"name" minLength:"1" maxLength:"200" doc:"Display name"`
}

// Validate reports whether in can be stored.
func (in Input) Validate() error {
	name := strings.TrimSpace(in.Name)
	switch {
	case name == "":
		return fmt.Errorf("%w: name is required", ErrInvalid)
	case len(name) > 200:
		return fmt.Errorf("%w: name must be at most 200 characters", ErrInvalid)
	}
	return nil
}

// Store persists items.
type Store interface {
	List(ctx context.Context) ([]Item, error)
	Get(ctx context.Context, id string) (Item, error)
	Create(ctx context.Context, in Input) (Item, error)
	Update(ctx context.Context, id string, in Input) (Item, error)
	Delete(ctx context.Context, id string) error
}

// MemoryStore keeps items in memory. Each replica has its own copy and
// everything is lost on restart, so it is only for trying the API out.
type MemoryStore struct {
	mu    sync.RWMutex
	items map[string]Item
}

func NewMemoryStore() *MemoryStore {
	return &MemoryStore{items: map[string]Item{}}
}

// List returns every item, oldest first.
func (s *MemoryStore) List(ctx context.Context) ([]Item, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	out := make([]Item, 0, len(s.items))
	for _, it := range s.items {
		out = append(out, it)
	}
	slices.SortFunc(out, func(a, b Item) int {
		return cmp.Or(a.CreatedAt.Compare(b.CreatedAt), strings.Compare(a.ID, b.ID))
	})
	return out, nil
}

func (s *MemoryStore) Get(ctx context.Context, id string) (Item, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	it, ok := s.items[id]
	if !ok {
		return Item{}, fmt.Errorf("%w: %s", ErrNotFound, id)
	}
	return it, nil
}

func (s *MemoryStore) Create(ctx context.Context, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	now := time.Now().UTC()
	it := Item{ID: rand.Text(), Name: strings.TrimSpace(in.Name), CreatedAt: now, UpdatedAt: now}

	s.mu.Lock()
	defer s.mu.Unlock()
	s.items[it.ID] = it
	return it, nil
}

func (s *MemoryStore) Update(ctx context.Context, id string, in Input) (Item, error) {
	if err := in.Validate(); err != nil {
		return Item{}, err
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	it, ok := s.items[id]
	if !ok {
		return Item{}, fmt.Errorf("%w: %s", ErrNotFound, id)
	}
	it.Name = strings.TrimSpace(in.Name)
	it.UpdatedAt = time.Now().UTC()
	s.items[id] = it
	return it, nil
}

func (s *MemoryStore) Delete(ctx context.Context, id string) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, ok := s.items[id]; !ok {
		return fmt.Errorf("%w: %s", ErrNotFound, id)
	}
	delete(s.items, id)
	return nil
}
-- internal/items/items_test.go --
package items

import (
	"context"
	"errors"
	"testing"
)

func TestMemoryStore(t *testing.T) {
	ctx := context.Background()
	s := NewMemoryStore()

	created, err := s.Create(ctx, Input{Name: "  first  "})
	if err != nil {
		t.Fatal(err)
	}
	if created.ID == "" || created.Name != "first" {
		t.Fatalf("Create = %+v, want an ID and a trimmed name", created)
	}

	updated, err := s.Update(ctx, created.ID, Input{Name: "renamed"})
	if err != nil {
		t.Fatal(err)
	}
	if updated.Name != "renamed" || !updated.CreatedAt.Equal(created.CreatedAt) {
		t.Errorf("Update = %+v, want new name and unchanged CreatedAt", updated)
	}

	list, err := s.List(ctx)
	if err != nil || len(list) != 1 {
		t.Fatalf("List = %v, %v; want one item", list, err)
	}

	if err := s.Delete(ctx, created.ID); err != nil {
		t.Fatal(err)
	}
	if _, err := s.Get(ctx, created.ID); !errors.Is(err, ErrNotFound) {
		t.Errorf("Get after Delete: err = %v, want ErrNotFound", err)
	}
}

func TestMemoryStoreErrors(t *testing.T) {
	ctx := context.Background()
	s := NewMemoryStore()

	if _, err := s.Create(ctx, Input{Name: "   "}); !errors.Is(err, ErrInvalid) {
		t.Errorf("Create blank name: err = %v, want ErrInvalid", err)
	}
	if _, err := s.Update(ctx, "missing", Input{Name: "x"}); !errors.Is(err, ErrNotFound) {
		t.Errorf("Update missing: err = %v, want ErrNotFound", err)
	}
	if err := s.Delete(ctx, "missing"); !errors.Is(err, ErrNotFound) {
		t.Errorf("Delete missing: err = %v, want ErrNotFound", err)
	}
}
-- internal/jobs/jobs.go --
// Package jobs runs background jobs with River, stored in PostgreSQL.
package jobs

import (
	"context"
	"log"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/riverqueue/river"
	"github.com/riverqueue/river/riverdriver/riverpgxv5"
	"github.com/riverqueue/river/rivermigrate"

	"github.com/example/my-api/internal/database"
)

// ExampleArgs is an example job. Each job type is an args struct with a
// Kind and a worker registered in RunWorker.
type ExampleArgs struct {
	Message string `json:"message"`
}

func (ExampleArgs) Kind() string { return "example" }

// ExampleWorker works ExampleArgs jobs.
type ExampleWorker struct {
	river.WorkerDefaults[ExampleArgs]
}

func (w *ExampleWorker) Work(ctx context.Context, job *river.Job[ExampleArgs]) error {
	log.Printf("river: job %d: %s", job.ID, job.Args.Message)
	return nil
}

// Client inserts jobs, e.g. c.Insert(ctx, jobs.ExampleArgs{Message: "hi"}, nil).
// It does not work them; cmd/worker does.
type Client struct {
	*river.Client[pgx.Tx]
	pool *pgxpool.Pool
}

// New connects to PostgreSQL with the DB_* settings, applies River's
// migrations and returns an insert-only client.
func New(ctx context.Context) (*Client, error) {
	pool, err := connect(ctx)
	if err != nil {
		return nil, err
	}
	rc, err := river.NewClient(riverpgxv5.New(pool), &river.Config{})
	if err != nil {
		pool.Close()
		return nil, err
	}
	return &Client{Client: rc, pool: pool}, nil
}

func (c *Client) Close() error {
	c.pool.Close()
	return nil
}

// RunWorker works jobs until ctx is done. cmd/worker calls it.
func RunWorker(ctx context.Context) error {
	pool, err := connect(ctx)
	if err != nil {
		return err
	}
	defer pool.Close()

	workers := river.NewWorkers()
	river.AddWorker(workers, &ExampleWorker{})
	rc, err := river.NewClient(riverpgxv5.New(pool), &river.Config{
		Queues:  map[string]river.QueueConfig{river.QueueDefault: {MaxWorkers: 10}},
		Workers: workers,
	})
	if err != nil {
		return err
	}
	if err := rc.Start(ctx); err != nil {
		return err
	}
	<-ctx.Done()

	stopCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return rc.Stop(stopCtx)
}

func connect(ctx context.Context) (*pgxpool.Pool, error) {
	pool, err := pgxpool.New(ctx, database.DSN())
	if err != nil {
		return nil, err
	}
	if err := migrate(ctx, pool); err != nil {
		pool.Close()
		return nil, err
	}
	return pool, nil
}

// migrate applies River's migrations. The API and the worker both call it on
// startup, so it holds a session-level advisory lock on one connection while
// River migrates on others: River runs each migration in its own transaction
// because some of them can't share one.
func migrate(ctx context.Context, pool *pgxpool.Pool) error {
	migrator, err := rivermigrate.New(riverpgxv5.New(pool), nil)
	if err != nil {
		return err
	}
	conn, err := pool.Acquire(ctx)
	if err != nil {
		return err
	}
	if _, err := conn.Exec(ctx, "SELECT pg_advisory_lock(hashtext('river_migrate'))"); err != nil {
		conn.Release()
		return err
	}
	defer func() {
		if _, err := conn.Exec(context.Background(), "SELECT pg_advisory_unlock(hashtext('river_migrate'))"); err != nil {
			// Closing the session releases the lock.
			conn.Conn().Close(context.Background()) //nolint:errcheck
		}
		conn.Release()
	}()

	_, err = migrator.Migrate(ctx, rivermigrate.DirectionUp, nil)
	return err
}
-- internal/kafka/kafka.go --
// Package kafka produces and consumes Kafka records with franz-go.
package kafka

import (
	"context"
	"log"
	"os"
	"strings"

	"github.com/twmb/franz-go/pkg/kgo"
)

// Brokers returns the seed brokers from KAFKA_BROKERS (comma-separated).
func Brokers() []string {
	return strings.Split(getenv("KAFKA_BROKERS", "localhost:9092"), ",")
}

// Topic is the example topic: KAFKA_TOPIC, default "events".
func Topic() string { return getenv("KAFKA_TOPIC", "events") }

// Client produces records.
type Client struct {
	cl *kgo.Client
}

// New creates a producer. It connects lazily, on the first request.
func New() (*Client, error) {
	cl, err := kgo.NewClient(kgo.SeedBrokers(Brokers()...), kgo.AllowAutoTopicCreation())
	if err != nil {
		return nil, err
	}
	return &Client{cl: cl}, nil
}

// Publish writes one record and waits until the brokers acknowledge it.
func (c *Client) Publish(ctx context.Context, topic string, key, value []byte) error {
	return c.cl.ProduceSync(ctx, &kgo.Record{Topic: topic, Key: key, Value: value}).FirstErr()
}

// Check pings the brokers; the server's /health uses it.
func (c *Client) Check(ctx context.Context) error { return c.cl.Ping(ctx) }

func (c *Client) Close() error {
	c.cl.Close()
	return nil
}

// Consume reads topics as a member of a consumer group and calls handle for
// each record until ctx is done. Offsets are committed automatically after
// records are polled, so a record can be delivered again after a crash.
func Consume(ctx context.Context, group string, topics []string, handle func(context.Context, *kgo.Record) error) error {
	cl, err := kgo.NewClient(
		kgo.SeedBrokers(Brokers()...),
		kgo.ConsumerGroup(group),
		kgo.ConsumeTopics(topics...),
		kgo.AllowAutoTopicCreation(),
	)
	if err != nil {
		return err
	}
	defer cl.Close()

	for {
		fetches := cl.PollFetches(ctx)
		if ctx.Err() != nil || fetches.IsClientClosed() {
			return nil
		}
		fetches.EachError(func(topic string, partition int32, err error) {
			log.Printf("kafka: fetch %s[%d]: %v", topic, partition, err)
		})
		fetches.EachRecord(func(r *kgo.Record) {
			if err := handle(ctx, r); err != nil {
				log.Printf("kafka: handle %s[%d]@%d: %v", r.Topic, r.Partition, r.Offset, err)
			}
		})
	}
}

// RunWorker consumes Topic() and logs each record. Replace handleEvent with
// your own logic. cmd/worker calls it.
func RunWorker(ctx context.Context) error {
	return Consume(ctx, getenv("KAFKA_GROUP", "my-api"), []string{Topic()}, handleEvent)
}

func handleEvent(ctx context.Context, r *kgo.Record) error {
	log.Printf("kafka: %s key=%s value=%s", r.Topic, r.Key, r.Value)
	return nil
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/rabbitmq/rabbitmq.go --
// Package rabbitmq publishes and consumes RabbitMQ messages with amqp091-go.
package rabbitmq

import (
	"context"
	"errors"
	"log"
	"os"
	"sync"

	amqp "github.com/rabbitmq/amqp091-go"
)

// URL returns RABBITMQ_URL, e.g. amqp://user:pass@host:5672/.
func URL() string { return getenv("RABBITMQ_URL", "amqp://app:secret@localhost:5672/") }

// Queue is the example queue: RABBITMQ_QUEUE, default "events".
func Queue() string { return getenv("RABBITMQ_QUEUE", "events") }

// Client publishes messages over one connection and channel.
type Client struct {
	conn *amqp.Connection
	mu   sync.Mutex // amqp channels are not safe for concurrent use
	ch   *amqp.Channel
}

// New connects to RabbitMQ. Unlike the other clients it dials right away,
// so the app fails fast if RabbitMQ is unreachable. It does not reconnect;
// if the connection drops, /health reports it and your orchestrator should
// restart the pod.
func New() (*Client, error) {
	conn, err := amqp.Dial(URL())
	if err != nil {
		return nil, err
	}
	ch, err := conn.Channel()
	if err != nil {
		conn.Close()
		return nil, err
	}
	return &Client{conn: conn, ch: ch}, nil
}

// Publish sends a persistent message to queue, declaring it as durable first.
func (c *Client) Publish(ctx context.Context, queue string, body []byte) error {
	c.mu.Lock()
	defer c.mu.Unlock()
	if _, err := c.ch.QueueDeclare(queue, true, false, false, false, nil); err != nil {
		return err
	}
	return c.ch.PublishWithContext(ctx, "", queue, false, false, amqp.Publishing{
		ContentType:  "application/json",
		DeliveryMode: amqp.Persistent,
		Body:         body,
	})
}

// Check reports whether the connection is still open; /health uses it.
func (c *Client) Check(context.Context) error {
	if c.conn.IsClosed() {
		return errors.New("connection closed")
	}
	return nil
}

func (c *Client) Close() error { return c.conn.Close() }

// RunWorker consumes Queue() and logs each message until ctx is done. Replace
// handleMessage with your own logic. cmd/worker calls it.
func RunWorker(ctx context.Context) error {
	conn, err := amqp.Dial(URL())
	if err != nil {
		return err
	}
	defer conn.Close()
	ch, err := conn.Channel()
	if err != nil {
		return err
	}
	if _, err := ch.QueueDeclare(Queue(), true, false, false, false, nil); err != nil {
		return err
	}
	if err := ch.Qos(10, 0, false); err != nil {
		return err
	}
	deliveries, err := ch.Consume(Queue(), "", false, false, false, false, nil)
	if err != nil {
		return err
	}

	for {
		select {
		case <-ctx.Done():
			return nil
		case d, ok := <-deliveries:
			if !ok {
				return errors.New("rabbitmq: delivery channel closed")
			}
			if err := handleMessage(ctx, d); err != nil {
				log.Printf("rabbitmq: handle message: %v", err)
				// Not requeued, to avoid redelivering a failing message
				// forever. Configure a dead-letter exchange to keep it.
				_ = d.Nack(false, false)
				continue
			}
			_ = d.Ack(false)
		}
	}
}

func handleMessage(ctx context.Context, d amqp.Delivery) error {
	log.Printf("rabbitmq: %s", d.Body)
	return nil
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/redis/redis.go --
// Package redis connects to Redis with go-redis.
package redis

import (
	"fmt"
	"os"
	"strconv"

	goredis "github.com/redis/go-redis/v9"
)

// Client is the go-redis client, so callers don't need to import go-redis.
type Client = goredis.Client

// New creates a client from REDIS_ADDR, REDIS_PASSWORD and REDIS_DB. It
// connects lazily, on the first command.
func New() (*Client, error) {
	db, err := strconv.Atoi(getenv("REDIS_DB", "0"))
	if err != nil {
		return nil, fmt.Errorf("REDIS_DB: %w", err)
	}
	return goredis.NewClient(&goredis.Options{
		Addr:     getenv("REDIS_ADDR", "localhost:6379"),
		Password: os.Getenv("REDIS_PASSWORD"),
		DB:       db,
	}), nil
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/server/health.go --
package server

import (
	"context"
	"encoding/json"
	"log"
	"net/http"
	"time"
)

// livez is the liveness probe. It only reports that the process can serve
// HTTP and deliberately ignores dependencies: if it failed during a database
// outage, Kubernetes would restart every pod at once and make things worse.
func (s *Server) livez(w http.ResponseWriter, r *http.Request) {
	writeJSON(w, http.StatusOK, map[string]string{"status": "up"})
}

// readyz is the readiness probe. It fails while the server is shutting down
// or a dependency is down, so Kubernetes stops routing traffic to this pod
// without restarting it.
func (s *Server) readyz(w http.ResponseWriter, r *http.Request) {
	if s.draining.Load() {
		writeJSON(w, http.StatusServiceUnavailable, map[string]string{"status": "shutting down"})
		return
	}
	code, res := s.health(r.Context())
	writeJSON(w, code, res)
}

// healthz reports each dependency, for people and monitoring.
func (s *Server) healthz(w http.ResponseWriter, r *http.Request) {
	code, res := s.health(r.Context())
	writeJSON(w, code, res)
}

// health runs every check and reports each one as "up" or "down", plus the
// HTTP code to answer with.
func (s *Server) health(ctx context.Context) (int, map[string]string) {
	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
	defer cancel()

	code, res := http.StatusOK, map[string]string{"status": "up"}
	for name, check := range s.checks {
		if err := check(ctx); err != nil {
			log.Printf("health check %s: %v", name, err)
			res[name] = "down"
			res["status"] = "down"
			code = http.StatusServiceUnavailable
			continue
		}
		res[name] = "up"
	}
	return code, res
}

func writeJSON(w http.ResponseWriter, code int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(code)
	if err := json.NewEncoder(w).Encode(v); err != nil {
		log.Printf("write response: %v", err)
	}
}
-- internal/server/health_test.go --
package server

import (
	"context"
	"errors"
	"net/http"
	"testing"
)

func TestProbes(t *testing.T) {
	s := newTestServer()
	h := s.Handler()
	for _, path := range []string{"/livez", "/readyz", "/health"} {
		if rec := do(t, h, http.MethodGet, path, "", nil); rec.Code != http.StatusOK {
			t.Errorf("GET %s = %d, want %d", path, rec.Code, http.StatusOK)
		}
	}
}

func TestReadyzFailsWhenDependencyIsDown(t *testing.T) {
	s := newTestServer()
	s.checks = map[string]func(context.Context) error{
		"database": func(context.Context) error { return errors.New("connection refused") },
	}
	h := s.Handler()

	var body map[string]string
	if rec := do(t, h, http.MethodGet, "/readyz", "", &body); rec.Code != http.StatusServiceUnavailable {
		t.Errorf("GET /readyz = %d, want %d", rec.Code, http.StatusServiceUnavailable)
	}
	if body["database"] != "down" {
		t.Errorf("body = %v, want database down", body)
	}
	// Liveness ignores dependencies, so the pod is not restarted.
	if rec := do(t, h, http.MethodGet, "/livez", "", nil); rec.Code != http.StatusOK {
		t.Errorf("GET /livez = %d, want %d", rec.Code, http.StatusOK)
	}
}

func TestReadyzFailsWhileDraining(t *testing.T) {
	s := newTestServer()
	s.draining.Store(true)
	h := s.Handler()

	if rec := do(t, h, http.MethodGet, "/readyz", "", nil); rec.Code != http.StatusServiceUnavailable {
		t.Errorf("GET /readyz = %d, want %d", rec.Code, http.StatusServiceUnavailable)
	}
	if rec := do(t, h, http.MethodGet, "/livez", "", nil); rec.Code != http.StatusOK {
		t.Errorf("GET /livez = %d, want %d", rec.Code, http.StatusOK)
	}
}
-- internal/server/items_test.go --
package server

import (
	"net/http"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
)

// TestItemsAPI walks the /api/v1/items resource through its whole life cycle.
func TestItemsAPI(t *testing.T) {
	h := newTestServer().Handler()

	var created items.Item
	rec := do(t, h, http.MethodPost, "/api/v1/items", `{"name":"first"}`, &created)
	if rec.Code != http.StatusCreated {
		t.Fatalf("POST = %d, want %d: %s", rec.Code, http.StatusCreated, rec.Body)
	}
	if created.ID == "" || created.Name != "first" {
		t.Fatalf("POST body = %+v", created)
	}
	if got, want := rec.Header().Get("Location"), "/api/v1/items/"+created.ID; got != want {
		t.Errorf("Location = %q, want %q", got, want)
	}

	var list struct{ Items []items.Item }
	if rec := do(t, h, http.MethodGet, "/api/v1/items", "", &list); rec.Code != http.StatusOK || len(list.Items) != 1 {
		t.Errorf("GET list = %d with %d items, want 200 with 1", rec.Code, len(list.Items))
	}

	var updated items.Item
	if rec := do(t, h, http.MethodPut, "/api/v1/items/"+created.ID, `{"name":"renamed"}`, &updated); rec.Code != http.StatusOK || updated.Name != "renamed" {
		t.Errorf("PUT = %d %+v, want 200 renamed", rec.Code, updated)
	}

	var got items.Item
	if rec := do(t, h, http.MethodGet, "/api/v1/items/"+created.ID, "", &got); rec.Code != http.StatusOK || got.Name != "renamed" {
		t.Errorf("GET = %d %+v, want 200 renamed", rec.Code, got)
	}

	if rec := do(t, h, http.MethodDelete, "/api/v1/items/"+created.ID, "", nil); rec.Code != http.StatusNoContent {
		t.Errorf("DELETE = %d, want %d", rec.Code, http.StatusNoContent)
	}

	rec = do(t, h, http.MethodGet, "/api/v1/items/"+created.ID, "", nil)
	if rec.Code != http.StatusNotFound {
		t.Errorf("GET after DELETE = %d, want %d", rec.Code, http.StatusNotFound)
	}
	if ct := rec.Header().Get("Content-Type"); !strings.HasPrefix(ct, "application/problem+json") {
		t.Errorf("error Content-Type = %q, want application/problem+json", ct)
	}
}

func TestItemsAPIValidation(t *testing.T) {
	h := newTestServer().Handler()

	var p struct {
		Status int    `json:"status"`
		Detail string `json:"detail"`
	}
	rec := do(t, h, http.MethodPost, "/api/v1/items", `{"name":""}`, &p)
	if rec.Code != http.StatusUnprocessableEntity || p.Status != http.StatusUnprocessableEntity {
		t.Errorf("POST empty name = %d (body status %d), want %d", rec.Code, p.Status, http.StatusUnprocessableEntity)
	}

	if rec := do(t, h, http.MethodPut, "/api/v1/items/missing", `{"name":"x"}`, nil); rec.Code != http.StatusNotFound {
		t.Errorf("PUT missing = %d, want %d", rec.Code, http.StatusNotFound)
	}
	if rec := do(t, h, http.MethodPost, "/api/v1/items", `{not json`, nil); rec.Code != http.StatusBadRequest {
		t.Errorf("POST malformed JSON = %d, want %d", rec.Code, http.StatusBadRequest)
	}
}
-- internal/server/openapi.go --
package server

import (
	"context"
	"errors"
	"log"
	"net/http"

	"github.com/danielgtaylor/huma/v2"

	"github.com/example/my-api/internal/items"
)

// apiConfig describes the API. Huma serves the OpenAPI 3.1 spec at
// /openapi.json (and .yaml) and interactive docs at /docs.
func apiConfig() huma.Config {
	c := huma.DefaultConfig("my-api", "1.0.0")
	c.DocsRenderer = huma.DocsRendererScalar
	return c
}

// Request and response shapes. Huma validates requests against them and
// documents them in the spec; Body is the JSON body, other fields map to
// path parameters and headers through their tags.
type (
	itemIDInput struct {
		ID string `path:"id" doc:"Item ID"`
	}
	createItemInput struct {
		Body items.Input
	}
	updateItemInput struct {
		ID   string `path:"id" doc:"Item ID"`
		Body items.Input
	}
	itemOutput struct {
		Body items.Item
	}
	createdItemOutput struct {
		Location string `header:"Location" doc:"URL of the new item"`
		Body     items.Item
	}
	itemListOutput struct {
		Body struct {
			Items []items.Item `json:"items"`
		}
	}
)

// registerItems adds the /api/v1/items operations to api.
func (s *Server) registerItems(api huma.API) {
	tags := []string{"Items"}

	huma.Register(api, huma.Operation{
		OperationID: "list-items", Method: http.MethodGet, Path: "/api/v1/items",
		Summary: "List items", Tags: tags,
	}, func(ctx context.Context, _ *struct{}) (*itemListOutput, error) {
		list, err := s.items.List(ctx)
		if err != nil {
			return nil, apiError(err)
		}
		out := &itemListOutput{}
		out.Body.Items = list
		return out, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "create-item", Method: http.MethodPost, Path: "/api/v1/items",
		Summary: "Create an item", Tags: tags, DefaultStatus: http.StatusCreated,
	}, func(ctx context.Context, in *createItemInput) (*createdItemOutput, error) {
		it, err := s.items.Create(ctx, in.Body)
		if err != nil {
			return nil, apiError(err)
		}
		return &createdItemOutput{Location: "/api/v1/items/" + it.ID, Body: it}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "get-item", Method: http.MethodGet, Path: "/api/v1/items/{id}",
		Summary: "Get an item", Tags: tags,
	}, func(ctx context.Context, in *itemIDInput) (*itemOutput, error) {
		it, err := s.items.Get(ctx, in.ID)
		if err != nil {
			return nil, apiError(err)
		}
		return &itemOutput{Body: it}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "update-item", Method: http.MethodPut, Path: "/api/v1/items/{id}",
		Summary: "Replace an item", Tags: tags,
	}, func(ctx context.Context, in *updateItemInput) (*itemOutput, error) {
		it, err := s.items.Update(ctx, in.ID, in.Body)
		if err != nil {
			return nil, apiError(err)
		}
		return &itemOutput{Body: it}, nil
	})

	huma.Register(api, huma.Operation{
		OperationID: "delete-item", Method: http.MethodDelete, Path: "/api/v1/items/{id}",
		Summary: "Delete an item", Tags: tags, DefaultStatus: http.StatusNoContent,
	}, func(ctx context.Context, in *itemIDInput) (*struct{}, error) {
		if err := s.items.Delete(ctx, in.ID); err != nil {
			return nil, apiError(err)
		}
		return nil, nil
	})
}

// apiError maps domain errors to RFC 9457 problem responses. Unexpected
// errors are logged and their details are not sent to the client.
func apiError(err error) error {
	switch {
	case errors.Is(err, items.ErrNotFound):
		return huma.Error404NotFound(err.Error())
	case errors.Is(err, items.ErrInvalid):
		return huma.Error422UnprocessableEntity(err.Error())
	}
	log.Printf("internal error: %v", err)
	return huma.Error500InternalServerError("")
}
-- internal/server/routes.go --
package server

import (
	"github.com/danielgtaylor/huma/v2/adapters/humachi"
	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
	"net/http"
)

// RegisterRoutes returns the router with every API route mounted. The
// probes (/livez, /readyz, /health) are served by Handler.
func (s *Server) RegisterRoutes() http.Handler {
	r := chi.NewRouter()
	r.Use(middleware.Logger, middleware.Recoverer)

	r.Get("/", s.helloHandler)
	s.registerItems(humachi.New(r, apiConfig()))

	return r
}

func (s *Server) helloHandler(w http.ResponseWriter, r *http.Request) {
	writeJSON(w, http.StatusOK, map[string]string{"message": "Hello World"})
}
-- internal/server/routes_test.go --
package server

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/example/my-api/internal/items"
)

// newTestServer returns a Server without external dependencies, so every
// health check passes.
func newTestServer() *Server {
	return &Server{items: items.NewMemoryStore()}
}

// do sends a request through the full handler and decodes a JSON response
// into out, if out is not nil.
func do(t *testing.T, h http.Handler, method, path, body string, out any) *httptest.ResponseRecorder {
	t.Helper()
	req := httptest.NewRequest(method, path, strings.NewReader(body))
	if body != "" {
		req.Header.Set("Content-Type", "application/json")
	}
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, req)
	if out != nil {
		if err := json.Unmarshal(rec.Body.Bytes(), out); err != nil {
			t.Fatalf("%s %s: decode %q: %v", method, path, rec.Body.String(), err)
		}
	}
	return rec
}

func TestHello(t *testing.T) {
	var body map[string]string
	rec := do(t, newTestServer().Handler(), http.MethodGet, "/", "", &body)
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
	}
	if got, want := body["message"], "Hello World"; got != want {
		t.Errorf("message = %q, want %q", got, want)
	}
}
-- internal/server/server.go --
package server

import (
	"context"
	"fmt"
	"log"
	"net/http"
	"os"
	"sync/atomic"
	"time"

	"github.com/example/my-api/internal/items"

	"github.com/example/my-api/internal/database"
	"github.com/example/my-api/internal/events"
	"github.com/example/my-api/internal/jobs"
	"github.com/example/my-api/internal/kafka"
	"github.com/example/my-api/internal/rabbitmq"
	"github.com/example/my-api/internal/redis"
	"github.com/example/my-api/internal/tasks"
)

// Server is the HTTP server and the dependencies its handlers need.
type Server struct {
	srv           *http.Server
	draining      atomic.Bool   // set by Shutdown; fails /readyz
	shutdownDelay time.Duration // SHUTDOWN_DELAY, see Shutdown
	closers       []func() error

	// checks are run by /readyz and /health, keyed by the name shown in the
	// response.
	checks   map[string]func(context.Context) error
	items    items.Store
	db       database.Service
	redis    *redis.Client
	kafka    *kafka.Client
	rabbitmq *rabbitmq.Client
	tasks    *tasks.Client    // enqueue Asynq tasks
	jobs     *jobs.Client     // insert River jobs
	events   events.Publisher // publish Watermill messages
}

// New connects the dependencies and builds the HTTP server. Call Close when
// done to release them.
func New(ctx context.Context) (*Server, error) {
	delay, err := time.ParseDuration(getenv("SHUTDOWN_DELAY", "0s"))
	if err != nil {
		return nil, fmt.Errorf("SHUTDOWN_DELAY: %w", err)
	}
	s := &Server{
		shutdownDelay: delay,
		checks:        map[string]func(context.Context) error{},
		// In memory, so every replica has its own items. Swap in a
		// database-backed items.Store before running more than one replica.
		items: items.NewMemoryStore(),
	}
	fail := func(what string, err error) (*Server, error) {
		s.Close()
		return nil, fmt.Errorf("%s: %w", what, err)
	}

	db, err := database.New()
	if err != nil {
		return fail("connect database", err)
	}
	s.db = db
	s.checks["database"] = db.Check
	s.closers = append(s.closers, db.Close)

	rdb, err := redis.New()
	if err != nil {
		return fail("connect redis", err)
	}
	s.redis = rdb
	s.checks["redis"] = func(ctx context.Context) error { return rdb.Ping(ctx).Err() }
	s.closers = append(s.closers, rdb.Close)

	kc, err := kafka.New()
	if err != nil {
		return fail("connect kafka", err)
	}
	s.kafka = kc
	s.checks["kafka"] = kc.Check
	s.closers = append(s.closers, kc.Close)

	mq, err := rabbitmq.New()
	if err != nil {
		return fail("connect rabbitmq", err)
	}
	s.rabbitmq = mq
	s.checks["rabbitmq"] = mq.Check
	s.closers = append(s.closers, mq.Close)

	s.tasks = tasks.NewClient(rdb)
	s.closers = append(s.closers, s.tasks.Close)

	jc, err := jobs.New(ctx)
	if err != nil {
		return fail("start river client", err)
	}
	s.jobs = jc
	s.closers = append(s.closers, jc.Close)

	pub, err := events.NewPublisher()
	if err != nil {
		return fail("create watermill publisher", err)
	}
	s.events = pub
	s.closers = append(s.closers, pub.Close)

	s.srv = &http.Server{
		Addr:              ":" + getenv("PORT", "8080"),
		Handler:           s.Handler(),
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      30 * time.Second,
		IdleTimeout:       time.Minute,
	}
	return s, nil
}

// Handler serves the probes and the API. The probes are mounted outside the
// framework router so they stay cheap and don't fill the request log.
func (s *Server) Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /livez", s.livez)
	mux.HandleFunc("GET /readyz", s.readyz)
	mux.HandleFunc("GET /health", s.healthz)
	mux.Handle("/", s.RegisterRoutes())
	return mux
}

// Addr is the address the server listens on, e.g. ":8080".
func (s *Server) Addr() string { return s.srv.Addr }

// ListenAndServe serves until Shutdown; it then returns http.ErrServerClosed.
func (s *Server) ListenAndServe() error { return s.srv.ListenAndServe() }

// Shutdown stops the server without dropping requests during a Kubernetes
// rolling update. It first fails /readyz so the pod is taken out of the
// Service, waits SHUTDOWN_DELAY for ingress-nginx to stop sending new
// requests, then stops listening and waits for in-flight requests to finish.
func (s *Server) Shutdown(ctx context.Context) error {
	s.draining.Store(true)
	if s.shutdownDelay > 0 {
		log.Printf("draining for %s", s.shutdownDelay)
		select {
		case <-time.After(s.shutdownDelay):
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return s.srv.Shutdown(ctx)
}

// Close releases the dependencies in reverse order of creation.
func (s *Server) Close() {
	for i := len(s.closers) - 1; i >= 0; i-- {
		if err := s.closers[i](); err != nil {
			log.Printf("close: %v", err)
		}
	}
}

func getenv(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}
-- internal/tasks/tasks.go --
// Package tasks defines background tasks that run with Asynq on Redis.
package tasks

import (
	"context"
	"encoding/json"
	"fmt"
	"log"

	"github.com/hibiken/asynq"

	"github.com/example/my-api/internal/redis"
)

// TypeExample is an example task type. Register new types in RunWorker.
const TypeExample = "example:log"

// ExamplePayload is the payload of a TypeExample task.
type ExamplePayload struct {
	Message string `json:"message"`
}

// NewExampleTask builds a task to pass to Client.Enqueue.
func NewExampleTask(message string) (*asynq.Task, error) {
	payload, err := json.Marshal(ExamplePayload{Message: message})
	if err != nil {
		return nil, err
	}
	return asynq.NewTask(TypeExample, payload), nil
}

// Client enqueues tasks.
type Client = asynq.Client

// NewClient returns a client that shares rdb's connection pool. Closing the
// client leaves rdb open.
func NewClient(rdb *redis.Client) *Client { return asynq.NewClientFromRedisClient(rdb) }

// RunWorker processes tasks until ctx is done. cmd/worker calls it.
func RunWorker(ctx context.Context) error {
	rdb, err := redis.New()
	if err != nil {
		return err
	}
	defer rdb.Close()

	srv := asynq.NewServerFromRedisClient(rdb, asynq.Config{Concurrency: 10})
	mux := asynq.NewServeMux()
	mux.HandleFunc(TypeExample, handleExample)
	if err := srv.Start(mux); err != nil {
		return err
	}
	<-ctx.Done()
	srv.Shutdown()
	return nil
}

func handleExample(ctx context.Context, t *asynq.Task) error {
	var p ExamplePayload
	if err := json.Unmarshal(t.Payload(), &p); err != nil {
		return fmt.Errorf("decode %s payload: %w", t.Type(), err)
	}
	log.Printf("asynq: %s: %s", t.Type(), p.Message)
	return nil
}
