{{- if not (.Has "openapi") -}}
package server

import (
	"net/http"

	"github.com/labstack/echo/v5"

	"{{.ModulePath}}/internal/items"
)

func (s *Server) itemRoutes(g *echo.Group) {
	g.GET("", s.listItems)
	g.POST("", s.createItem)
	g.GET("/:id", s.getItem)
	g.PUT("/:id", s.updateItem)
	g.DELETE("/:id", s.deleteItem)
}

// Errors are written with writeProblem, so handlers return nil after it.

func (s *Server) listItems(c *echo.Context) error {
	list, err := s.items.List(c.Request().Context())
	if err != nil {
		writeProblem(c.Response(), err)
		return nil
	}
	return c.JSON(http.StatusOK, itemList{Items: list})
}

func (s *Server) createItem(c *echo.Context) error {
	var in items.Input
	if err := decodeJSON(c.Request(), &in); err != nil {
		writeProblem(c.Response(), err)
		return nil
	}
	it, err := s.items.Create(c.Request().Context(), in)
	if err != nil {
		writeProblem(c.Response(), err)
		return nil
	}
	c.Response().Header().Set("Location", "/api/v1/items/"+it.ID)
	return c.JSON(http.StatusCreated, it)
}

func (s *Server) getItem(c *echo.Context) error {
	it, err := s.items.Get(c.Request().Context(), c.Param("id"))
	if err != nil {
		writeProblem(c.Response(), err)
		return nil
	}
	return c.JSON(http.StatusOK, it)
}

func (s *Server) updateItem(c *echo.Context) error {
	var in items.Input
	if err := decodeJSON(c.Request(), &in); err != nil {
		writeProblem(c.Response(), err)
		return nil
	}
	it, err := s.items.Update(c.Request().Context(), c.Param("id"), in)
	if err != nil {
		writeProblem(c.Response(), err)
		return nil
	}
	return c.JSON(http.StatusOK, it)
}

func (s *Server) deleteItem(c *echo.Context) error {
	if err := s.items.Delete(c.Request().Context(), c.Param("id")); err != nil {
		writeProblem(c.Response(), err)
		return nil
	}
	return c.NoContent(http.StatusNoContent)
}
{{- end}}
