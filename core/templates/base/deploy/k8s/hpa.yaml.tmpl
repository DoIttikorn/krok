apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{.K8sName}}
  labels:
    app.kubernetes.io/name: {{.K8sName}}
    app.kubernetes.io/component: api
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{.K8sName}}
  minReplicas: 2 # at least two, so one can restart without downtime
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
