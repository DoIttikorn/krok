apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# namespace: {{.K8sName}}

labels:
  - pairs:
      app.kubernetes.io/part-of: {{.K8sName}}

resources:
  - deployment.yaml
  - service.yaml
  - ingress.yaml
  - pdb.yaml
  - hpa.yaml
{{- if .HasWorker}}
  - worker-deployment.yaml
  - worker-pdb.yaml
{{- end}}
{{- if .KeyVault}}
  - serviceaccount.yaml
{{- end}}

# Point this at your registry, or run:
#   kustomize edit set image {{lower .Name}}=registry.example.com/{{lower .Name}}:v1.0.0
images:
  - name: {{lower .Name}}
    newName: registry.example.com/{{lower .Name}}
    newTag: latest
